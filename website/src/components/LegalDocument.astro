---
import Document from '../layouts/Document.astro';
import { site, safeExternalUrl, localUrl } from '../data/site';
import { privacySources, termsSources, type LegalSection } from '../data/legal';
interface Props { title: string; description: string; sections: LegalSection[]; kind: 'privacy' | 'terms' }
const { title, description, sections, kind } = Astro.props;
const sources = kind === 'privacy' ? privacySources : termsSources;
const emailUrl = `mailto:${site.legal.contact}?subject=${encodeURIComponent('FrameForge privacy')}`;
---
<Document title={title} description={description} noindex={!site.legal.publicationReady} sections={sections.map(section => ({id:section.id,title:section.title}))}>
  {!site.legal.publicationReady && <div class="notice legal-status"><strong>Review draft — final legal checks pending</strong><p>Updated {site.legal.reviewedOn} for the free website and manual plugin workflow. Final operator identification, provider arrangements, and applicable privacy formalities must be reviewed before adoption and an effective date.</p></div>}
  {site.legal.publicationReady && <p>Effective date: {site.legal.effectiveDate}</p>}
  <p><strong>Contact:</strong> <a href={emailUrl}>{site.legal.contact}</a><br />Discord: <strong>{site.legal.discord}</strong> · Based in {site.legal.jurisdiction}</p>
  {sections.map(section => <section id={section.id}><h2>{section.title}</h2>{section.paragraphs.map(paragraph => <p>{paragraph}</p>)}{section.bullets && <ul>{section.bullets.map(bullet => <li>{bullet}</li>)}</ul>}{section.links && <ul>{section.links.map(link => <li><a href={safeExternalUrl(link.url)} target="_blank" rel="noopener noreferrer">{link.title}</a></li>)}</ul>}</section>)}
  <section><h2>{kind === 'privacy' ? 'Platform privacy policies' : 'Platform terms'}</h2><ul>{sources.map(source => <li><a href={safeExternalUrl(source.url)} target="_blank" rel="noopener noreferrer">{source.title}</a></li>)}</ul><p>Read FrameForge’s <a href={localUrl(kind === 'privacy' ? 'terms/' : 'privacy/')}>{kind === 'privacy' ? 'Terms of use' : 'Privacy policy'}</a>.</p></section>
</Document>
