---
import Document from '../layouts/Document.astro';
import { site, safeExternalUrl } from '../data/site';
import { legalOwnerDecisions, legalSources, type LegalSection } from '../data/legal';
interface Props { title: string; description: string; sections: LegalSection[] }
const { title, description, sections } = Astro.props;
---
<Document title={title} description={description} noindex={!site.legal.publicationReady} sections={[...sections.map(section => ({id:section.id,title:section.title})),{id:'owner-decisions',title:'Decisions before publication'}]}>
  {!site.legal.publicationReady && <div class="notice legal-status"><strong>Review draft — not an effective policy</strong><p>Prepared from the inspected code on {site.legal.reviewedOn}. Operator details, contact arrangements, service providers, retention, and applicable legal provisions still need owner review. This draft has no effective date.</p></div>}
  {site.legal.publicationReady && <p>Effective date: {site.legal.effectiveDate}</p>}
  {sections.map(section => <section id={section.id}><h2>{section.title}</h2>{section.paragraphs.map(paragraph => <p>{paragraph}</p>)}{section.bullets && <ul>{section.bullets.map(bullet => <li>{bullet}</li>)}</ul>}</section>)}
  <section id="owner-decisions" class="legal-owner-decisions"><h2>Decisions before publication</h2><p>These are decisions for the owner, rather than promises made to visitors. The website’s publication check remains blocked while the legal documents are drafts.</p><ul>{legalOwnerDecisions.map(decision => <li>{decision}</li>)}</ul></section>
  <section><h2>Platform policies & further reading</h2><p>External platforms describe their own processing and rules. The rights guide provides background; it does not establish which law applies to FrameForge.</p><ul>{legalSources.map(source => <li><a href={safeExternalUrl(source.url)} target="_blank" rel="noopener noreferrer">{source.title}</a></li>)}</ul></section>
</Document>
