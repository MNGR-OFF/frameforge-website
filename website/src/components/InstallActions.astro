---
import { localUrl, safeExternalUrl, site } from '../data/site';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<div class:list={['install-actions', { compact }]}>
  <a class="button primary" href={site.links.figmaPlugin ? safeExternalUrl(site.links.figmaPlugin) : localUrl('guide/#installation')} target={site.links.figmaPlugin ? '_blank' : undefined} rel={site.links.figmaPlugin ? 'noopener noreferrer' : undefined}>
    <span class="platform-mark" aria-hidden="true">F</span> {site.links.figmaPlugin ? 'Install for Figma' : 'Figma installation'}
  </a>
  <a class="button secondary" href={site.links.robloxPlugin ? safeExternalUrl(site.links.robloxPlugin) : site.downloads.studio.enabled ? localUrl(site.downloads.studio.path) : localUrl('guide/#installation')} download={!site.links.robloxPlugin && site.downloads.studio.enabled ? site.downloads.studio.fileName : undefined} target={site.links.robloxPlugin ? '_blank' : undefined} rel={site.links.robloxPlugin ? 'noopener noreferrer' : undefined}>
    <span class="platform-mark studio-mark" aria-hidden="true">R</span> {site.links.robloxPlugin ? 'Install for Studio' : site.downloads.studio.enabled ? 'Download Studio plugin' : 'Studio installation'}
  </a>
</div>
