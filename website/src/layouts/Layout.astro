---
import '../styles/global.css';
import '../styles/fonts.css';
import InstallActions from '../components/InstallActions.astro';
import Donation from '../components/Donation.astro';
import { site, navigation, localUrl } from '../data/site';
interface Props { title?: string; description?: string; noindex?: boolean; calm?: boolean }
const { title, description = site.description, noindex = false, calm = false } = Astro.props;
const pageTitle = title ? `${title} · FrameForge` : 'FrameForge · Design in Figma. Forge it into Roblox.';
const canonical = new URL(Astro.url.pathname.endsWith('/404/') ? localUrl('404.html') : Astro.url.pathname, Astro.site);
const social = new URL(localUrl('assets/social-preview.png'), Astro.site);
const current = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B0F14" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={localUrl('favicon.svg')} />
    <link rel="icon" type="image/png" href={localUrl('assets/frameforge-logo.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FrameForge" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={social} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="FrameForge — Design in Figma. Forge it into Roblox. Orange forge mark on dark steel." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={social} />
    <title>{pageTitle}</title>
  </head>
  <body class:list={[{ 'calm-page': calm }]}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={localUrl()} aria-label="FrameForge home">
          <img src={localUrl('assets/frameforge-logo.png')} width="114" height="84" alt="" />
          <span>Frame<span class="brand-light">Forge</span><span class="brand-period">.</span></span>
        </a>
        <nav class="desktop-nav" aria-label="Main navigation">
          {navigation.map(item => <a href={item.home ? localUrl(item.path) : localUrl(item.path)} aria-current={!item.home && current === localUrl(item.path) ? 'page' : undefined}>{item.label}</a>)}
        </nav>
        <a class="header-cta button secondary" href={localUrl('guide/#installation')}>Get FrameForge</a>
        <details class="mobile-menu">
          <summary aria-label="Navigation menu"><span>Menu</span><span class="menu-bars" aria-hidden="true"></span></summary>
          <nav aria-label="Mobile navigation">
            {navigation.map(item => <a href={localUrl(item.path)}>{item.label}</a>)}
            <a class="mobile-install" href={localUrl('guide/#installation')}>Get FrameForge</a>
          </nav>
        </details>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="footer-top container">
        <div><a class="brand" href={localUrl()}><img src={localUrl('assets/frameforge-logo.png')} width="114" height="84" alt="" /><span>Frame<span class="brand-light">Forge</span><span class="brand-period">.</span></span></a><p>Design in Figma.<br />Forge it into Roblox.</p><p class="creator">{site.creator}</p></div>
        <nav aria-label="Footer navigation"><a href={localUrl('guide/')}>Guide</a><a href={localUrl('account/')}>Account linking</a><a href={localUrl('support/')}>Support</a><a href={localUrl('changelog/')}>Changelog</a><a href={localUrl('privacy/')}>Privacy {!site.legal.publicationReady && <span class="draft-label">draft</span>}</a><a href={localUrl('terms/')}>Terms {!site.legal.publicationReady && <span class="draft-label">draft</span>}</a><a href={localUrl('credits/')}>Credits</a></nav>
        <div class="footer-note"><p>Real layers. Room to build.</p><InstallActions compact /><Donation /></div>
      </div>
      <div class="footer-bottom container"><p>{site.independence}</p><span>FRAMEFORGE / {site.version} ALPHA</span></div>
    </footer>
    <script>
      const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
      menu?.addEventListener('keydown', event => { if (event.key === 'Escape') { menu.open = false; menu.querySelector('summary')?.focus(); } });
      menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { menu.open = false; }));
      document.addEventListener('click', event => { if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false; });
    </script>
  </body>
</html>
