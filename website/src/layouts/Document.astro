---
import Layout from './Layout.astro';
interface Props { title: string; description: string; eyebrow?: string; noindex?: boolean; sections?: { id: string; title: string }[] }
const { title, description, noindex = false, sections = [] } = Astro.props;
---
<Layout title={title} description={description} noindex={noindex} calm>
  <div class="document container">
    <header class="document-header"><h1>{title}<span class="accent">.</span></h1><p>{description}</p></header>
    <div class:list={['document-grid', { 'without-toc': !sections.length }]}>
      {sections.length > 0 && <aside class="document-toc"><nav aria-label="On this page">{sections.map(section => <a href={`#${section.id}`}>{section.title}</a>)}</nav></aside>}
      <article class="prose"><slot /></article>
    </div>
  </div>
</Layout>
