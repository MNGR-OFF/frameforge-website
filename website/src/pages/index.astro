---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import InstallActions from '../components/InstallActions.astro';
import ForgeScene from '../components/ForgeScene.astro';
import InteractionDemo from '../components/InteractionDemo.astro';
import StudioDownload from '../components/StudioDownload.astro';
import { site, localUrl, workflow } from '../data/site';
---
<Layout>
  <section class="hero container">
    <div class="hero-copy"><h1>Your Figma designs,<br /><span class="hero-forged">forged into</span><br />Roblox<span class="accent">.</span></h1><p class="hero-description">Turn frames, layouts, and interactions into editable Roblox UI—then keep building in Studio.</p><InstallActions /><a class="hero-guide-link" href={localUrl('guide/')}>New to the forge? Read the guide <Icon name="arrow" /></a><div class="hero-release"><a class="release-pill" href={localUrl('changelog/')}><span class="release-square" aria-hidden="true"></span> FRAMEFORGE {site.version} <span class="pill-divider"></span> ALPHA</a></div></div>
    <div class="hero-visual"><Icon name="plus" class="visual-cross cross-one" /><Icon name="plus" class="visual-cross cross-two" /><ForgeScene /></div>
    <div class="hero-bottom"><span class="hero-bottom-note">Your layers have a next chapter.</span><a href="#how-it-works" aria-label="Scroll to how it works" class="scroll-indicator"><Icon name="down" /></a></div>
  </section>
  <div class="capability-strip"><div class="container"><span><Icon name="square" /> Native UI objects</span><span><Icon name="layers" /> Editable hierarchy</span><span><Icon name="motion" /> Responsive sizing</span><span><Icon name="layout" /> Configurable interactions</span></div></div>
  <section class="section features-section container" id="features" aria-labelledby="features-title"><div class="section-heading"><div><h2 id="features-title">A real interface.<br /><span class="muted-heading">With room to evolve.</span></h2></div><p>Keep the structure you designed. <br />Get the objects you can work with.</p></div>
    <div class="feature-composition"><article class="feature-native surface"><h3>Your layers.<br />Still your layers.</h3><p>Supported frames, text, buttons, inputs, and layouts become native Roblox objects. Compatible geometric masks keep their children editable.</p><div class="native-visual" aria-label="Example native object hierarchy"><div class="native-object"><Icon name="square" /><b>ShopPanel</b><small>Frame</small></div><div class="native-children"><div><Icon name="layout" /> ContentLayout <small>UIListLayout</small></div><div><Icon name="text" /> Heading <small>TextLabel</small></div><div><Icon name="clip" /> Artwork <small>ImageLabel</small></div><div><Icon name="square" /> BuyButton <small>TextButton</small></div></div><span class="native-tag">NATIVE WHERE SUPPORTED</span></div></article>
    <article class="feature-sizing surface"><h3>Designed once.<br />Sized with intention.</h3><p>Choose pixel, responsive, or hybrid sizing. Hybrid fits the authored proportions as the viewport changes.</p><div class="sizing-visual" aria-label="Illustration of one interface fitting desktop and mobile viewports"><div class="sizing-desktop"><div class="mini-ui"><span></span><span></span><b>BUILD</b></div></div><div class="sizing-phone"><div class="mini-ui"><span></span><span></span><b>BUILD</b></div></div><span class="sizing-label">HYBRID / UNIFORM FIT</span></div></article>
    <article class="feature-details surface"><h3>See what makes the cut.</h3><p>Effect previews and selected-design previews help you tune a layer before export. Diagnostics call out font fallbacks, asset mappings, and unsupported details.</p><div class="diagnostic-example"><span class="diagnostic-icon" aria-hidden="true">!</span><div><b>Font fallback</b><span>This text layer needs an image asset.</span></div><span class="mono">EXAMPLE</span></div></article>
    <article class="feature-runtime surface"><h3>One coherent runtime.</h3><p>Behavior imports use one bundled client runtime with shared animation and cleanup. Static pixel and responsive imports need no scripts; static hybrid uses one fitting script.</p><div class="runtime-line"><code>StarterGui</code><span aria-hidden="true">/</span><code>ScreenGui</code><span aria-hidden="true">/</span><code class="runtime-script">FrameForgeRuntime</code></div></article></div>
    <div class="feature-smallprint"><span>Supported text + individual image fallbacks</span><span>Native clipping where compatible</span><span>Explicit hover and loop triggers</span><a href={localUrl('guide/#limits')}>Know the boundaries <Icon name="arrow" /></a></div>
  </section>
  <section class="workflow-section section" id="how-it-works" aria-labelledby="workflow-title"><div class="container workflow-layout"><div class="workflow-intro"><h2 id="workflow-title">A clear path<br />from <span class="accent">idea to UI.</span></h2><p>A few deliberate steps. A structure you can keep refining.</p><a class="text-link" href={localUrl('guide/')}>Open the complete guide <Icon name="arrow" /></a><div class="workflow-art" aria-hidden="true"><span>FIGMA</span><div class="workflow-conduit"><i></i><b>FF</b><i></i></div><span>STUDIO</span><small>DESIGN → JSON → NATIVE UI</small></div></div><ol class="workflow-list">{workflow.map((step,index) => <li><span class="workflow-number">{String(index+1).padStart(2,'0')}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>)}</ol></div></section>
  <div class="container download-section"><StudioDownload /></div>
  <InteractionDemo />
  <section class="limits-section container" aria-labelledby="limits-title"><div class="limits-heading"><h2 id="limits-title">Craft has its limits.</h2><p>A better import starts with clear expectations.</p></div><div class="limits-content"><p>Some graphics and unavailable fonts need individual image assets. The surrounding supported hierarchy stays editable.</p><p>Some Figma features are approximated or unsupported. Roblox moderation and asset permissions can affect images.</p><p>Test your imported design in Studio. FrameForge does not promise perfect conversion or support for every Figma feature.</p><a class="text-link" href={localUrl('guide/#limits')}>Read the compatibility notes <Icon name="arrow" /></a></div></section>
  <section class="final-cta container"><div><h2>Bring your design<br />to its <span class="accent">next world.</span></h2></div><div><InstallActions /><p>Get the Figma plugin from Community.<br />Choose the Creator Store or a local file for Studio.</p></div><Icon name="plus" class="cta-corner" /></section>
  <script src="../scripts/home.ts"></script>
</Layout>
