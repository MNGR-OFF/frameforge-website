---
import Document from '../layouts/Document.astro';
import { site, localUrl, safeExternalUrl } from '../data/site';
---
<Document title="Credits" description="FrameForge is created and maintained by @mngr06.">
  <section><h2>Created by @mngr06</h2><p>FrameForge brings Figma designs into Roblox as editable UI, with tools for conversion, layout, and interaction.</p><p><strong>{site.creator}</strong></p></section>
  <section><h2>Typography &amp; open-source software</h2><p>Manrope was designed by the Manrope Project Authors and is used under the SIL Open Font License 1.1.</p><p>The website is built with <a href="https://astro.build/" target="_blank" rel="noopener noreferrer">Astro</a>, available under the MIT license.</p><p><a href={localUrl('THIRD-PARTY-NOTICES.txt')}>Read the third-party license notices.</a></p></section>
  <section><h2>Resources</h2><p><a href={safeExternalUrl(site.links.uiResources)} target="_blank" rel="noopener noreferrer">UI Resources</a> offers inspiration and resources for interface designers.</p></section>
  <section><h2>Your designs</h2><p>Your designs and assets remain yours. See the <a href={localUrl('terms/')}>terms of use</a> for content permissions and responsibilities.</p></section>
</Document>
