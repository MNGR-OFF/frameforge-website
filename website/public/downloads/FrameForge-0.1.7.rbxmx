<roblox version="4"><External>null</External><External>nil</External><Item class="Folder" referent="FF36"><Properties><string name="Name">FrameForgePlugin</string></Properties><Item class="Folder" referent="FF8"><Properties><string name="Name">Converter</string></Properties><Item class="ModuleScript" referent="FF1"><Properties><string name="Name">Appearance</string><ProtectedString name="Source">--!strict
local Appearance = {}
local FONT_FAMILIES = require(script.Parent.FontCatalog)

function Appearance.color(value: any): Color3
	return Color3.new(value.r, value.g, value.b)
end

local function fontFace(text: any): (Font, boolean, string)
	local source = FONT_FAMILIES[string.lower(string.match(text.fontFamily, &quot;^%s*(.-)%s*$&quot;) or text.fontFamily)]
	local mapping = source or FONT_FAMILIES.montserrat
	local style = string.gsub(string.lower(text.fontStyle), &quot;[^a-z0-9]&quot;, &quot;&quot;)
	local exactFace = mapping.styles[style]
	local face = exactFace or mapping.styles.regular
	local family = mapping.family
	local weight = if face then Enum.FontWeight[face.weight] else Enum.FontWeight.Regular
	local slant = if face then Enum.FontStyle[face.style] else Enum.FontStyle.Normal
	return Font.new(family, weight, slant), source ~= nil and mapping.exact and exactFace ~= nil, mapping.label
end

local function gradient(gui: GuiObject, config: any)
	local colors, transparency = {}, {}
	local stops = config.stops
	local function append(position: number, value: any)
		-- Coincident Figma stops are kept as the latter stop; Roblox requires increasing time.
		if #colors &gt; 0 and colors[#colors].Time == position then
			colors[#colors] = ColorSequenceKeypoint.new(position, Appearance.color(value))
			transparency[#transparency] = NumberSequenceKeypoint.new(position, 1 - value.a)
		else
			table.insert(colors, ColorSequenceKeypoint.new(position, Appearance.color(value)))
			table.insert(transparency, NumberSequenceKeypoint.new(position, 1 - value.a))
		end
	end
	if stops[1].position &gt; 0 then append(0, stops[1].color) end
	for _, stop in ipairs(stops) do append(stop.position, stop.color) end
	if stops[#stops].position &lt; 1 then append(1, stops[#stops].color) end
	if #colors == 1 then
		local value = stops[1].color
		colors = { ColorSequenceKeypoint.new(0, Appearance.color(value)), ColorSequenceKeypoint.new(1, Appearance.color(value)) }
		transparency = { NumberSequenceKeypoint.new(0, 1 - value.a), NumberSequenceKeypoint.new(1, 1 - value.a) }
	end
	local simplified = #colors &gt; 20
	while #colors &gt; 20 do
		table.remove(colors, 2)
		table.remove(transparency, 2)
	end
	local result = Instance.new(&quot;UIGradient&quot;)
	result.Name = &quot;FF_Gradient&quot;
	result.Color = ColorSequence.new(colors)
	result.Transparency = NumberSequence.new(transparency)
	result.Rotation = config.rotation % 360
	result.Parent = gui
	return simplified
end

function Appearance.apply(gui: GuiObject, node: any, opacity: number, warnings: {any})
	local value = node.appearance
	gui.BorderSizePixel = 0
	gui.Visible = value.visible and not node.metadata.initiallyHidden
	gui.ClipsDescendants = value.clipsContent
	if gui:IsA(&quot;CanvasGroup&quot;) and value.mask then gui.GroupTransparency = 1 - value.mask.alpha end
	gui.BackgroundTransparency = 1
	if value.fill then
		gui.BackgroundColor3 = Appearance.color(value.fill)
		gui.BackgroundTransparency = 1 - value.fill.a * opacity
	end
	if value.gradient then
		gui.BackgroundColor3 = Color3.new(1, 1, 1)
		gui.BackgroundTransparency = 1 - opacity
		if gradient(gui, value.gradient) then
			table.insert(warnings, { nodeId = node.id, code = &quot;GRADIENT_STOPS&quot;, message = &quot;Gradient was simplified to Roblox's 20 keypoint limit.&quot; })
		end
	end
	if value.cornerRadius &gt; 0 or node.type == &quot;ELLIPSE&quot; then
		local corner = Instance.new(&quot;UICorner&quot;)
		corner.Name = &quot;FF_Corner&quot;
		corner.CornerRadius = if node.type == &quot;ELLIPSE&quot; then UDim.new(0.5, 0) else UDim.new(0, value.cornerRadius)
		corner.Parent = gui
	end
	if value.stroke then
		local stroke = Instance.new(&quot;UIStroke&quot;)
		stroke.Name = &quot;FF_Stroke&quot;
		stroke.ApplyStrokeMode = if node.text then Enum.ApplyStrokeMode.Contextual else Enum.ApplyStrokeMode.Border
		stroke.Color = Appearance.color(value.stroke.color)
		stroke.Thickness = value.stroke.thickness
		stroke.Transparency = 1 - value.stroke.color.a * opacity
		stroke.BorderStrokePosition = if value.stroke.alignment == &quot;inside&quot; then Enum.BorderStrokePosition.Inner
			elseif value.stroke.alignment == &quot;outside&quot; then Enum.BorderStrokePosition.Outer else Enum.BorderStrokePosition.Center
		stroke.Parent = gui
	end
	if gui:IsA(&quot;GuiButton&quot;) then
		gui.AutoButtonColor = false
		gui.Selectable = not node.metadata.disabled
		gui.Active = not node.metadata.disabled
		gui.Interactable = not node.metadata.disabled
	end
	if gui:IsA(&quot;TextLabel&quot;) or gui:IsA(&quot;TextButton&quot;) or gui:IsA(&quot;TextBox&quot;) then
		gui.Text = &quot;&quot;
		if node.text then
			local text = node.text
			gui.Text = text.content
			local face, exactFont, fallbackLabel = fontFace(text)
			gui.FontFace = face
			gui.TextSize = math.clamp(text.fontSize, 1, 100)
			gui.TextColor3 = Appearance.color(text.color)
			gui.TextTransparency = 1 - text.color.a * opacity
			gui.TextXAlignment = ({ left = Enum.TextXAlignment.Left, center = Enum.TextXAlignment.Center, right = Enum.TextXAlignment.Right })[text.horizontalAlign]
			gui.TextYAlignment = ({ top = Enum.TextYAlignment.Top, center = Enum.TextYAlignment.Center, bottom = Enum.TextYAlignment.Bottom })[text.verticalAlign]
			gui.TextWrapped = text.wrapped
			gui.RichText = text.richText
			gui.LineHeight = if text.lineHeight then math.clamp(text.lineHeight / text.fontSize, 0.1, 3) else 1
			if text.letterSpacing and text.letterSpacing ~= 0 then
				table.insert(warnings, { nodeId = node.id, code = &quot;TEXT_TRACKING&quot;, message = &quot;Roblox cannot reproduce custom letter spacing; text remains editable.&quot; })
			end
			if not exactFont then
				local exists = false
				for _, warning in ipairs(warnings) do if warning.nodeId == node.id and warning.code == &quot;FONT_FALLBACK&quot; then exists = true; break end end
				if not exists then table.insert(warnings, { nodeId = node.id, code = &quot;FONT_FALLBACK&quot;, message = &quot;Figma font '&quot; .. text.fontFamily .. &quot; &quot; .. text.fontStyle .. &quot;' is unavailable in FrameForge's native Roblox font catalog. Using &quot; .. fallbackLabel .. &quot;; export again from Figma for an exact text image.&quot; }) end
			end
			if text.fontSize &gt; 100 then
				table.insert(warnings, { nodeId = node.id, code = &quot;TEXT_SIZE&quot;, message = &quot;Font size was limited to Roblox's 100 px text size.&quot; })
			end
		end
	end
	if gui:IsA(&quot;TextBox&quot;) then
		gui.ClearTextOnFocus = false
		gui.TextEditable = not node.metadata.disabled
		gui.MultiLine = node.text ~= nil and node.text.wrapped
		gui.PlaceholderText = &quot;&quot;
	end
end

function Appearance.image(gui: ImageLabel | ImageButton, node: any, asset: string, opacity: number)
	gui.Image = asset
	gui.ImageTransparency = 1 - opacity
	gui.ScaleType = ({ fit = Enum.ScaleType.Fit, fill = Enum.ScaleType.Crop, stretch = Enum.ScaleType.Stretch, tile = Enum.ScaleType.Tile })[node.appearance.imageMode or &quot;stretch&quot;]
end

return Appearance
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="FF2"><Properties><string name="Name">Convert</string><ProtectedString name="Source">--!strict
local HttpService = game:GetService(&quot;HttpService&quot;)
local Layout = require(script.Parent.Layout)
local Appearance = require(script.Parent.Appearance)
local Shadow = require(script.Parent.Shadow)

local Convert = {}

function Convert.assetId(value: any): string?
	if type(value) ~= &quot;string&quot; then return nil end
	local digits = string.match(value, &quot;^rbxassetid://(%d+)$&quot;) or string.match(value, &quot;^(%d+)$&quot;)
	if not digits or #digits &gt; 20 or tonumber(digits) == nil or (tonumber(digits) :: number) &lt;= 0 then return nil end
	return &quot;rbxassetid://&quot; .. digits
end

local function buttonNode(node: any): boolean
	if node.metadata.element == &quot;button&quot; or node.metadata.element == &quot;tab&quot; then return true end
	for _, item in ipairs(node.metadata.behaviors) do
		if table.find({ &quot;openPanel&quot;, &quot;closePanel&quot;, &quot;togglePanel&quot;, &quot;tab&quot;, &quot;select&quot;, &quot;customAction&quot;, &quot;ripple&quot; }, item.type) then return true end
	end
	return false
end

local function className(node: any): string
	-- Unsupported-font glyphs are a static image, even if their old metadata requested a text input.
	if node.strategy == &quot;baked&quot; and node.type == &quot;IMAGE&quot; and node.text then
		return &quot;ImageLabel&quot;
	end
	if node.appearance.mask and node.appearance.mask.mode == &quot;canvas&quot; then return &quot;CanvasGroup&quot; end
	if node.appearance.clipsContent and not buttonNode(node) and node.metadata.element ~= &quot;scroll&quot; and
		(node.appearance.cornerRadius &gt; 0 or node.bounds.rotation ~= 0) then return &quot;CanvasGroup&quot; end
	if node.metadata.element == &quot;scroll&quot; then return &quot;ScrollingFrame&quot; end
	if node.metadata.element == &quot;textbox&quot; then return &quot;TextBox&quot; end
	local button = buttonNode(node)
	local image = node.strategy == &quot;baked&quot; or node.type == &quot;IMAGE&quot; or node.type == &quot;VECTOR&quot; or node.metadata.element == &quot;image&quot;
	if image then return if button then &quot;ImageButton&quot; else &quot;ImageLabel&quot; end
	if button then return &quot;TextButton&quot; end
	if node.type == &quot;TEXT&quot; then return &quot;TextLabel&quot; end
	return &quot;Frame&quot;
end

local function annotate(gui: GuiObject, node: any)
	gui:SetAttribute(&quot;FF_ID&quot;, node.id)
	gui:SetAttribute(&quot;FF_Element&quot;, node.metadata.element)
	gui:SetAttribute(&quot;FF_SourceType&quot;, node.type)
	gui:SetAttribute(&quot;FF_Strategy&quot;, node.strategy)
	gui:SetAttribute(&quot;FF_Behaviors&quot;, HttpService:JSONEncode(node.metadata.behaviors))
	gui:SetAttribute(&quot;FF_PanelId&quot;, node.metadata.panelId)
	gui:SetAttribute(&quot;FF_InitiallyHidden&quot;, node.metadata.initiallyHidden == true)
	gui:SetAttribute(&quot;FF_Disabled&quot;, node.metadata.disabled == true)
	gui:SetAttribute(&quot;FF_CloseOnOutside&quot;, node.metadata.closeOnOutside == true)
	gui:SetAttribute(&quot;FF_ComponentId&quot;, node.componentId)
end

function Convert.build(document: any, target: Instance, strategy: string, mappings: {[string]: string}): any
	local report = { nodeCount = 0, nativeCount = 0, bakedCount = 0, imageCount = 0, behaviorCount = 0, warnings = {}, missingAssets = {} }
	for _, warning in ipairs(document.warnings) do table.insert(report.warnings, warning) end
	local assets = {}
	for _, asset in ipairs(document.assets) do assets[asset.id] = asset end
	local missing = {}
	local shadowState = { layers = 0 }
	local function resolve(node: any): string
		local reference = node.appearance.asset
		if not reference and not node.metadata.assetId and node.type ~= &quot;VECTOR&quot; and node.type ~= &quot;IMAGE&quot; and node.strategy ~= &quot;baked&quot; then return &quot;&quot; end
		local asset = if reference then assets[reference] else nil
		local mapped = mappings[reference or node.id] or mappings[node.id]
		local result = Convert.assetId(mapped) or Convert.assetId(node.metadata.assetId) or Convert.assetId(if asset then asset.robloxId else reference)
		if result then return result end
		local key = reference or node.id
		if not missing[key] then
			missing[key] = { id = key, name = if asset then asset.name else node.name, uses = 0 }
			table.insert(report.missingAssets, missing[key])
		end
		missing[key].uses += 1
		table.insert(report.warnings, { nodeId = node.id, code = &quot;ASSET_MISSING&quot;, message = &quot;Upload '&quot; .. missing[key].name .. &quot;' through Studio Asset Manager and map asset key '&quot; .. key .. &quot;' to its Roblox image ID.&quot; })
		return &quot;&quot;
	end
	local bounds = Layout.designBounds(document.roots)
	local design = Instance.new(&quot;Frame&quot;)
	design.Name = &quot;FF_Design&quot;
	design.BackgroundTransparency = 1
	design.BorderSizePixel = 0
	design.AnchorPoint = Vector2.new(0.5, 0.5)
	design.Position = UDim2.fromScale(0.5, 0.5)
	design.Size = if strategy == &quot;responsive&quot; then UDim2.fromScale(1, 1) else UDim2.fromOffset(bounds.width, bounds.height)
	design:SetAttribute(&quot;FF_DesignWidth&quot;, bounds.width)
	design:SetAttribute(&quot;FF_DesignHeight&quot;, bounds.height)
	design:SetAttribute(&quot;FF_DesignSizeMode&quot;, strategy)
	design.Parent = target
	if strategy == &quot;hybrid&quot; then
		local aspect = Instance.new(&quot;UIAspectRatioConstraint&quot;)
		aspect.Name = &quot;FF_DesignAspect&quot;
		aspect.AspectRatio = bounds.width / bounds.height
		aspect.AspectType = Enum.AspectType.FitWithinMaxSize
		aspect.Parent = design
		local scale = Instance.new(&quot;UIScale&quot;)
		scale.Name = &quot;FF_DesignScale&quot;
		scale.Parent = design
		local viewport = if target:IsA(&quot;GuiBase2d&quot;) then target.AbsoluteSize else Vector2.zero
		if viewport.X &lt;= 0 or viewport.Y &lt;= 0 then
			local camera = workspace.CurrentCamera
			if camera then viewport = camera.ViewportSize end
		end
		if viewport.X &gt; 0 and viewport.Y &gt; 0 then scale.Scale = math.min(1, viewport.X / bounds.width, viewport.Y / bounds.height) end
	end
	local synthetic = {
		bounds = bounds,
		layout = { mode = &quot;none&quot;, horizontalSizing = &quot;fixed&quot;, verticalSizing = &quot;fixed&quot;, padding = { top = 0, right = 0, bottom = 0, left = 0 } },
	}
	local function build(node: any, parent: Instance, parentNode: any, order: number, ancestorOpacity: number, root: boolean)
		report.nodeCount += 1
		report.behaviorCount += #node.metadata.behaviors
		if node.strategy == &quot;baked&quot; then report.bakedCount += 1 else report.nativeCount += 1 end
		local gui = Instance.new(className(node)) :: GuiObject
		-- Attach immediately to the unparented staging tree so any exception destroys all created objects.
		gui.Parent = parent
		gui.Name = if node.name ~= &quot;&quot; then node.name else &quot;Layer&quot;
		gui.LayoutOrder = order
		gui.ZIndex = order * 2 + 1
		annotate(gui, node)
		local opacity = ancestorOpacity * node.appearance.opacity
		local layoutNode = node
		if root then
			layoutNode = table.clone(node)
			layoutNode.bounds = table.clone(node.bounds)
			layoutNode.bounds.x -= bounds.x
			layoutNode.bounds.y -= bounds.y
		end
		Layout.apply(gui, layoutNode, parentNode, strategy, root)
		local styleNode = node
		local textSource = nil
		if gui:IsA(&quot;TextBox&quot;) and not node.text then
			for _, child in ipairs(node.children) do
				if child.type == &quot;TEXT&quot; and child.text then textSource = child; break end
			end
			if textSource then
				styleNode = table.clone(node)
				styleNode.text = textSource.text
				gui:SetAttribute(&quot;FF_TextSourceId&quot;, textSource.id)
				table.insert(report.warnings, { nodeId = node.id, code = &quot;TEXTBOX_MERGE&quot;, message = &quot;Text layer '&quot; .. textSource.name .. &quot;' was merged into the editable TextBox.&quot; })
			end
		end
		Appearance.apply(gui, styleNode, opacity, report.warnings)
		if buttonNode(node) and (gui:IsA(&quot;CanvasGroup&quot;) or gui:IsA(&quot;ImageLabel&quot;) and node.strategy == &quot;baked&quot; and node.text) then
			local input = Instance.new(&quot;TextButton&quot;)
			input.Name = &quot;FF_Input&quot;
			input:SetAttribute(&quot;FF_Decoration&quot;, true)
			input.Size = UDim2.fromScale(1, 1)
			input.BackgroundTransparency = 1
			input.BorderSizePixel = 0
			input.Text = &quot;&quot;
			input.AutoButtonColor = false
			input.ZIndex = 0
			input.Interactable = not node.metadata.disabled
			input.Selectable = not node.metadata.disabled
			local corner = gui:FindFirstChild(&quot;FF_Corner&quot;)
			if corner then corner:Clone().Parent = input end
			input.Parent = gui
		end
		Shadow.apply(gui, node, parentNode, strategy, opacity, root, shadowState, report.warnings)
		if strategy == &quot;responsive&quot; and node.text and (gui:IsA(&quot;TextLabel&quot;) or gui:IsA(&quot;TextButton&quot;) or gui:IsA(&quot;TextBox&quot;)) then
			gui.TextScaled = true
			local textLimit = Instance.new(&quot;UITextSizeConstraint&quot;)
			textLimit.Name = &quot;FF_TextSizeLimits&quot;
			textLimit.MinTextSize = math.min(12, node.text.fontSize)
			textLimit.MaxTextSize = math.clamp(node.text.fontSize, 1, 100)
			textLimit.Parent = gui
		end
		local imageAsset = resolve(node)
		if gui:IsA(&quot;ImageLabel&quot;) or gui:IsA(&quot;ImageButton&quot;) then
			Appearance.image(gui, node, imageAsset, opacity)
			if imageAsset ~= &quot;&quot; then report.imageCount += 1 end
			if node.strategy == &quot;baked&quot; and imageAsset ~= &quot;&quot; then
				gui.BackgroundTransparency = 1
				for _, decoration in ipairs(gui:GetChildren()) do
					if decoration:IsA(&quot;UIStroke&quot;) or decoration:IsA(&quot;UIGradient&quot;) then decoration:Destroy() end
				end
			end
		elseif node.appearance.asset or node.metadata.assetId then
			local image = Instance.new(&quot;ImageLabel&quot;)
			image.Name = &quot;FF_Image&quot;
			image.Size = UDim2.fromScale(1, 1)
			image.BackgroundTransparency = 1
			image.BorderSizePixel = 0
			-- ZIndexBehavior.Sibling compares children with their siblings, not the node's own layer.
			image.ZIndex = 1
			Appearance.image(image, node, imageAsset, opacity)
			local sourceCorner = gui:FindFirstChild(&quot;FF_Corner&quot;)
			if sourceCorner then sourceCorner:Clone().Parent = image end
			image.Parent = gui
			if imageAsset ~= &quot;&quot; then report.imageCount += 1 end
		end
		if gui:IsA(&quot;ScrollingFrame&quot;) then
			local direction = node.layout.scrollDirection or &quot;y&quot;
			gui.ScrollingDirection = if direction == &quot;x&quot; then Enum.ScrollingDirection.X elseif direction == &quot;xy&quot; then Enum.ScrollingDirection.XY else Enum.ScrollingDirection.Y
			gui.AutomaticCanvasSize = if direction == &quot;x&quot; then Enum.AutomaticSize.X elseif direction == &quot;xy&quot; then Enum.AutomaticSize.XY else Enum.AutomaticSize.Y
			gui.CanvasSize = UDim2.fromOffset(0, 0)
			gui.ScrollBarThickness = 6
			gui.ScrollBarImageColor3 = Color3.fromRGB(255, 122, 47)
			gui.ScrollingEnabled = not node.metadata.disabled
			gui.Active = true
		end
		if (parentNode.layout.horizontalSizing == &quot;hug&quot; and node.layout.horizontalSizing == &quot;fill&quot;) or
			(parentNode.layout.verticalSizing == &quot;hug&quot; and node.layout.verticalSizing == &quot;fill&quot;) then
			table.insert(report.warnings, { nodeId = node.id, code = &quot;HUG_FILL_CYCLE&quot;, message = &quot;Fill inside a hugging axis uses the original pixel size to avoid a layout cycle.&quot; })
		end
		local content = Layout.container(gui, node)
		if content ~= gui then
			local firstFlow, lastFlow = nil, nil
			for index, child in ipairs(node.children) do
				if not child.layout.absolute then
					firstFlow = firstFlow or index
					lastFlow = index
				end
			end
			content.ZIndex = if firstFlow then firstFlow * 2 + 1 else 1
			if firstFlow and lastFlow then
				for index, child in ipairs(node.children) do
					if child.layout.absolute and index &gt; firstFlow and index &lt; lastFlow then
						table.insert(report.warnings, { nodeId = node.id, code = &quot;ABSOLUTE_DRAW_ORDER&quot;, message = &quot;Absolute layers interleaved with auto-layout content may draw in a different order. Verify overlapping elements in Studio.&quot; })
						break
					end
				end
			end
		end
		if node.layout.mode == &quot;grid&quot; and #node.children &gt; 1 then
			local expectedHeight = node.children[1].bounds.height
			for _, child in ipairs(node.children) do
				if math.abs(child.bounds.height - expectedHeight) &gt; 0.01 then
					table.insert(report.warnings, { nodeId = node.id, code = &quot;GRID_CELL_SIZE&quot;, message = &quot;Roblox grid cells use a uniform row height based on the first child.&quot; })
					break
				end
			end
		end
		for index, child in ipairs(node.children) do
			if child ~= textSource then
				build(child, if child.layout.absolute then gui else content, node, index, opacity, false)
			end
		end
	end
	for index, root in ipairs(document.roots) do build(root, design, synthetic, index, 1, true) end
	return report
end

return Convert
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="FF3"><Properties><string name="Name">FontCatalog</string><ProtectedString name="Source">--!strict
-- Generated from shared/fonts.ts; native family and face matching are shared by both platforms.
return {
