local ShadowGeometry = require(script.Parent.ShadowGeometry)
local Shadow = {}

function Shadow.apply(gui: GuiObject, node: any, parentNode: any, strategy: string, opacity: number, isRoot: boolean, state: any, warnings: {any})
	local shadows = node.appearance.shadows
	if not shadows or #shadows == 0 then return end
	if not ShadowGeometry.supported(node, parentNode, opacity) then
		table.insert(warnings, { nodeId = node.id, code = &quot;SHADOW_UNSUPPORTED&quot;, message = &quot;Native shadows require opaque static filled shapes with fixed dimensions, no rotation or size constraints, and no auto-layout flow. This shadow was omitted; the layer stays editable.&quot; })
		return
	end
	local responsive = strategy == &quot;responsive&quot; or (isRoot and strategy ~= &quot;pixels&quot;)
	for shadowIndex = #shadows, 1, -1 do
		local config = shadows[shadowIndex]
		local layers = ShadowGeometry.layers(node, config)
		if state.layers + #layers &gt; ShadowGeometry.MAX_TOTAL_LAYERS then
			table.insert(warnings, { nodeId = node.id, code = &quot;SHADOW_BUDGET&quot;, message = &quot;The import reached its 2048 native shadow-layer budget. Remaining shadows were omitted to keep the UI responsive.&quot; })
			return
		end
		state.layers += #layers
		for layerIndex, layer in ipairs(layers) do
			local shadow = Instance.new(&quot;Frame&quot;)
			shadow.Parent = gui.Parent
			-- Sibling rendering puts descendants above their parent background. Shadow
			-- siblings reserve the slot immediately before the original native layer.
			shadow.Name = &quot;FF_Shadow_&quot; .. node.id .. &quot;_&quot; .. shadowIndex .. &quot;_&quot; .. layerIndex
			shadow:SetAttribute(&quot;FF_Decoration&quot;, true)
			shadow:SetAttribute(&quot;FF_ShadowFor&quot;, node.id)
			shadow.BorderSizePixel = 0
			shadow.BackgroundColor3 = Color3.new(config.color.r, config.color.g, config.color.b)
			shadow.BackgroundTransparency = 1 - layer.alpha
			shadow.Visible = gui.Visible
			shadow.Active = false
			shadow.Selectable = false
			shadow.ZIndex = gui.ZIndex - 1
			shadow.AnchorPoint = gui.AnchorPoint
			local x = ShadowGeometry.axis(gui.Position.X.Scale, gui.Position.X.Offset, gui.Size.X.Scale, gui.Size.X.Offset, gui.AnchorPoint.X, parentNode.bounds.width, config.offset.x, layer.expansion, responsive)
			local y = ShadowGeometry.axis(gui.Position.Y.Scale, gui.Position.Y.Offset, gui.Size.Y.Scale, gui.Size.Y.Offset, gui.AnchorPoint.Y, parentNode.bounds.height, config.offset.y, layer.expansion, responsive)
			shadow.Position = UDim2.new(x.positionScale, x.positionOffset, y.positionScale, y.positionOffset)
			shadow.Size = UDim2.new(x.sizeScale, x.sizeOffset, y.sizeScale, y.sizeOffset)
			if layer.cornerRadius &gt; 0 then
				local corner = Instance.new(&quot;UICorner&quot;)
				corner.Name = &quot;FF_ShadowCorner&quot;
				corner.CornerRadius = if node.type == &quot;ELLIPSE&quot; then UDim.new(0.5, 0) else UDim.new(0, layer.cornerRadius)
				corner.Parent = shadow
			end
		end
	end
end

return Shadow
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="FF7"><Properties><string name="Name">ShadowGeometry</string><ProtectedString name="Source">--!strict
-- Pure calculations shared by native shadow creation and CLI regression tests.
local ShadowGeometry = {}
ShadowGeometry.MAX_LAYERS = 8
ShadowGeometry.MAX_TOTAL_LAYERS = 2048

function ShadowGeometry.supported(node: any, parentNode: any, opacity: number): boolean
	local appearance, metadata, layout = node.appearance, node.metadata, node.layout
	if not table.find({ &quot;FRAME&quot;, &quot;COMPONENT&quot;, &quot;INSTANCE&quot;, &quot;RECTANGLE&quot;, &quot;ELLIPSE&quot; }, node.type) then return false end
	if node.strategy ~= &quot;native&quot; or appearance.asset or not appearance.fill or appearance.fill.a ~= 1 or opacity ~= 1 then return false end
	if metadata.element ~= &quot;normal&quot; or metadata.panelId or metadata.initiallyHidden or #metadata.behaviors &gt; 0 or metadata.preserveAspectRatio then return false end
	if layout.horizontalSizing ~= &quot;fixed&quot; or layout.verticalSizing ~= &quot;fixed&quot; then return false end
	if layout.minWidth or layout.maxWidth or layout.minHeight or layout.maxHeight then return false end
	if parentNode.layout.mode ~= &quot;none&quot; and not layout.absolute then return false end
	if parentNode.layout.horizontalSizing == &quot;hug&quot; or parentNode.layout.verticalSizing == &quot;hug&quot; then return false end
	if math.abs(node.bounds.rotation) &gt; 0.001 or node.bounds.width &lt;= 0 or node.bounds.height &lt;= 0 then return false end
	if appearance.gradient then
		for _, stop in ipairs(appearance.gradient.stops) do if stop.color.a &lt; 1 then return false end end
	end
	return true
end

function ShadowGeometry.layers(node: any, shadow: any): {any}
	local count = if shadow.blur &gt; 0 then ShadowGeometry.MAX_LAYERS else 1
	local stroke = node.appearance.stroke
	local strokeExtent = if not stroke or stroke.alignment == &quot;inside&quot; then 0
		elseif stroke.alignment == &quot;outside&quot; then stroke.thickness else stroke.thickness / 2
	local minimumExpansion = -math.min(node.bounds.width, node.bounds.height) / 2 + 0.01
	local result = {}
	local previousCoverage = 0
	for index = 1, count do
		local progress = index / count
		-- Each inset layer adds only the coverage missing from the previous layer.
		-- At the center the composited alpha matches the requested shadow alpha.
		local coverage = shadow.color.a * progress * progress
		local alpha = if previousCoverage &gt;= 1 then 0 else (coverage - previousCoverage) / (1 - previousCoverage)
		local expansion = math.max(minimumExpansion, shadow.spread + strokeExtent + (if count == 1 then 0 else shadow.blur * (count - index) / (count - 1)))
		table.insert(result, {
			expansion = expansion,
			alpha = math.clamp(alpha, 0, 1),
			cornerRadius = math.max(0, node.appearance.cornerRadius + expansion),
		})
		previousCoverage = coverage
	end
	return result
end

-- Copied responsive scale components stay attached to the same parent geometry.
-- Effect offsets are design pixels in pixels/hybrid mode and scale with the shape
-- in responsive mode (or on a responsive root).
function ShadowGeometry.axis(positionScale: number, positionOffset: number, sizeScale: number, sizeOffset: number, anchor: number, parentLength: number, offset: number, expansion: number, responsive: boolean): any
	local shift = offset + (2 * anchor - 1) * expansion
	local denominator = math.max(1, parentLength)
	return {
		positionScale = positionScale + (if responsive then shift / denominator else 0),
		positionOffset = positionOffset + (if responsive then 0 else shift),
		sizeScale = sizeScale + (if responsive then 2 * expansion / denominator else 0),
		sizeOffset = sizeOffset + (if responsive then 0 else 2 * expansion),
	}
end

return ShadowGeometry
