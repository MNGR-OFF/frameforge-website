function Animations._scale(self: any, entry: any)
	if entry.scale then return end
	local existing = entry.object:FindFirstChildWhichIsA(&quot;UIScale&quot;)
	if existing then
		entry.scale = existing
		entry.baseScale = existing.Scale
	else
		local scale = Instance.new(&quot;UIScale&quot;)
		scale.Name = &quot;FF_AnimationScale&quot;
		scale.Parent = entry.object
		entry.scale = scale
		entry.createdScale = true
	end
