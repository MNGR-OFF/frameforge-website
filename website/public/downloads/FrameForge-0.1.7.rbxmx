			if name == &quot;Opacity&quot; or name == &quot;SlideOpacity&quot; or name == &quot;HoverOpacity&quot; or name == &quot;HoverSlideOpacity&quot; then
				self:_refreshOpacity(object)
			else self:_apply(entry) end
		end))
