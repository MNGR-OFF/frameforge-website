</ProtectedString></Properties></Item><Item class="ModuleScript" referent="FF4"><Properties><string name="Name">Geometry</string><ProtectedString name="Source">--!strict
-- Pure geometry shared by the native converter and CLI regression tests.
local Geometry = {}
export type Axis = { positionScale: number, positionOffset: number, sizeScale: number, sizeOffset: number, anchor: number }

function Geometry.axis(start: number, length: number, parentLength: number, constraint: string, strategy: string, sizing: string): Axis
	local parentSize = math.max(parentLength, 1)
	if sizing == &quot;fill&quot; then
		return { positionScale = 0, positionOffset = 0, sizeScale = 1, sizeOffset = 0, anchor = 0 }
	end
	if strategy == &quot;responsive&quot; or (strategy == &quot;hybrid&quot; and constraint == &quot;SCALE&quot;) then
		return { positionScale = start / parentSize, positionOffset = 0, sizeScale = length / parentSize, sizeOffset = 0, anchor = 0 }
	end
	if strategy == &quot;hybrid&quot; and constraint == &quot;STRETCH&quot; then
		return { positionScale = 0, positionOffset = start, sizeScale = 1, sizeOffset = length - parentSize, anchor = 0 }
	end
	if strategy == &quot;hybrid&quot; and constraint == &quot;CENTER&quot; then
		return { positionScale = 0.5, positionOffset = start + length / 2 - parentLength / 2, sizeScale = 0, sizeOffset = length, anchor = 0.5 }
	end
	if strategy == &quot;hybrid&quot; and constraint == &quot;MAX&quot; then
		return { positionScale = 1, positionOffset = start + length - parentLength, sizeScale = 0, sizeOffset = length, anchor = 1 }
	end
	return { positionScale = 0, positionOffset = start, sizeScale = 0, sizeOffset = length, anchor = 0 }
end

function Geometry.designBounds(roots: {any}): any
	local left, top, right, bottom = math.huge, math.huge, -math.huge, -math.huge
	for _, root in ipairs(roots) do
		left = math.min(left, root.bounds.x)
		top = math.min(top, root.bounds.y)
		right = math.max(right, root.bounds.x + root.bounds.width)
		bottom = math.max(bottom, root.bounds.y + root.bounds.height)
	end
	return { x = left, y = top, width = math.max(1, right - left), height = math.max(1, bottom - top), rotation = 0 }
end

return Geometry
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="FF5"><Properties><string name="Name">Layout</string><ProtectedString name="Source">--!strict
local Layout = {}
local Geometry = require(script.Parent.Geometry)
Layout.axis = Geometry.axis
Layout.designBounds = Geometry.designBounds

local function automaticSize(horizontal: boolean, vertical: boolean): Enum.AutomaticSize
	if horizontal and vertical then return Enum.AutomaticSize.XY end
	if horizontal then return Enum.AutomaticSize.X end
	if vertical then return Enum.AutomaticSize.Y end
	return Enum.AutomaticSize.None
end

function Layout.apply(gui: GuiObject, node: any, parentNode: any, strategy: string, isRoot: boolean)
	local bounds, layout = node.bounds, node.layout
	local parentBounds = parentNode.bounds
	local inFlow = parentNode.layout.mode ~= &quot;none&quot; and not layout.absolute
	local padding = parentNode.layout.padding
	local parentWidth = math.max(1, parentBounds.width - (if inFlow then padding.left + padding.right else 0))
	local parentHeight = math.max(1, parentBounds.height - (if inFlow then padding.top + padding.bottom else 0))
	local axisStrategy = if isRoot and strategy ~= &quot;pixels&quot; then &quot;responsive&quot; else strategy
	local parentHugX, parentHugY = parentNode.layout.horizontalSizing == &quot;hug&quot;, parentNode.layout.verticalSizing == &quot;hug&quot;
	local x = Layout.axis(bounds.x, bounds.width, parentWidth, layout.horizontalConstraint,
		if parentHugX then &quot;pixels&quot; else axisStrategy, if parentHugX then &quot;fixed&quot; else layout.horizontalSizing)
	local y = Layout.axis(bounds.y, bounds.height, parentHeight, layout.verticalConstraint,
		if parentHugY then &quot;pixels&quot; else axisStrategy, if parentHugY then &quot;fixed&quot; else layout.verticalSizing)
	gui.Position = UDim2.new(x.positionScale, x.positionOffset, y.positionScale, y.positionOffset)
	gui.Size = UDim2.new(x.sizeScale, x.sizeOffset, y.sizeScale, y.sizeOffset)
	gui.AnchorPoint = Vector2.new(x.anchor, y.anchor)
	gui.Rotation = bounds.rotation

	-- A hug axis must start at zero; a scaled hug axis would create a parent/child sizing cycle.
	local hugX, hugY = layout.horizontalSizing == &quot;hug&quot;, layout.verticalSizing == &quot;hug&quot;
	if hugX then gui.Size = UDim2.new(0, 0, gui.Size.Y.Scale, gui.Size.Y.Offset) end
	if hugY then gui.Size = UDim2.new(gui.Size.X.Scale, gui.Size.X.Offset, 0, 0) end
	gui.AutomaticSize = automaticSize(hugX, hugY)

	if layout.minWidth or layout.maxWidth or layout.minHeight or layout.maxHeight then
		local limits = Instance.new(&quot;UISizeConstraint&quot;)
		limits.Name = &quot;FF_SizeLimits&quot;
		limits.MinSize = Vector2.new(layout.minWidth or 0, layout.minHeight or 0)
		limits.MaxSize = Vector2.new(layout.maxWidth or 1000000, layout.maxHeight or 1000000)
		limits.Parent = gui
	end
	if node.metadata.preserveAspectRatio and bounds.width &gt; 0 and bounds.height &gt; 0 then
		local aspect = Instance.new(&quot;UIAspectRatioConstraint&quot;)
		aspect.Name = &quot;FF_AspectRatio&quot;
		aspect.AspectRatio = bounds.width / bounds.height
		aspect.AspectType = Enum.AspectType.FitWithinMaxSize
		aspect.Parent = gui
	end
	if inFlow and parentNode.layout.mode ~= &quot;grid&quot; then
		gui.AnchorPoint = Vector2.zero
		gui.Position = UDim2.fromOffset(0, 0)
		local isHorizontal = parentNode.layout.mode == &quot;horizontal&quot;
		local mainSizing = if isHorizontal then layout.horizontalSizing else layout.verticalSizing
		if mainSizing == &quot;fill&quot; and not (if isHorizontal then parentHugX else parentHugY) then
			-- Flex chooses the remaining space after gaps and fixed siblings, avoiding N full-width children.
			local flex = Instance.new(&quot;UIFlexItem&quot;)
			flex.Name = &quot;FF_Flex&quot;
			flex.FlexMode = Enum.UIFlexMode.Fill
			flex.Parent = gui
			if isHorizontal then gui.Size = UDim2.new(0, bounds.width, gui.Size.Y.Scale, gui.Size.Y.Offset)
			else gui.Size = UDim2.new(gui.Size.X.Scale, gui.Size.X.Offset, 0, bounds.height) end
		end
	end
end

local HORIZONTAL = { start = Enum.HorizontalAlignment.Left, center = Enum.HorizontalAlignment.Center, [&quot;end&quot;] = Enum.HorizontalAlignment.Right }
local VERTICAL = { start = Enum.VerticalAlignment.Top, center = Enum.VerticalAlignment.Center, [&quot;end&quot;] = Enum.VerticalAlignment.Bottom }

function Layout.container(gui: GuiObject, node: any): GuiObject
	local config = node.layout
	if config.mode == &quot;none&quot; then return gui end
	-- Layout objects affect every sibling GuiObject. A content frame keeps image backgrounds and
	-- Figma absolute-position children out of flow without changing the editable node itself.
	local content = Instance.new(&quot;Frame&quot;)
	content.Name = &quot;FF_Content&quot;
	content.BackgroundTransparency = 1
	content.BorderSizePixel = 0
	content.Size = UDim2.fromScale(1, 1)
	content.ZIndex = gui.ZIndex
	local hugX, hugY = config.horizontalSizing == &quot;hug&quot;, config.verticalSizing == &quot;hug&quot;
	if gui:IsA(&quot;ScrollingFrame&quot;) then
		local direction = config.scrollDirection or &quot;y&quot;
		hugX = hugX or direction == &quot;x&quot; or direction == &quot;xy&quot;
		hugY = hugY or direction == &quot;y&quot; or direction == &quot;xy&quot;
	end
	if hugX then content.Size = UDim2.new(0, 0, content.Size.Y.Scale, content.Size.Y.Offset) end
	if hugY then content.Size = UDim2.new(content.Size.X.Scale, content.Size.X.Offset, 0, 0) end
	content.AutomaticSize = automaticSize(hugX, hugY)
	content.Parent = gui
	local pad = Instance.new(&quot;UIPadding&quot;)
	pad.Name = &quot;FF_Padding&quot;
	pad.PaddingTop = UDim.new(0, config.padding.top)
	pad.PaddingRight = UDim.new(0, config.padding.right)
	pad.PaddingBottom = UDim.new(0, config.padding.bottom)
	pad.PaddingLeft = UDim.new(0, config.padding.left)
	pad.Parent = content
	if config.mode == &quot;grid&quot; then
		local grid = Instance.new(&quot;UIGridLayout&quot;)
		grid.Name = &quot;FF_Grid&quot;
		grid.SortOrder = Enum.SortOrder.LayoutOrder
		grid.CellPadding = UDim2.fromOffset(config.gap, config.gap)
		local columns = config.columns or 3
		local first = node.children[1]
		local cellHeight = if first then first.bounds.height else 64
		grid.FillDirectionMaxCells = columns
		grid.CellSize = UDim2.new(1 / columns, -config.gap * (columns - 1) / columns, 0, cellHeight)
		grid.HorizontalAlignment = HORIZONTAL[config.primaryAlign] or Enum.HorizontalAlignment.Left
		grid.VerticalAlignment = VERTICAL[config.crossAlign] or Enum.VerticalAlignment.Top
		grid.Parent = content
	else
		local list = Instance.new(&quot;UIListLayout&quot;)
		list.Name = &quot;FF_List&quot;
		list.SortOrder = Enum.SortOrder.LayoutOrder
		list.Padding = UDim.new(0, config.gap)
		local horizontal = config.mode == &quot;horizontal&quot;
		list.FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical
		list.HorizontalAlignment = HORIZONTAL[if horizontal then config.primaryAlign else config.crossAlign] or Enum.HorizontalAlignment.Left
		list.VerticalAlignment = VERTICAL[if horizontal then config.crossAlign else config.primaryAlign] or Enum.VerticalAlignment.Top
		list.Wraps = config.wrap == true
		if config.primaryAlign == &quot;space-between&quot; then
			if horizontal then list.HorizontalFlex = Enum.UIFlexAlignment.SpaceBetween
			else list.VerticalFlex = Enum.UIFlexAlignment.SpaceBetween end
		end
		list.Parent = content
	end
	return content
end

return Layout
