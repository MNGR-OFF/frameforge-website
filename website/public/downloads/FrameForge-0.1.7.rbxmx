function Animations._updateHeartbeat(self: any)
	if self._destroyed then return end
	local needed = false
	for _, entry in self._idle do
		for _, behavior in entry.behaviors do
			if (IDLE[behavior.type] and (behavior.trigger ~= &quot;hover&quot; or entry.hoverStates[behavior])) or ((behavior.type == &quot;hoverMove&quot; or behavior.type == &quot;hoverTilt&quot;) and behavior.trigger == &quot;loop&quot;) then needed = true; break end
		end
		if needed then break end
	end
	if needed and not self._heartbeat then
		self._heartbeat = RunService.Heartbeat:Connect(function(dt) for _, entry in self._idle do self:_step(entry, dt) end end)
	elseif not needed and self._heartbeat then self._heartbeat:Disconnect(); self._heartbeat = nil end
end

function Animations.ResetHover(self: any, object: GuiObject)
	local entry = self._entries[object]
	if not entry then return end
	table.clear(entry.hoverStates)
	for _, effects in entry.hoverEffects do effects:Destroy() end
	table.clear(entry.hoverEffects)
	for _, key in { &quot;HoverX&quot;, &quot;HoverY&quot;, &quot;Tilt&quot;, &quot;HoverEntrance&quot;, &quot;HoverOpacity&quot;, &quot;HoverSlideOpacity&quot;, &quot;HoverSlideY&quot; } do
		if entry.tweens[key] then entry.tweens[key]:Cancel(); entry.tweens[key]:Destroy(); entry.tweens[key] = nil end
		entry.values[key].Value = if key == &quot;HoverEntrance&quot; or key == &quot;HoverOpacity&quot; or key == &quot;HoverSlideOpacity&quot; then 1 else 0
	end
	entry.elapsed = 0
	entry.idleScale, entry.idleOffset, entry.idleRotation = 1, Vector2.zero, 0
	self:_apply(entry)
	self:_refreshOpacity(object)
	self:_updateHeartbeat()
