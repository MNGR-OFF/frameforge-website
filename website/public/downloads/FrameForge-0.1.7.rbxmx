		if active then
			local effects = Cleanup.new()
			entry.hoverEffects[behavior] = effects
			effects:Delay(number(behavior.delay, 0, 0, 60), function()
				if self._entries[object] == entry and entry.hoverStates[behavior] then self:_entrance(entry, behavior, effects) end
			end)
		else
			local keys = if behavior.type == &quot;pop&quot; then { &quot;HoverEntrance&quot; } elseif behavior.type == &quot;fade&quot; then { &quot;HoverOpacity&quot; } elseif behavior.type == &quot;slide&quot; then { &quot;HoverSlideY&quot;, &quot;HoverSlideOpacity&quot; } else {}
			for _, key in keys do
				if entry.tweens[key] then entry.tweens[key]:Cancel(); entry.tweens[key]:Destroy(); entry.tweens[key] = nil end
				entry.values[key].Value = if key == &quot;HoverSlideY&quot; then 0 else 1
			end
			self:_apply(entry)
			self:_refreshOpacity(object)
		end
	end
	if IDLE[behavior.type] and not active then
		entry.elapsed = 0
		self:_step(entry, 0)
	end
	self:_updateHeartbeat()
end

function Animations.Interact(self: any, object: GuiObject, hovered: boolean, pressed: boolean, disabled: boolean)
	local entry = self._entries[object]
	if not entry then return end
	for _, behavior in entry.behaviors do
		if not behavior.hoverSource or behavior.hoverSource == &quot;self&quot; then self:SetHover(object, behavior, hovered and not disabled) end
	end
	local multiplier, scaleBehavior = EffectMath.Interaction(entry.behaviors, hovered, pressed, disabled)
	if scaleBehavior then
		self:_scale(entry)
		self:_tween(entry, &quot;Hover&quot;, entry.values.Hover, { Value = multiplier }, scaleBehavior, 0.15)
	elseif entry.scale then
		self:_tween(entry, &quot;Hover&quot;, entry.values.Hover, { Value = 1 }, {}, 0.15)
	end
	for _, behavior in entry.behaviors do
		if behavior.type == &quot;color&quot; and type(behavior.color) == &quot;table&quot; then
			if entry.baseColor == nil then entry.baseColor = object.BackgroundColor3 end
			local color = entry.baseColor
			if hovered and not disabled then
				color = Color3.new(number(behavior.color.r, 1, 0, 1), number(behavior.color.g, 1, 0, 1), number(behavior.color.b, 1, 0, 1))
			end
			self:_tween(entry, &quot;Color&quot;, object, { BackgroundColor3 = color }, behavior, 0.15)
		end
	end
end

function Animations._step(self: any, entry: any, dt: number)
	local active = visible(entry.object, self.Root) and entry.object:GetAttribute(&quot;FF_Disabled&quot;) ~= true
	if not active then
		if entry.active then
			entry.active = false
			entry.idleScale = 1; entry.idleOffset = Vector2.zero; entry.idleRotation = 0
			self:_apply(entry)
		end
		return
	end
	entry.active = true
	entry.elapsed += math.min(dt, 0.1)
	local scale, x, y, rotation = EffectMath.Sample(entry.behaviors, entry.elapsed, entry.layoutOwned, entry.hoverStates, entry.loopEasing)
	if scale ~= 1 then self:_scale(entry) end
	entry.idleScale = scale; entry.idleOffset = Vector2.new(x, y); entry.idleRotation = rotation
	self:_apply(entry)
end

function Animations._entrance(self: any, entry: any, behavior: any, hoverEffects: any?)
	if not visible(entry.object, self.Root) then return end
	local kind = behavior.type
	local entranceKey = if hoverEffects then &quot;HoverEntrance&quot; else &quot;Entrance&quot;
	local opacityKey = if hoverEffects then &quot;HoverOpacity&quot; else &quot;Opacity&quot;
	local slideOpacityKey = if hoverEffects then &quot;HoverSlideOpacity&quot; else &quot;SlideOpacity&quot;
	local slideKey = if hoverEffects then &quot;HoverSlideY&quot; else &quot;Y&quot;
	if kind == &quot;pop&quot; then
		self:_scale(entry)
		entry.values[entranceKey].Value = number(behavior.scale, 0.8, 0.05, 4)
		self:_tween(entry, entranceKey, entry.values[entranceKey], { Value = 1 }, behavior, 0.3)
	elseif kind == &quot;fade&quot; then
		entry.values[opacityKey].Value = 0
		self:_tween(entry, opacityKey, entry.values[opacityKey], { Value = 1 }, behavior, 0.25)
	elseif kind == &quot;slide&quot; then
		if entry.layoutOwned then
			entry.values[slideOpacityKey].Value = 0
			self:_tween(entry, slideOpacityKey, entry.values[slideOpacityKey], { Value = 1 }, behavior, 0.3)
		else
			entry.positionTransform = true
			entry.values[slideKey].Value = number(behavior.distance, 24, -2000, 2000)
			self:_tween(entry, slideKey, entry.values[slideKey], { Value = 0 }, behavior, 0.3)
		end
	elseif kind == &quot;cascade&quot; then
		local children = {}
		local function collect(container: Instance)
			for _, child in container:GetChildren() do
				if child:IsA(&quot;GuiObject&quot;) then
					if child.Name == &quot;FF_Content&quot; and child:GetAttribute(&quot;FF_ID&quot;) == nil then collect(child)
					elseif self._entries[child] and (child:GetAttribute(&quot;FF_ID&quot;) ~= nil or string.sub(child.Name, 1, 3) ~= &quot;FF_&quot;) then table.insert(children, child) end
				end
			end
		end
		collect(entry.object)
		table.sort(children, function(a, b)
			return if a.LayoutOrder == b.LayoutOrder then a.Name &lt; b.Name else a.LayoutOrder &lt; b.LayoutOrder
		end)
		for index, child in children do
			self:_cascade(entry, self._entries[child], behavior, (index - 1) * number(behavior.stagger, 0.06, 0, 10), hoverEffects)
		end
	end
end

function Animations._cascade(self: any, owner: any, childEntry: any, behavior: any, delay: number, hoverEffects: any?)
	local effects = hoverEffects or owner.effects
	local scope = Cleanup.new()
	local driver = Instance.new(&quot;NumberValue&quot;)
	driver.Value = 0
	childEntry.cascades[scope] = driver
	-- Cascade opacity belongs to the parent. A child's own fade/reset cannot erase
	-- its stagger, and canceling/replaying the parent always restores every child.
	scope:Give(function()
		childEntry.cascades[scope] = nil
		if not effects._destroyed then effects:Remove(scope) end
		if self._entries[childEntry.object] == childEntry then self:_refreshOpacity(childEntry.object) end
	end)
	scope:Give(driver)
	scope:Give(driver.Changed:Connect(function() self:_refreshOpacity(childEntry.object) end))
	effects:Give(scope)
	self:_refreshOpacity(childEntry.object)
	scope:Delay(delay, function()
		if self._entries[childEntry.object] ~= childEntry or not visible(childEntry.object, self.Root) then scope:Destroy(); return end
		local tween = TweenService:Create(driver, tweenInfo(behavior, 0.25), { Value = 1 })
		scope:Give(tween)
		scope:Give(tween.Completed:Connect(function() scope:Destroy() end))
		tween:Play()
	end)
end

function Animations.Play(self: any, object: GuiObject, override: any?)
	local entry = self._entries[object]
	if not entry or self._destroyed then return end
	self:Reset(object)
	local behaviors = if type(override) == &quot;table&quot; then { override } elseif type(override) == &quot;string&quot; then { { type = override } } else entry.behaviors
	for _, behavior in behaviors do
		if ENTRANCE[behavior.type] and (override ~= nil or behavior.trigger ~= &quot;hover&quot;) then
			entry.effects:Delay(number(behavior.delay, 0, 0, 60), function()
				if self._entries[object] == entry then self:_entrance(entry, behavior) end
			end)
		end
	end
end

function Animations.Reset(self: any, object: GuiObject)
	local entry = self._entries[object]
	if not entry then return end
	if entry.ripples then
		local ripples = {}
		for scope in entry.ripples do table.insert(ripples, scope) end
		for _, scope in ripples do scope:Destroy() end
	end
	entry.effects:Destroy(); entry.effects = Cleanup.new()
	for _, key in { &quot;Entrance&quot;, &quot;Impulse&quot;, &quot;Opacity&quot;, &quot;SlideOpacity&quot;, &quot;X&quot;, &quot;Y&quot; } do
		if entry.tweens[key] then entry.tweens[key]:Cancel(); entry.tweens[key]:Destroy(); entry.tweens[key] = nil end
		entry.values[key].Value = if key == &quot;X&quot; or key == &quot;Y&quot; then 0 else 1
	end
	self:_apply(entry)
	self:_refreshOpacity(object)
end

function Animations.Ripple(self: any, object: GuiObject, behavior: any, input: InputObject?)
	local entry = self._entries[object]
	if not entry or not visible(object, self.Root) then return end
	if object:FindFirstChildWhichIsA(&quot;UIGridStyleLayout&quot;) then
		-- A direct layout would reposition a new overlay. Use a scale feedback fallback.
		self:_scale(entry); entry.values.Impulse.Value = 0.98
		self:_tween(entry, &quot;Impulse&quot;, entry.values.Impulse, { Value = 1 }, behavior, 0.2)
		return
	end
	local scope = Cleanup.new()
	local overlay = Instance.new(&quot;CanvasGroup&quot;)
	overlay.Name = &quot;FF_Ripple&quot;
	overlay:SetAttribute(&quot;FF_Transient&quot;, true)
	overlay.Size = UDim2.fromScale(1, 1); overlay.BackgroundTransparency = 1
	overlay.BorderSizePixel = 0; overlay.ClipsDescendants = true; overlay.ZIndex = object.ZIndex + 10
	overlay.Parent = object
	scope:Give(overlay)
	local corner = object:FindFirstChildWhichIsA(&quot;UICorner&quot;)
	if corner then corner:Clone().Parent = overlay end
	local circle = Instance.new(&quot;Frame&quot;)
	circle.AnchorPoint = Vector2.new(0.5, 0.5); circle.BorderSizePixel = 0
	circle.ZIndex = overlay.ZIndex; circle.BackgroundTransparency = 0.6
	local color = behavior.color
	circle.BackgroundColor3 = if type(color) == &quot;table&quot; then Color3.new(number(color.r, 1, 0, 1), number(color.g, 1, 0, 1), number(color.b, 1, 0, 1)) else Color3.new(1, 1, 1)
	local position = object.AbsoluteSize / 2
	local collector = object:FindFirstAncestorWhichIsA(&quot;LayerCollector&quot;)
	if input and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
		if collector and collector:IsA(&quot;ScreenGui&quot;) then
			position = Vector2.new(input.Position.X, input.Position.Y) - object.AbsolutePosition
			if not collector.IgnoreGuiInset then local inset = game:GetService(&quot;GuiService&quot;):GetGuiInset(); position -= inset end
		end
	end
	local width = math.max(1, object.AbsoluteSize.X); local height = math.max(1, object.AbsoluteSize.Y)
	circle.Position = UDim2.fromScale(math.clamp(position.X / width, 0, 1), math.clamp(position.Y / height, 0, 1)); circle.Size = UDim2.fromScale(0, 0)
	circle.Parent = overlay
	local rounded = Instance.new(&quot;UICorner&quot;); rounded.CornerRadius = UDim.new(1, 0); rounded.Parent = circle
	local diameter = object.AbsoluteSize.Magnitude * 2
	local tween = TweenService:Create(circle, tweenInfo(behavior, 0.45), { Size = UDim2.fromScale(diameter / width, diameter / height), BackgroundTransparency = 1 })
	scope:Give(tween)
	scope:Give(tween.Completed:Connect(function() scope:Destroy() end))
	-- The node owns in-flight ripple scopes; completed scopes are removed from this set.
	entry.ripples = entry.ripples or {}
	local count, oldest, oldestTime = 0, nil, math.huge
	for activeScope, created in entry.ripples do
		count += 1
		if created &lt; oldestTime then oldest = activeScope; oldestTime = created end
	end
	if count &gt;= 8 and oldest then oldest:Destroy() end
	entry.ripples[scope] = os.clock()
	scope:Give(function() entry.ripples[scope] = nil end)
	tween:Play()
end

function Animations.Remove(self: any, object: GuiObject)
	local entry = self._entries[object]
	if not entry then return end
	local cascades = {}
	for scope in entry.cascades do table.insert(cascades, scope) end
	for _, scope in cascades do scope:Destroy() end
	if entry.ripples then for scope in entry.ripples do scope:Destroy() end end
	entry.scope:Destroy()
	self._entries[object] = nil; self._idle[object] = nil
	self:_updateHeartbeat()
end

function Animations.Destroy(self: any)
	if self._destroyed then return end
	self._destroyed = true
	if self._heartbeat then self._heartbeat:Disconnect(); self._heartbeat = nil end
	local objects = {}
	for object in self._entries do table.insert(objects, object) end
	for _, object in objects do self:Remove(object) end
	self._scope:Destroy()
end

return Animations

end
loaders[&quot;Bindings&quot;] = function(require, script)
--!strict
local Players = game:GetService(&quot;Players&quot;)
local Cleanup = require(script.Parent.Cleanup)

local Bindings = {}
Bindings.__index = Bindings

function Bindings.new(player: Player?)
	return setmetatable({
		Player = player or Players.LocalPlayer,
		_values = {} :: { [string]: any },
		_changed = Instance.new(&quot;BindableEvent&quot;),
		_scope = Cleanup.new(),
		_attachments = {},
		_destroyed = false,
	}, Bindings)
end

-- Custom bindings are client presentation data, never a server authority boundary.
function Bindings.Set(self: any, name: string, value: any)
	if self._destroyed then return end
	self._values[name] = value
	self._changed:Fire(name, value)
end

function Bindings.Get(self: any, name: string): any
	return self._values[name]
end

function Bindings.Attach(self: any, object: GuiObject, behavior: any): any
	local scope = Cleanup.new()
	if self._destroyed then scope:Destroy(); return scope end
	self._attachments[scope] = true
	scope:Give(function() self._attachments[scope] = nil end)
	local player = self.Player
	local source = tostring(behavior.source or behavior.value or &quot;&quot;)
	local format = if type(behavior.format) == &quot;string&quot; then behavior.format else &quot;{value}&quot;
	local writable: any = nil
	if object:IsA(&quot;TextLabel&quot;) or object:IsA(&quot;TextButton&quot;) or object:IsA(&quot;TextBox&quot;) then
		writable = object
	else
		for _, child in object:GetDescendants() do
			if child:IsA(&quot;TextLabel&quot;) then writable = child; break end
		end
	end
	if not writable then
		warn(&quot;[FrameForge] Binding needs a text object: &quot; .. object:GetFullName())
		return scope
	end
	local function update(value: any)
		if scope._destroyed then return end
		local text = if value == nil then &quot;&quot; else tostring(value)
		writable.Text = string.gsub(format, &quot;{value}&quot;, function() return text end)
	end
	if source == &quot;PlayerName&quot; or source == &quot;DisplayName&quot; then
		if player then
			local property = if source == &quot;PlayerName&quot; then &quot;Name&quot; else &quot;DisplayName&quot;
			update((player :: any)[property])
			scope:Give(player:GetPropertyChangedSignal(property):Connect(function()
				update((player :: any)[property])
			end))
		end
	elseif string.sub(source, 1, 11) == &quot;Attributes.&quot; then
		local name = string.sub(source, 12)
		if player and name ~= &quot;&quot; then
			update(player:GetAttribute(name))
			scope:Give(player:GetAttributeChangedSignal(name):Connect(function()
				update(player:GetAttribute(name))
			end))
		end
	elseif string.sub(source, 1, 12) == &quot;leaderstats.&quot; then
		local name = string.sub(source, 13)
		if player then
			local currentScope = Cleanup.new()
			scope:Give(function() currentScope:Destroy() end)
			local function resolve()
				currentScope:Destroy()
				currentScope = Cleanup.new()
				local stats = player:FindFirstChild(&quot;leaderstats&quot;)
				if not stats then update(nil); return end
				local valueScope = currentScope
				local function resolveValue()
					local value = stats:FindFirstChild(name)
					if value and value:IsA(&quot;ValueBase&quot;) then
						update((value :: any).Value)
						currentScope:Give(value.Changed:Connect(function()
							if not valueScope._destroyed and stats.Parent == player and value.Parent == stats then update((value :: any).Value) end
						end))
					else
						update(nil)
					end
				end
				currentScope:Give(stats.ChildAdded:Connect(function(child)
					if child.Name == name then resolve() end
				end))
				currentScope:Give(stats.ChildRemoved:Connect(function(child)
					if child.Name == name then resolve() end
				end))
				resolveValue()
			end
			scope:Give(player.ChildAdded:Connect(function(child)
				if child.Name == &quot;leaderstats&quot; then resolve() end
			end))
			scope:Give(player.ChildRemoved:Connect(function(child)
				if child.Name == &quot;leaderstats&quot; then resolve() end
			end))
			resolve()
		end
	else
		local name = if string.sub(source, 1, 7) == &quot;Custom.&quot; then string.sub(source, 8) else source
		update(self._values[name])
		scope:Give(self._changed.Event:Connect(function(changed: string, value: any)
			if changed == name then update(value) end
		end))
	end
	return scope
end

function Bindings.Destroy(self: any)
	if self._destroyed then return end
	self._destroyed = true
	for scope in self._attachments do scope:Destroy() end
	self._scope:Destroy()
	self._changed:Destroy()
	table.clear(self._values)
end

return Bindings

end
loaders[&quot;Cleanup&quot;] = function(require, script)
--!strict
-- A small ownership scope for connections, instances, delayed tasks, and functions.
local Cleanup = {}
Cleanup.__index = Cleanup

export type Scope = typeof(setmetatable({ _items = {} :: { any }, _destroyed = false }, Cleanup))

local function dispose(item: any)
	if typeof(item) == &quot;RBXScriptConnection&quot; then
		item:Disconnect()
	elseif typeof(item) == &quot;Instance&quot; then
		item:Destroy()
	elseif type(item) == &quot;function&quot; then
		item()
	elseif type(item) == &quot;thread&quot; then
		if coroutine.status(item) ~= &quot;dead&quot; then
			pcall(task.cancel, item)
		end
	elseif type(item) == &quot;table&quot; and type(item.Destroy) == &quot;function&quot; then
		item:Destroy()
	end
end

function Cleanup.new(): Scope
	return setmetatable({ _items = {}, _destroyed = false }, Cleanup)
end

function Cleanup.Give(self: Scope, item: any): any
	if self._destroyed then
		dispose(item)
	else
		table.insert(self._items, item)
	end
	return item
end

function Cleanup.Remove(self: Scope, item: any)
	local index = table.find(self._items, item)
	if index then table.remove(self._items, index) end
end

function Cleanup.Delay(self: Scope, seconds: number, callback: () -&gt; ())
	local pending = true
	local cancel: () -&gt; ()
	local thread = task.delay(math.max(0, seconds), function()
		if not pending or self._destroyed then return end
		pending = false
		self:Remove(cancel)
		callback()
	end)
	cancel = function()
		if pending then
			pending = false
			pcall(task.cancel, thread)
		end
	end
	self:Give(cancel)
end

function Cleanup.Destroy(self: Scope)
	if self._destroyed then return end
	self._destroyed = true
	for index = #self._items, 1, -1 do
		local ok, message = pcall(dispose, self._items[index])
		if not ok then warn(&quot;[FrameForge] Cleanup: &quot; .. tostring(message)) end
	end
	table.clear(self._items)
end

return Cleanup

end
loaders[&quot;EffectMath&quot;] = function(require, script)
--!strict
-- Pure effect composition: kept free of engine services for deterministic tests.
local EffectMath = {}

function EffectMath.Number(value: any, fallback: number, minimum: number?, maximum: number?): number
	if type(value) ~= &quot;number&quot; or value ~= value or math.abs(value) == math.huge then return fallback end
	return math.clamp(value, minimum or -math.huge, maximum or math.huge)
end

-- Explicit hover/press choices override the matching smooth preset, regardless of
-- serialization order. Press feedback takes precedence while an input is held.
function EffectMath.Interaction(behaviors: { any }, hovered: boolean, pressed: boolean, disabled: boolean): (number, any)
	local smooth, hover, press = nil, nil, nil
	for _, behavior in behaviors do
		if behavior.type == &quot;smooth&quot; then smooth = behavior
		elseif behavior.type == &quot;hoverScale&quot; then hover = behavior
		elseif behavior.type == &quot;pressScale&quot; then press = behavior end
	end
	if not disabled then
		if pressed and (press or smooth) then
			local behavior = press or smooth
			return EffectMath.Number(if press then press.scale else smooth.pressScale, 0.95, 0.1, 4), behavior
		elseif hovered and (hover or smooth) then
			local behavior = hover or smooth
			return EffectMath.Number(if hover then hover.scale else smooth.hoverScale, 1.05, 0.1, 4), behavior
		end
	end
	return 1, press or hover or smooth
end

function EffectMath.FitScale(width: number, height: number, availableWidth: number, availableHeight: number): number
	if width &lt;= 0 or height &lt;= 0 or availableWidth &lt;= 0 or availableHeight &lt;= 0 then return 1 end
	return math.min(1, availableWidth / width, availableHeight / height)
end

local function motionAmount(behavior: any, elapsed: number, loopEasing: any?): number
	local phase = (elapsed / EffectMath.Number(behavior.duration, 0.2, 0.01, 60)) % 2
	local progress = if phase &lt;= 1 then phase else 2 - phase
	return if loopEasing then loopEasing(behavior, progress) else (1 - math.cos(progress * math.pi)) / 2
end

function EffectMath.Sample(behaviors: { any }, elapsed: number, layoutOwned: boolean?, hoverStates: any?, loopEasing: any?): (number, number, number, number)
	local scale, x, y, rotation = 1, 0, 0, 0
	for _, behavior in behaviors do
		if behavior.trigger == &quot;hover&quot; and (not hoverStates or not hoverStates[behavior]) then continue end
		local speed = EffectMath.Number(behavior.speed, 1, -3600, 3600)
		local phase = elapsed * speed * math.pi * 2
		if behavior.type == &quot;pulse&quot; then
			local amplitude = if type(behavior.scale) == &quot;number&quot; then EffectMath.Number(behavior.scale, 1.03, 0.5, 1.5) - 1 else EffectMath.Number(behavior.intensity, 0.03, 0, 0.5)
			scale *= 1 + math.sin(phase) * amplitude
		elseif behavior.type == &quot;float&quot; then
			if layoutOwned then scale *= 1 + math.sin(phase) * 0.015
			else y += math.sin(phase) * EffectMath.Number(behavior.distance, 6, -500, 500) end
		elseif behavior.type == &quot;spin&quot; then
			rotation += (elapsed * EffectMath.Number(behavior.speed, 30, -3600, 3600)) % 360
		elseif behavior.type == &quot;wiggle&quot; then
			rotation += math.sin(phase) * EffectMath.Number(behavior.intensity, 4, 0, 90)
		elseif behavior.type == &quot;shake&quot; then
			local intensity = EffectMath.Number(behavior.intensity, 3, 0, 100)
			if layoutOwned then scale *= 1 + math.sin(phase * 7.1) * math.min(intensity / 100, 0.05)
			else x += math.sin(phase * 7.1) * intensity; y += math.sin(phase * 8.7) * intensity end
		elseif behavior.type == &quot;hoverMove&quot; and behavior.trigger == &quot;loop&quot; and not layoutOwned then
			local amount = motionAmount(behavior, elapsed, loopEasing)
			x += amount * EffectMath.Number(behavior.offsetX, -30, -10000, 10000)
			y += amount * EffectMath.Number(behavior.offsetY, 0, -10000, 10000)
		elseif behavior.type == &quot;hoverTilt&quot; and behavior.trigger == &quot;loop&quot; then
			rotation += motionAmount(behavior, elapsed, loopEasing) * EffectMath.Number(behavior.angle, 8, -360, 360)
		end
	end
	return scale, x, y, rotation
end

return EffectMath

end
loaders[&quot;HoverSources&quot;] = function(require, script)
--!strict
-- External hover sources own only event connections, never per-frame polling.
local Cleanup = require(script.Parent.Cleanup)
local HoverSources = {}

local function inputOwner(object: GuiObject): GuiObject
	local proxy = object:FindFirstChild(&quot;FF_Input&quot;)
	return if proxy and proxy:IsA(&quot;GuiButton&quot;) then proxy else object
end

local function resolve(controller: any, object: GuiObject, value: string): GuiObject?
	if value ~= &quot;parent&quot; then return controller:Find(value) end
	local current, fallback = object.Parent, nil
	while current do
		if current:IsA(&quot;GuiObject&quot;) then
			if not fallback and current:GetAttribute(&quot;FF_Decoration&quot;) ~= true and current.Name ~= &quot;FF_Content&quot; then fallback = current end
			if current:IsA(&quot;GuiButton&quot;) or inputOwner(current):IsA(&quot;GuiButton&quot;) then return current end
		end
		if current == controller.Root then break end
		current = current.Parent
	end
	return fallback
end

function HoverSources.Bind(controller: any, object: GuiObject, behaviors: {any}): any
	local scope = Cleanup.new()
	local groups = {}
	for _, behavior in behaviors do
		local value = behavior.hoverSource
		local visual = behavior.type == &quot;hoverMove&quot; or behavior.type == &quot;hoverTilt&quot; or behavior.trigger == &quot;hover&quot;
		if visual and type(value) == &quot;string&quot; and value ~= &quot;self&quot; and behavior.trigger ~= &quot;loop&quot; then
			local source = resolve(controller, object, value)
			if source and source ~= object then
				groups[source] = groups[source] or {}; table.insert(groups[source], behavior)
			elseif not source then warn(&quot;[FrameForge] Hover source not found for &quot; .. object.Name .. &quot;: &quot; .. value) end
		end
	end
	for source, effects in groups do
		local feedback = inputOwner(source)
		local mouse, focused = false, game:GetService(&quot;GuiService&quot;).SelectedObject == feedback
		local function usable(target: GuiObject): boolean
			if target ~= controller.Root and not target:IsDescendantOf(controller.Root) then return false end
			local ancestor: Instance? = target
			while ancestor do
				if ancestor:GetAttribute(&quot;FF_Disabled&quot;) == true then return false end
				if ancestor:IsA(&quot;GuiObject&quot;) and not ancestor.Visible then return false end
				if ancestor:IsA(&quot;LayerCollector&quot;) and not ancestor.Enabled then return false end
				if ancestor == controller.Root then return ancestor.Parent ~= nil end
				ancestor = ancestor.Parent
			end
			return false
		end
		local function update()
			local enabled = usable(source) and usable(object)
			if not enabled then mouse = false; focused = false end
			for _, behavior in effects do controller.Animations:SetHover(object, behavior, enabled and (mouse or focused)) end
		end
		scope:Give(feedback.MouseEnter:Connect(function() mouse = true; update() end))
		scope:Give(feedback.MouseLeave:Connect(function() mouse = false; update() end))
		scope:Give(feedback.SelectionGained:Connect(function() focused = true; update() end))
		scope:Give(feedback.SelectionLost:Connect(function() focused = false; update() end))
		scope:Give(source.AncestryChanged:Connect(update))
		local watched = {}
		for _, start in { source, object } do
			local ancestor: Instance? = start
			while ancestor do
				if not watched[ancestor] then
					watched[ancestor] = true
					scope:Give(ancestor:GetAttributeChangedSignal(&quot;FF_Disabled&quot;):Connect(update))
					if ancestor:IsA(&quot;GuiObject&quot;) then scope:Give(ancestor:GetPropertyChangedSignal(&quot;Visible&quot;):Connect(update)) end
					if ancestor:IsA(&quot;LayerCollector&quot;) then scope:Give(ancestor:GetPropertyChangedSignal(&quot;Enabled&quot;):Connect(update)) end
				end
				if ancestor == controller.Root then break end
				ancestor = ancestor.Parent
			end
		end
		scope:Give(function() for _, behavior in effects do controller.Animations:SetHover(object, behavior, false) end end)
		update()
	end
	return scope
end

return HoverSources

end
loaders[&quot;Runtime&quot;] = function(require, script)
--!strict
-- FrameForge client controller. One bootstrap and controller own the entire GUI.
local HttpService = game:GetService(&quot;HttpService&quot;)
local RunService = game:GetService(&quot;RunService&quot;)
local UserInputService = game:GetService(&quot;UserInputService&quot;)
local GuiService = game:GetService(&quot;GuiService&quot;)
local Cleanup = require(script.Parent.Cleanup)
local Animations = require(script.Parent.Animations)
local Bindings = require(script.Parent.Bindings)
local Sizing = require(script.Parent.Sizing)
local HoverSources = require(script.Parent.HoverSources)

local Runtime = {}
local Controller = {}
Controller.__index = Controller
local registry: { [Instance]: any } = setmetatable({}, { __mode = &quot;k&quot; }) :: any

local function decode(object: GuiObject): { any }
	local raw = object:GetAttribute(&quot;FF_Behaviors&quot;)
	if type(raw) ~= &quot;string&quot; or raw == &quot;&quot; then return {} end
	local ok, value = pcall(HttpService.JSONDecode, HttpService, raw)
	if not ok or type(value) ~= &quot;table&quot; or #value &gt; 100 then
		warn(&quot;[FrameForge] Invalid behavior metadata on &quot; .. object.Name)
		return {}
	end
	local result = {}
	for _, behavior in value do
		if type(behavior) == &quot;table&quot; and type(behavior.type) == &quot;string&quot; then table.insert(result, behavior) end
	end
	return result
end

local function isVisible(object: GuiObject, root: Instance): boolean
	local current: Instance? = object
	while current do
		if current:IsA(&quot;GuiObject&quot;) and not current.Visible then return false end
		if current:IsA(&quot;LayerCollector&quot;) and not current.Enabled then return false end
		if current == root then return root.Parent ~= nil end
		current = current.Parent
	end
	return false
end

local function transient(object: Instance): boolean
	local current: Instance? = object
	while current do
		if current:GetAttribute(&quot;FF_Transient&quot;) then return true end
		if current.Name == &quot;FF_Input&quot; and current:GetAttribute(&quot;FF_Decoration&quot;) == true then return true end
		current = current.Parent
	end
	return false
end

local function inputIsPress(input: InputObject): boolean
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
		or input.KeyCode == Enum.KeyCode.ButtonA
		or input.KeyCode == Enum.KeyCode.Return
		or input.KeyCode == Enum.KeyCode.Space
end

local function enclosingPanel(object: GuiObject, root: Instance): GuiObject?
	local current = object.Parent
	while current do
		if current:IsA(&quot;GuiObject&quot;) and (current:GetAttribute(&quot;FF_Element&quot;) == &quot;panel&quot; or current:GetAttribute(&quot;FF_PanelId&quot;) ~= nil) then return current end
		if current == root then break end
		current = current.Parent
	end
	return nil
end

local function containsPoint(object: GuiObject, point: Vector2): boolean
	local size = object.AbsoluteSize
	local relative = point - (object.AbsolutePosition + size / 2)
	local angle = math.rad(-object.AbsoluteRotation)
	local x = relative.X * math.cos(angle) - relative.Y * math.sin(angle)
	local y = relative.X * math.sin(angle) + relative.Y * math.cos(angle)
	return math.abs(x) &lt;= size.X / 2 and math.abs(y) &lt;= size.Y / 2
end

function Controller.Find(self: any, target: any): GuiObject?
	if typeof(target) == &quot;Instance&quot; then
		if target:IsA(&quot;GuiObject&quot;) and (target == self.Root or target:IsDescendantOf(self.Root)) then return target end
		return nil
	end
	if type(target) ~= &quot;string&quot; or target == &quot;&quot; then return nil end
	local exact = self._ids[target] or self._panels[target]
	if exact then return exact end
	local names = self._names[target]
	if names and #names == 1 then return names[1] end
	if names and #names &gt; 1 then warn(&quot;[FrameForge] Ambiguous target name '&quot; .. target .. &quot;'; use a node ID or panel ID.&quot;) end
	return nil
end

function Controller._resetSubtree(self: any, object: Instance, interaction: boolean)
	for child, record in self._nodes do
		if child == object or child:IsDescendantOf(object) then
			self.Animations:Reset(child)
			if interaction then
				self.Animations:ResetHover(child)
				record.hovered = false; record.pressed = false; record.input = nil
				self.Animations:Interact(child, false, false, child:GetAttribute(&quot;FF_Disabled&quot;) == true)
			end
		end
	end
end

function Controller._panel(self: any, target: any, open: boolean, replay: boolean?): boolean
	if self._destroyed then return false end
	local object = self:Find(target)
	if not object then warn(&quot;[FrameForge] Panel target not found: &quot; .. tostring(target)); return false end
	object.Visible = open
	object:SetAttribute(&quot;FF_Open&quot;, open)
	if open and replay ~= false then
		self:Play(object)
	else
		self:_resetSubtree(object, not open)
	end
	self._panelEvent:Fire(object, open)
	return true
end

function Controller.Open(self: any, target: any, replay: boolean?): boolean
	return self:_panel(target, true, replay)
end

function Controller.Close(self: any, target: any): boolean
	return self:_panel(target, false, false)
end

function Controller.Toggle(self: any, target: any): boolean
	local object = self:Find(target)
	return if object then self:_panel(object, not object.Visible, true) else false
end

function Controller.Play(self: any, target: any, effect: any?): boolean
	local object = self:Find(target)
	if not object or self._destroyed then return false end
	if effect == nil then
		-- Hidden panels can contain their own entrance-configured descendants.
		for _, descendant in object:GetDescendants() do
			if descendant:IsA(&quot;GuiObject&quot;) and self._nodes[descendant] and isVisible(descendant, self.Root) then self.Animations:Play(descendant) end
		end
	end
	self.Animations:Play(object, effect)
	return true
end

Controller.PlayEntrance = Controller.Play

function Controller.GetSelected(self: any, group: string): string?
	return self._selected[group]
end

function Controller.SetSelected(self: any, group: string, value: string?): boolean
	if self._destroyed then return false end
	local members = self._groups[group]
	if not members then return false end
	local selected = nil
	if value ~= nil then
		for _, member in members do
			if member.value == value or member.object:GetAttribute(&quot;FF_ID&quot;) == value then selected = member; break end
		end
		if not selected then return false end
	end
	local oldValue = self._selected[group]
	self._selected[group] = if selected then selected.value else nil
	local chosenTarget = if selected and selected.kind == &quot;tab&quot; then self:Find(selected.target) else nil
	local panels = {}
	for _, member in members do
		local active = member == selected
		member.object:SetAttribute(&quot;FF_Selected&quot;, active)
		if member.kind == &quot;tab&quot; and member.target then
			local panel = self:Find(member.target)
			if panel then panels[panel] = true end
		end
	end
	for panel in panels do
		local open = panel == chosenTarget
		-- A shared panel is updated once; reselecting an active tab does not replay
		-- its entrances or emit duplicate panel events.
		if panel.Visible ~= open then self:_panel(panel, open, open) end
	end
	if oldValue ~= self._selected[group] then self._selectionEvent:Fire(group, self._selected[group], if selected then selected.object else nil) end
	return true
end

function Controller.SetDisabled(self: any, target: any, disabled: boolean): boolean
	local object = self:Find(target)
	if not object or self._destroyed then return false end
	object:SetAttribute(&quot;FF_Disabled&quot;, disabled)
	local record = self._nodes[object]
	-- Attribute signals may be deferred. The public API must disable input now.
	if record and record.disabledChanged then record.disabledChanged() end
	return true
end

function Controller.RegisterAction(self: any, name: string, callback: (any) -&gt; ()): () -&gt; ()
	assert(type(name) == &quot;string&quot; and name ~= &quot;&quot;, &quot;Action name must be a nonempty string&quot;)
	assert(type(callback) == &quot;function&quot;, &quot;Action handler must be a function&quot;)
	assert(not self._destroyed, &quot;Controller has been destroyed&quot;)
	self._actions[name] = callback
	return function() if self._actions[name] == callback then self._actions[name] = nil end end
end

function Controller._action(self: any, object: GuiObject, behavior: any, input: InputObject?, text: string?)
	local name = behavior.action or behavior.value
	if type(name) ~= &quot;string&quot; or name == &quot;&quot; then return end
	local context = { Controller = self, Node = object, Action = name, Behavior = behavior, Input = input, Text = text }
	object:SetAttribute(&quot;FF_LastAction&quot;, name)
	self._actionEvent:Fire(context)
	local callback = self._actions[name]
	if callback then
		local ok, message = pcall(callback, context)
		if not ok then warn(&quot;[FrameForge] Action '&quot; .. name .. &quot;': &quot; .. tostring(message)) end
	elseif not self._missingActions[name] then
		self._missingActions[name] = true
		warn(&quot;[FrameForge] RegisterAction('&quot; .. name .. &quot;', handler) to handle this custom action.&quot;)
	end
end

-- Also useful for game-owned keyboard shortcuts and deterministic integration tests.
function Controller.Activate(self: any, target: any, input: InputObject?): boolean
	local object = self:Find(target)
	if not object or self._destroyed or object:GetAttribute(&quot;FF_Disabled&quot;) == true or not isVisible(object, self.Root) then return false end
	local record = self._nodes[object]
	if not record then return false end
	for _, behavior in record.behaviors do
		local kind = behavior.type
		if kind == &quot;openPanel&quot; then self:Open(behavior.target)
		elseif kind == &quot;closePanel&quot; then
			local closeTarget = if type(behavior.target) == &quot;string&quot; and behavior.target ~= &quot;&quot; then behavior.target else enclosingPanel(object, self.Root)
			if closeTarget then self:Close(closeTarget) end
		elseif kind == &quot;togglePanel&quot; then self:Toggle(behavior.target)
		elseif kind == &quot;tab&quot; or kind == &quot;select&quot; then
			self:SetSelected(behavior.group or (if kind == &quot;tab&quot; then &quot;Tabs&quot; else &quot;Selection&quot;), behavior.value or object:GetAttribute(&quot;FF_ID&quot;) or object.Name)
		elseif kind == &quot;customAction&quot; then self:_action(object, behavior, input)
		elseif kind == &quot;ripple&quot; then self.Animations:Ripple(object, behavior, input)
		end
	end
	return true
end

function Controller._register(self: any, object: GuiObject)
	if self._destroyed or self._nodes[object] or transient(object) then return end
	local behaviors = decode(object)
	local scope = Cleanup.new()
	local record: any = { scope = scope, behaviors = behaviors, hovered = false, pressed = false, input = nil }
	self._nodes[object] = record
	if object:GetAttribute(&quot;FF_DesignSizeMode&quot;) == &quot;hybrid&quot; then scope:Give(Sizing.Attach(object)) end
	local id = object:GetAttribute(&quot;FF_ID&quot;)
	if type(id) == &quot;string&quot; then
		if self._ids[id] then warn(&quot;[FrameForge] Duplicate node ID: &quot; .. id) else self._ids[id] = object end
	end
	local panelId = object:GetAttribute(&quot;FF_PanelId&quot;)
	if type(panelId) == &quot;string&quot; and panelId ~= &quot;&quot; then
		if self._panels[panelId] then warn(&quot;[FrameForge] Duplicate panel ID: &quot; .. panelId) else self._panels[panelId] = object end
	end
	self._names[object.Name] = self._names[object.Name] or {}
	table.insert(self._names[object.Name], object)
	if object:GetAttribute(&quot;FF_InitiallyHidden&quot;) == true then object.Visible = false end
	if object:GetAttribute(&quot;FF_Element&quot;) == &quot;panel&quot; or panelId then object:SetAttribute(&quot;FF_Open&quot;, object.Visible) end
	self.Animations:Register(object, behaviors)
	for _, behavior in behaviors do
		if behavior.type == &quot;binding&quot; then scope:Give(self.Bindings:Attach(object, behavior)) end
		if behavior.type == &quot;tab&quot; or behavior.type == &quot;select&quot; then
			local group = behavior.group or (if behavior.type == &quot;tab&quot; then &quot;Tabs&quot; else &quot;Selection&quot;)
			self._groups[group] = self._groups[group] or {}
			table.insert(self._groups[group], { object = object, kind = behavior.type, value = behavior.value or id or object.Name, target = behavior.target })
		end
	end
	local function updateInteraction()
		self.Animations:Interact(object, record.hovered, record.pressed, object:GetAttribute(&quot;FF_Disabled&quot;) == true)
	end
	-- Masked buttons retain a CanvasGroup visual owner and use the importer's
	-- transparent native button for input. The proxy never becomes a second node.
	local inputButton: GuiButton? = if object:IsA(&quot;GuiButton&quot;) then object else nil
	if not inputButton then
		local proxy = object:FindFirstChild(&quot;FF_Input&quot;)
		if proxy and proxy:IsA(&quot;GuiButton&quot;) and proxy:GetAttribute(&quot;FF_Decoration&quot;) == true then inputButton = proxy end
	end
	record.inputButton = inputButton
	local feedbackObject = inputButton or object
	local function connectFeedback()
		scope:Give(feedbackObject.MouseEnter:Connect(function() record.hovered = true; updateInteraction() end))
		scope:Give(feedbackObject.MouseLeave:Connect(function() record.hovered = false; updateInteraction() end))
		scope:Give(feedbackObject.SelectionGained:Connect(function() record.hovered = true; updateInteraction() end))
		scope:Give(feedbackObject.SelectionLost:Connect(function() record.hovered = false; record.pressed = false; record.input = nil; updateInteraction() end))
		scope:Give(feedbackObject.InputBegan:Connect(function(input)
			if inputIsPress(input) and object:GetAttribute(&quot;FF_Disabled&quot;) ~= true then
				record.input = input; record.pressed = true; updateInteraction()
			end
		end))
		scope:Give(object:GetPropertyChangedSignal(&quot;Visible&quot;):Connect(function()
			if not object.Visible then record.hovered = false; record.pressed = false; record.input = nil; updateInteraction() end
		end))
	end
	if inputButton then
		local original = { Interactable = inputButton.Interactable, Selectable = inputButton.Selectable, Active = inputButton.Active, AutoButtonColor = inputButton.AutoButtonColor }
		local initialDisabled = object:GetAttribute(&quot;FF_Disabled&quot;) == true
		local enabled = if initialDisabled then { Interactable = true, Selectable = true, Active = true } else original
		for _, behavior in behaviors do
			if behavior.type == &quot;smooth&quot; or behavior.type == &quot;color&quot; then inputButton.AutoButtonColor = false; break end
		end
		local function disabledChanged()
			local disabled = object:GetAttribute(&quot;FF_Disabled&quot;) == true
			inputButton.Interactable = if disabled then false else enabled.Interactable
			inputButton.Selectable = if disabled then false else enabled.Selectable
			inputButton.Active = if disabled then false else enabled.Active
			if disabled then record.hovered = false; record.pressed = false; record.input = nil end
			updateInteraction()
		end
		record.disabledChanged = disabledChanged
		scope:Give(object:GetAttributeChangedSignal(&quot;FF_Disabled&quot;):Connect(disabledChanged))
		scope:Give(inputButton.Activated:Connect(function(input) self:Activate(object, input) end))
		connectFeedback()
		scope:Give(function()
			if inputButton.Parent then for property, value in original do (inputButton :: any)[property] = value end end
		end)
		disabledChanged()
	elseif object:IsA(&quot;ScrollingFrame&quot;) then
		local originalScrolling = object.ScrollingEnabled
		local enabledScrolling = originalScrolling or object:GetAttribute(&quot;FF_Disabled&quot;) == true
		local function disabledChanged() object.ScrollingEnabled = enabledScrolling and object:GetAttribute(&quot;FF_Disabled&quot;) ~= true end
		record.disabledChanged = disabledChanged
		scope:Give(object:GetAttributeChangedSignal(&quot;FF_Disabled&quot;):Connect(disabledChanged))
		scope:Give(function() if object.Parent then object.ScrollingEnabled = originalScrolling end end)
		disabledChanged()
	elseif object:IsA(&quot;TextBox&quot;) then
		local originalEditable = object.TextEditable
		local enabledEditable = originalEditable or object:GetAttribute(&quot;FF_Disabled&quot;) == true
		local function disabledChanged() object.TextEditable = enabledEditable and object:GetAttribute(&quot;FF_Disabled&quot;) ~= true end
		record.disabledChanged = disabledChanged
		scope:Give(object:GetAttributeChangedSignal(&quot;FF_Disabled&quot;):Connect(disabledChanged))
		scope:Give(object:GetPropertyChangedSignal(&quot;Text&quot;):Connect(function() self._textEvent:Fire(object, object.Text) end))
		scope:Give(object.FocusLost:Connect(function(enterPressed, input)
			if not enterPressed or object:GetAttribute(&quot;FF_Disabled&quot;) == true then return end
			for _, behavior in behaviors do if behavior.type == &quot;customAction&quot; then self:_action(object, behavior, input, object.Text) end end
		end))
		scope:Give(function() if object.Parent then object.TextEditable = originalEditable end end)
		disabledChanged()
	end
	if not inputButton then
		for _, behavior in behaviors do
			if behavior.type == &quot;smooth&quot; or behavior.type == &quot;hoverScale&quot; or behavior.type == &quot;pressScale&quot; or behavior.type == &quot;color&quot; or behavior.type == &quot;hoverMove&quot; or behavior.type == &quot;hoverTilt&quot; or behavior.trigger == &quot;hover&quot; then
				connectFeedback()
				scope:Give(object:GetAttributeChangedSignal(&quot;FF_Disabled&quot;):Connect(function()
					if object:GetAttribute(&quot;FF_Disabled&quot;) == true then record.hovered = false; record.pressed = false; record.input = nil end
					updateInteraction()
				end))
				break
			end
		end
	end
	scope:Give(object:GetPropertyChangedSignal(&quot;Visible&quot;):Connect(function()
		if object:GetAttribute(&quot;FF_Element&quot;) == &quot;panel&quot; or panelId then object:SetAttribute(&quot;FF_Open&quot;, object.Visible) end
		if not object.Visible then self:_resetSubtree(object, true) end
	end))
end

function Controller._refreshHoverSources(self: any)
	for object, record in self._nodes do
		if record.hoverSources then record.scope:Remove(record.hoverSources); record.hoverSources:Destroy() end
		record.hoverSources = HoverSources.Bind(self, object, record.behaviors)
		record.scope:Give(record.hoverSources)
	end
end

function Controller._remove(self: any, object: GuiObject)
	local record = self._nodes[object]
	if not record then return end
	record.scope:Destroy()
	self.Animations:Remove(object)
	self._nodes[object] = nil
	for id, value in self._ids do if value == object then self._ids[id] = nil end end
	for id, value in self._panels do if value == object then self._panels[id] = nil end end
	for name, objects in self._names do
		local index = table.find(objects, object)
		if index then table.remove(objects, index); if #objects == 0 then self._names[name] = nil end end
	end
	for group, members in self._groups do
		for index = #members, 1, -1 do
			if members[index].object == object then
				local wasSelected = self._selected[group] == members[index].value
				table.remove(members, index)
				if wasSelected then self._selected[group] = nil; self._selectionEvent:Fire(group, nil, nil) end
			end
		end
	end
end

function Controller._initializeGroups(self: any)
	for group, members in self._groups do
		local chosen = nil
		for _, member in members do
			if member.object:GetAttribute(&quot;FF_Selected&quot;) == true then chosen = member; break end
			if member.kind == &quot;tab&quot; and not chosen then chosen = member end
		end
		if chosen then self:SetSelected(group, chosen.value) end
	end
end

function Controller.Destroy(self: any)
	if self._destroyed then return end
	self._destroyed = true
	registry[self.Root] = nil
	self._scope:Destroy()
	local objects = {}
	for object in self._nodes do table.insert(objects, object) end
	for _, object in objects do self:_remove(object) end
	self.Animations:Destroy(); self.Bindings:Destroy()
	for _, event in { self._panelEvent, self._selectionEvent, self._actionEvent, self._textEvent } do event:Destroy() end
	table.clear(self._actions)
end

function Runtime.Get(root: Instance): any
	return registry[root]
end

function Runtime.mount(root: Instance, options: any?): any
	assert(RunService:IsClient(), &quot;FrameForge runtime must mount on the client&quot;)
	assert(root:IsA(&quot;GuiObject&quot;) or root:IsA(&quot;LayerCollector&quot;), &quot;Root must be a GuiObject or LayerCollector&quot;)
	if registry[root] then return registry[root] end
	local scope = Cleanup.new()
	local panelEvent = Instance.new(&quot;BindableEvent&quot;)
	local selectionEvent = Instance.new(&quot;BindableEvent&quot;)
	local actionEvent = Instance.new(&quot;BindableEvent&quot;)
	local textEvent = Instance.new(&quot;BindableEvent&quot;)
	local self: any = setmetatable({
		Root = root, Bindings = Bindings.new(if options then options.player else nil), Animations = Animations.new(root),
		PanelChanged = panelEvent.Event, SelectionChanged = selectionEvent.Event, Action = actionEvent.Event, TextChanged = textEvent.Event,
		_panelEvent = panelEvent, _selectionEvent = selectionEvent, _actionEvent = actionEvent, _textEvent = textEvent,
		_scope = scope, _nodes = {}, _ids = {}, _panels = {}, _names = {}, _groups = {}, _selected = {},
		_actions = {}, _missingActions = {}, _destroyed = false,
	}, Controller)
	registry[root] = self
	if root:IsA(&quot;GuiObject&quot;) then self:_register(root) end
	for _, descendant in root:GetDescendants() do if descendant:IsA(&quot;GuiObject&quot;) then self:_register(descendant) end end
	self:_initializeGroups()
	self:_refreshHoverSources()
	for object in self._nodes do if isVisible(object, root) then self.Animations:Play(object) end end
	scope:Give(root.DescendantAdded:Connect(function(descendant)
		if descendant:IsA(&quot;GuiObject&quot;) and not transient(descendant) then
			scope:Delay(0, function()
				if descendant:IsDescendantOf(root) then
					self:_register(descendant); self:_initializeGroups()
					if not self._hoverSourcesQueued then
						self._hoverSourcesQueued = true
						self._scope:Delay(0, function() self._hoverSourcesQueued = false; self:_refreshHoverSources() end)
					end
					if isVisible(descendant, root) then self.Animations:Play(descendant) end
				end
			end)
		end
	end))
	scope:Give(root.DescendantRemoving:Connect(function(descendant)
		if descendant:IsA(&quot;GuiObject&quot;) then self:_remove(descendant) end
	end))
	scope:Give(root.Destroying:Connect(function() self:Destroy() end))
	scope:Give(root.AncestryChanged:Connect(function()
		if not root:IsDescendantOf(game) then self:Destroy() end
	end))
	if root:IsA(&quot;LayerCollector&quot;) then
		scope:Give(root:GetPropertyChangedSignal(&quot;Enabled&quot;):Connect(function()
			if not root.Enabled then self:_resetSubtree(root, true) end
		end))
	end
	-- A single release listener per controller handles pointer releases outside buttons.
	scope:Give(UserInputService.InputEnded:Connect(function(input)
		if not inputIsPress(input) then return end
		for object, record in self._nodes do
			local pressedInput = record.input
			local samePointer = pressedInput and input.UserInputType == Enum.UserInputType.MouseButton1 and pressedInput.UserInputType == input.UserInputType
			local sameKey = pressedInput and input.KeyCode ~= Enum.KeyCode.Unknown and pressedInput.KeyCode == input.KeyCode and pressedInput.UserInputType == input.UserInputType
			if record.pressed and (pressedInput == input or samePointer or sameKey) then
				record.pressed = false; record.input = nil
				self.Animations:Interact(object, record.hovered, false, object:GetAttribute(&quot;FF_Disabled&quot;) == true)
			end
		end
	end))
	scope:Give(UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB then
			if UserInputService:GetFocusedTextBox() then return end
			for object in self._nodes do
				if object:GetAttribute(&quot;FF_CloseOnOutside&quot;) == true and isVisible(object, root) then self:Close(object) end
			end
			return
		end
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
		-- Outside-screen geometry is reliable for ScreenGui. World GUI pointer mapping is engine-owned.
		local collector = if root:IsA(&quot;LayerCollector&quot;) then root else root:FindFirstAncestorWhichIsA(&quot;LayerCollector&quot;)
		if not collector or not collector:IsA(&quot;ScreenGui&quot;) then return end
		local point = Vector2.new(input.Position.X, input.Position.Y)
		if not collector.IgnoreGuiInset then local inset = GuiService:GetGuiInset(); point -= inset end
		for object in self._nodes do
			if object:GetAttribute(&quot;FF_CloseOnOutside&quot;) == true and isVisible(object, root) then
				local relatedTrigger = false
				-- The panel's opener/toggler must retain its normal activation behavior.
				for candidate, record in self._nodes do
					if record.inputButton and isVisible(candidate, root) and containsPoint(candidate, point) then
						for _, behavior in record.behaviors do
							if (behavior.type == &quot;openPanel&quot; or behavior.type == &quot;togglePanel&quot; or behavior.type == &quot;tab&quot;) and self:Find(behavior.target) == object then relatedTrigger = true; break end
						end
					end
					if relatedTrigger then break end
				end
				if not relatedTrigger and not containsPoint(object, point) then self:Close(object) end
			end
		end
	end))
	return self
end

Runtime.Mount = Runtime.mount
return Runtime

end
loaders[&quot;Sizing&quot;] = function(require, script)
--!strict
-- Authored hybrid designs keep their pixel geometry and shrink uniformly only
-- when their containing viewport is smaller. No per-frame polling is needed.
local Cleanup = require(script.Parent.Cleanup)
local EffectMath = require(script.Parent.EffectMath)
local Sizing = {}

function Sizing.Attach(object: GuiObject): any
	local scope = Cleanup.new()
	if object:GetAttribute(&quot;FF_DesignSizeMode&quot;) ~= &quot;hybrid&quot; then return scope end
	local scale = object:FindFirstChild(&quot;FF_DesignScale&quot;)
	if not scale or not scale:IsA(&quot;UIScale&quot;) then return scope end
	local original = scale.Scale
	local parentScope = Cleanup.new()
	local function update()
		local parent = object.Parent
		if not parent or not parent:IsA(&quot;GuiBase2d&quot;) or not scale.Parent then return end
		local width = EffectMath.Number(object:GetAttribute(&quot;FF_DesignWidth&quot;), 0, 0)
		local height = EffectMath.Number(object:GetAttribute(&quot;FF_DesignHeight&quot;), 0, 0)
		local available = parent.AbsoluteSize
		if width &lt;= 0 or height &lt;= 0 or available.X &lt;= 0 or available.Y &lt;= 0 then return end
		local value = EffectMath.FitScale(width, height, available.X, available.Y)
		if math.abs(scale.Scale - value) &gt; 1e-6 then scale.Scale = value end
	end
	local function bindParent()
		parentScope:Destroy()
		parentScope = Cleanup.new()
		local parent = object.Parent
		if parent and parent:IsA(&quot;GuiBase2d&quot;) then
			parentScope:Give(parent:GetPropertyChangedSignal(&quot;AbsoluteSize&quot;):Connect(update))
		end
		update()
	end
	scope:Give(function()
		parentScope:Destroy()
		if scale.Parent then scale.Scale = original end
	end)
	scope:Give(object.AncestryChanged:Connect(bindParent))
	for _, attribute in { &quot;FF_DesignWidth&quot;, &quot;FF_DesignHeight&quot; } do
		scope:Give(object:GetAttributeChangedSignal(attribute):Connect(update))
	end
	bindParent()
	return scope
end

return Sizing

end
for name in loaders do tokens[name] = { Name = name, Parent = tokens } end
local function loadModule(token)
 local name=token.Name
 if cache[name] ~= nil then return cache[name] end
 assert(not loading[name], 'Circular FrameForge runtime dependency: '..name)
 loading[name]=true
 local value=loaders[name](loadModule, token)
 cache[name]=value; loading[name]=nil
 return value
end
local Runtime=loadModule(tokens.Runtime)
local controller=Runtime.mount(script.Parent)
-- BindableFunction copies tables without metatables. Return explicit bound
-- methods so callers retain the public API and the live controller's state.
local public={Root=controller.Root,Bindings={}}
for _,name in {'Find','Open','Close','Toggle','Play','PlayEntrance','GetSelected','SetSelected','SetDisabled','RegisterAction','Activate','Destroy'} do
 public[name]=function(_,...) return controller[name](controller,...) end
end
for _,name in {'Set','Get'} do
 public.Bindings[name]=function(_,...) return controller.Bindings[name](controller.Bindings,...) end
end
for _,name in {'PanelChanged','SelectionChanged','Action','TextChanged'} do public[name]=controller[name] end
local api=Instance.new('BindableFunction')
api.Name='Controller'
api.OnInvoke=function() return public end
api.Parent=script
script.Destroying:Once(function() api.OnInvoke=nil; controller:Destroy() end)
