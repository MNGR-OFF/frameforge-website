function Animations.SetHover(self: any, object: GuiObject, behavior: any, active: boolean)
	local entry = self._entries[object]
	if not entry then return end
	active = active and visible(object, self.Root) and object:GetAttribute(&quot;FF_Disabled&quot;) ~= true
	if entry.hoverStates[behavior] == active then return end
	entry.hoverStates[behavior] = active
