return &quot;0.1.7&quot;
</ProtectedString></Properties></Item></Item><Item class="Folder" referent="FF15"><Properties><string name="Name">Importer</string></Properties><Item class="ModuleScript" referent="FF12"><Properties><string name="Name">Import</string><ProtectedString name="Source">--!strict
local ChangeHistoryService = game:GetService(&quot;ChangeHistoryService&quot;)
local Selection = game:GetService(&quot;Selection&quot;)
local StarterGui = game:GetService(&quot;StarterGui&quot;)
local RunService = game:GetService(&quot;RunService&quot;)
local Validate = require(script.Parent.Validate)
local Convert = require(script.Parent.Parent.Converter.Convert)
local Geometry = require(script.Parent.Parent.Converter.Geometry)

local Import = {}

export type Options = {
	json: string,
	sizing: string?,
	target: string?,
	mappings: {[string]: string},
	runtime: boolean,
	world: any?,
}

function Import.parseMappings(text: string): ({[string]: string}?, string?)
	local result: {[string]: string} = {}
	if #text &gt; 65536 then return nil, &quot;Asset mapping list exceeds 64 KB.&quot; end
	local index = 0
	for line in string.gmatch(text .. &quot;\n&quot;, &quot;([^\n]*)\n&quot;) do
		index += 1
		line = string.gsub(line, &quot;\r&quot;, &quot;&quot;)
		if string.match(line, &quot;%S&quot;) and not string.match(line, &quot;^%s*#&quot;) then
			local key, value = string.match(line, &quot;^%s*(.-)%s*=%s*(.-)%s*$&quot;)
			local asset = Convert.assetId(value)
			if not key or key == &quot;&quot; or #key &gt; 512 or not asset then
				return nil, &quot;Mapping line &quot; .. index .. &quot;: use asset-key = 123456789 (or rbxassetid://123456789).&quot;
			end
			if result[key] and result[key] ~= asset then return nil, &quot;Mapping line &quot; .. index .. &quot;: duplicate key '&quot; .. key .. &quot;'.&quot; end
			result[key] = asset
		end
	end
	return result, nil
end

function Import.inspect(options: Options): (any?, string?)
	local validated, validationError = Validate.decode(options.json)
	if not validated then return nil, validationError end
	local document = validated.document.document
	local assets = {}
	for _, asset in ipairs(document.assets) do assets[asset.id] = asset end
	local missing, byKey = {}, {}
	local ids, targets = {}, {}
	local behaviorCount = 0
	local function visit(node: any)
		behaviorCount += #node.metadata.behaviors
		ids[node.id], ids[node.name] = true, true
		if node.metadata.panelId then ids[node.metadata.panelId] = true end
		for _, behavior in ipairs(node.metadata.behaviors) do
			if behavior.target then table.insert(targets, { node = node, target = behavior.target }) end
		end
		local reference = node.appearance.asset
		if reference or node.metadata.assetId or node.type == &quot;IMAGE&quot; or node.type == &quot;VECTOR&quot; or node.strategy == &quot;baked&quot; then
			local asset = if reference then assets[reference] else nil
			local mapped = options.mappings[reference or node.id] or options.mappings[node.id]
			local resolved = Convert.assetId(mapped) or Convert.assetId(node.metadata.assetId) or Convert.assetId(if asset then asset.robloxId else reference)
			if not resolved then
				local key = reference or node.id
				if not byKey[key] then
					byKey[key] = { id = key, name = if asset then asset.name else node.name, uses = 0 }
					table.insert(missing, byKey[key])
				end
				byKey[key].uses += 1
			end
		end
		for _, child in ipairs(node.children) do visit(child) end
	end
	for _, root in ipairs(document.roots) do visit(root) end
	local warnings = table.clone(document.warnings)
	for _, reference in ipairs(targets) do
		if not ids[reference.target] then
			table.insert(warnings, { nodeId = reference.node.id, code = &quot;TARGET_MISSING&quot;, message = &quot;Behavior target '&quot; .. reference.target .. &quot;' is absent from this export.&quot; })
		end
	end
	return { document = document, nodeCount = validated.nodeCount, behaviorCount = behaviorCount, missingAssets = missing, warnings = warnings }, nil
end

local function uniqueName(name: string): string
	local clean = string.gsub(name, &quot;%c&quot;, &quot;&quot;)
	clean = string.match(clean, &quot;^%s*(.-)%s*$&quot;) or clean
	if clean == &quot;&quot; then clean = &quot;FrameForgeInterface&quot; end
	local candidate = clean
	local index = 2
	while StarterGui:FindFirstChild(candidate) do
		candidate = clean .. &quot; &quot; .. index
		index += 1
	end
	return candidate
end

local function numberOption(value: any, fallback: number, minimum: number, maximum: number): number
	if value == nil then return math.clamp(fallback, minimum, maximum) end
	if type(value) ~= &quot;number&quot; or value ~= value or value &lt; minimum or value &gt; maximum then
		error(&quot;World UI settings contain an invalid number (allowed &quot; .. minimum .. &quot; to &quot; .. maximum .. &quot;).&quot;, 0)
	end
	return value
end

local function createTarget(name: string, target: string, document: any, world: any, stagingRoot: Instance): Instance
	if target == &quot;ScreenGui&quot; then
		local screen = Instance.new(&quot;ScreenGui&quot;)
		screen.Parent = stagingRoot
		screen.Name = name
		screen.ResetOnSpawn = false
		screen.IgnoreGuiInset = true
		screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		return screen
	end
	-- Keep world GUIs in StarterGui so the runtime reaches PlayerGui and activation works.
	local part = nil
	for _, selected in ipairs(Selection:Get()) do
		if selected:IsA(&quot;BasePart&quot;) and selected:IsDescendantOf(workspace) then part = selected; break end
	end
	if not part then error(&quot;Select a BasePart in Workspace before importing a world UI.&quot;, 0) end
	local settings = world or {}
	local bounds = Geometry.designBounds(document.roots)
	local gui: any
	if target == &quot;BillboardGui&quot; then
		gui = Instance.new(&quot;BillboardGui&quot;)
		gui.Parent = stagingRoot
		gui.Size = UDim2.fromScale(numberOption(settings.width, 6, 0.1, 1000), numberOption(settings.height, 6 * bounds.height / bounds.width, 0.1, 1000))
		gui.StudsOffset = Vector3.new(numberOption(settings.offsetX, 0, -1000, 1000), numberOption(settings.offsetY, 3, -1000, 1000), numberOption(settings.offsetZ, 0, -1000, 1000))
		gui.MaxDistance = numberOption(settings.maxDistance, 100, 0, 100000)
	else
		gui = Instance.new(&quot;SurfaceGui&quot;)
		gui.Parent = stagingRoot
		local face = settings.face or &quot;Front&quot;
		if not table.find({ &quot;Front&quot;, &quot;Back&quot;, &quot;Left&quot;, &quot;Right&quot;, &quot;Top&quot;, &quot;Bottom&quot; }, face) then
			gui:Destroy()
			error(&quot;Surface face must be Front, Back, Left, Right, Top or Bottom.&quot;, 0)
		end
		gui.Face = Enum.NormalId[face]
		gui.CanvasSize = Vector2.new(bounds.width, bounds.height)
		gui.SizingMode = if settings.pixelsPerStud then Enum.SurfaceGuiSizingMode.PixelsPerStud else Enum.SurfaceGuiSizingMode.FixedSize
		gui.PixelsPerStud = numberOption(settings.pixelsPerStud, 50, 1, 1000)
		gui.Active = true
	end
	gui.Name = name
	gui.Adornee = part
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.AlwaysOnTop = settings.alwaysOnTop == true
	gui.LightInfluence = numberOption(settings.lightInfluence, 0, 0, 1)
	gui.Active = true
	return gui
end

function Import.recoverRecording(pluginObject: Plugin)
	local recording = pluginObject:GetAttribute(&quot;FF_ActiveRecording&quot;)
	if type(recording) == &quot;string&quot; then
		pcall(function() ChangeHistoryService:FinishRecording(recording, Enum.FinishRecordingOperation.Cancel) end)
		pluginObject:SetAttribute(&quot;FF_ActiveRecording&quot;, nil)
	end
end

function Import.run(pluginObject: Plugin, packageRoot: Instance, options: Options): (any?, string?)
	if RunService:IsRunning() then return nil, &quot;Stop Play mode before importing into StarterGui.&quot; end
	local inspection, validationError = Import.inspect(options)
	if not inspection then return nil, validationError end
	local document = inspection.document
	local sizing = options.sizing or document.settings.sizing
	local target = options.target or document.settings.target
	if not table.find({ &quot;pixels&quot;, &quot;responsive&quot;, &quot;hybrid&quot; }, sizing) then return nil, &quot;Unknown sizing strategy.&quot; end
	if not table.find({ &quot;ScreenGui&quot;, &quot;BillboardGui&quot;, &quot;SurfaceGui&quot; }, target) then return nil, &quot;Unknown GUI target.&quot; end
	local staged: Instance? = nil
	local stagingRoot = Instance.new(&quot;Folder&quot;)
	stagingRoot.Name = &quot;FrameForge_Staging&quot;
	local report: any = nil
	local success, stageError = pcall(function()
		local stagedGui = createTarget(uniqueName(document.name), target, document, options.world, stagingRoot)
		staged = stagedGui
		stagedGui:SetAttribute(&quot;FF_Format&quot;, &quot;FrameForge&quot;)
		stagedGui:SetAttribute(&quot;FF_Version&quot;, 1)
		stagedGui:SetAttribute(&quot;FF_Sizing&quot;, sizing)
		report = Convert.build(document, stagedGui, sizing, options.mappings)
		if options.runtime and inspection.behaviorCount &gt; 0 then
			local generated = packageRoot:FindFirstChild(&quot;Generated&quot;)
			local source = if generated then generated:FindFirstChild(&quot;Runtime&quot;) else nil
			if not source or not source:IsA(&quot;LocalScript&quot;) then
				error(&quot;This plugin package is missing runtime modules. Reinstall the complete FrameForge.rbxmx model.&quot;, 0)
			end
			local runtime = source:Clone()
			runtime.Name = &quot;FrameForgeRuntime&quot;
			runtime.Disabled = false
			runtime.Parent = staged
		elseif options.runtime and sizing == &quot;hybrid&quot; then
			local runtime = packageRoot:FindFirstChild(&quot;Runtime&quot;)
			local fit = if runtime then runtime:FindFirstChild(&quot;Fit&quot;) else nil
			if not fit or not fit:IsA(&quot;LocalScript&quot;) then error(&quot;This package is missing its hybrid sizing helper. Reinstall the complete FrameForge model.&quot;, 0) end
			local helper = fit:Clone()
			helper.Name = &quot;FF_ViewportFit&quot;
			helper.Disabled = false
			helper.Parent = staged
		elseif sizing == &quot;hybrid&quot; then
			table.insert(report.warnings, { nodeId = &quot;&quot;, code = &quot;HYBRID_STATIC&quot;, message = &quot;Hybrid sizing fits this viewport. With runtime disabled, it cannot refit when the player's viewport changes. Enable runtime for adaptive fitting.&quot; })
		end
	end)
	if not success then
		stagingRoot:Destroy()
		return nil, &quot;Import failed while preparing the UI: &quot; .. tostring(stageError)
	end
	local stagedGui = staged :: Instance
	local recorded, recording = pcall(function()
		return ChangeHistoryService:TryBeginRecording(&quot;FrameForgeImport&quot;, &quot;Import &quot; .. stagedGui.Name)
	end)
	if not recorded or not recording then
		stagingRoot:Destroy()
		return nil, &quot;Studio could not begin an undo recording. Finish the current Studio operation and retry.&quot;
	end
	local committed, commitError = pcall(function()
		pluginObject:SetAttribute(&quot;FF_ActiveRecording&quot;, recording)
		stagedGui.Parent = StarterGui
		ChangeHistoryService:FinishRecording(recording, Enum.FinishRecordingOperation.Commit)
	end)
	if not committed then
		stagedGui:Destroy()
		stagingRoot:Destroy()
		pcall(function() ChangeHistoryService:FinishRecording(recording, Enum.FinishRecordingOperation.Cancel) end)
		pluginObject:SetAttribute(&quot;FF_ActiveRecording&quot;, nil)
		local detail = tostring(commitError)
		if string.find(string.lower(detail), &quot;script injection permission&quot;, 1, true) then
			return nil, &quot;Import rolled back. Studio needs permission to install interaction scripts. Choose Allow on the FrameForge permission prompt, then import again. For native UI without scripts, turn off Install interactions and animations.&quot;
		end
		return nil, &quot;Import rolled back: &quot; .. detail
	end
	pluginObject:SetAttribute(&quot;FF_ActiveRecording&quot;, nil)
	stagingRoot:Destroy()
	pcall(function() Selection:Set({ stagedGui }) end)
	report.gui = stagedGui
	report.sizing = sizing
	report.target = target
	if target ~= &quot;ScreenGui&quot; then
		table.insert(report.warnings, { nodeId = &quot;&quot;, code = &quot;WORLD_PARENT&quot;, message = &quot;World GUI is stored in StarterGui, with Adornee set to the selected part. Play mode mounts runtime in PlayerGui; keep that part replicated to clients.&quot; })
	end
	for _, warning in ipairs(inspection.warnings) do
		if warning.code == &quot;TARGET_MISSING&quot; then table.insert(report.warnings, warning) end
	end
	return report, nil
end

return Import
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="FF13"><Properties><string name="Name">Schema</string><ProtectedString name="Source">--!strict
-- This boundary is deliberately independent of Roblox Instance creation.
local Validate = {}
Validate.MAX_BYTES = 8 * 1024 * 1024
Validate.MAX_NODES = 10000
Validate.MAX_DEPTH = 100
Validate.MAX_ASSETS = 1000
Validate.MAX_ASSET_BYTES = 32 * 1024 * 1024
Validate.MAX_BEHAVIORS = 100

local function fail(path: string, message: string)
	error(path .. &quot;: &quot; .. message, 0)
end

local function object(value: any, path: string)
	if type(value) ~= &quot;table&quot; then fail(path, &quot;expected an object&quot;) end
end

local function stringValue(value: any, path: string, maximum: number, optional: boolean?, required: boolean?)
	if value == nil and optional then return end
	if type(value) ~= &quot;string&quot; or #value &gt; maximum then
		fail(path, &quot;expected text of at most &quot; .. maximum .. &quot; bytes&quot;)
	end
	if required and not string.match(value, &quot;%S&quot;) then fail(path, &quot;expected nonempty text&quot;) end
end

local function requiredString(value: any, path: string)
	stringValue(value, path, 1000000, false, true)
end

local function assetId(value: any, path: string)
	requiredString(value, path)
	local digits = string.match(value, &quot;^rbxassetid://([1-9]%d*)$&quot;) or string.match(value, &quot;^([1-9]%d*)$&quot;)
	if not digits then fail(path, &quot;expected a positive Roblox asset ID&quot;) end
end

local function numberValue(value: any, path: string, minimum: number, maximum: number, optional: boolean?)
	if value == nil and optional then return end
	if type(value) ~= &quot;number&quot; or value ~= value or value &lt;= -math.huge or value &gt;= math.huge
		or value &lt; minimum or value &gt; maximum then
		fail(path, &quot;expected a finite number between &quot; .. minimum .. &quot; and &quot; .. maximum)
	end
end

local function booleanValue(value: any, path: string, optional: boolean?)
	if value == nil and optional then return end
	if type(value) ~= &quot;boolean&quot; then fail(path, &quot;expected true or false&quot;) end
end

local function choice(value: any, allowed: {string}, path: string, optional: boolean?)
	if value == nil and optional then return end
	if table.find(allowed, value) == nil then fail(path, &quot;unsupported value '&quot; .. tostring(value) .. &quot;'&quot;) end
end

local function array(value: any, path: string, maximum: number)
	object(value, path)
	local count = 0
	for key in pairs(value) do
		if type(key) ~= &quot;number&quot; or key &lt; 1 or key % 1 ~= 0 then fail(path, &quot;expected an array&quot;) end
		count += 1
	end
	if count &gt; maximum or count ~= #value then fail(path, &quot;array is too large or has gaps&quot;) end
end

local function color(value: any, path: string)
	object(value, path)
	for _, channel in { &quot;r&quot;, &quot;g&quot;, &quot;b&quot;, &quot;a&quot; } do
		numberValue(value[channel], path .. &quot;.&quot; .. channel, 0, 1)
	end
end

local BEHAVIORS = {
	&quot;smooth&quot;, &quot;hoverScale&quot;, &quot;hoverMove&quot;, &quot;hoverTilt&quot;, &quot;pressScale&quot;, &quot;openPanel&quot;, &quot;closePanel&quot;, &quot;togglePanel&quot;, &quot;tab&quot;, &quot;select&quot;,
	&quot;customAction&quot;, &quot;binding&quot;, &quot;pop&quot;, &quot;fade&quot;, &quot;slide&quot;, &quot;cascade&quot;, &quot;ripple&quot;, &quot;float&quot;, &quot;pulse&quot;, &quot;spin&quot;,
	&quot;wiggle&quot;, &quot;shake&quot;, &quot;color&quot;,
}

local function behavior(value: any, path: string)
	object(value, path)
	choice(value.type, BEHAVIORS, path .. &quot;.type&quot;)
	for _, key in { &quot;target&quot;, &quot;group&quot;, &quot;value&quot;, &quot;action&quot;, &quot;source&quot;, &quot;format&quot;, &quot;easing&quot;, &quot;hoverSource&quot; } do
		if value[key] ~= nil then requiredString(value[key], path .. &quot;.&quot; .. key) end
	end
	if value.trigger ~= nil then
		local idle = table.find({ &quot;float&quot;, &quot;pulse&quot;, &quot;spin&quot;, &quot;wiggle&quot;, &quot;shake&quot;, &quot;hoverMove&quot;, &quot;hoverTilt&quot; }, value.type)
		local entrance = table.find({ &quot;pop&quot;, &quot;fade&quot;, &quot;slide&quot;, &quot;cascade&quot; }, value.type)
		choice(value.trigger, if idle then { &quot;hover&quot;, &quot;loop&quot; } elseif entrance then { &quot;hover&quot;, &quot;appear&quot; } else {}, path .. &quot;.trigger&quot;)
	end
	for _, key in { &quot;offsetX&quot;, &quot;offsetY&quot; } do numberValue(value[key], path .. &quot;.&quot; .. key, -10000, 10000, true) end
	numberValue(value.angle, path .. &quot;.angle&quot;, -360, 360, true)
	for _, key in { &quot;scale&quot;, &quot;hoverScale&quot;, &quot;pressScale&quot; } do numberValue(value[key], path .. &quot;.&quot; .. key, 0.01, 10, true) end
	numberValue(value.duration, path .. &quot;.duration&quot;, 0, 60, true)
	numberValue(value.distance, path .. &quot;.distance&quot;, -10000, 10000, true)
	numberValue(value.speed, path .. &quot;.speed&quot;, -10000, 10000, true)
	numberValue(value.intensity, path .. &quot;.intensity&quot;, -10000, 10000, true)
	numberValue(value.delay, path .. &quot;.delay&quot;, 0, 60, true)
	numberValue(value.stagger, path .. &quot;.stagger&quot;, 0, 60, true)
	if value.color ~= nil then color(value.color, path .. &quot;.color&quot;) end
	if table.find({ &quot;openPanel&quot;, &quot;togglePanel&quot;, &quot;tab&quot; }, value.type) then requiredString(value.target, path .. &quot;.target&quot;) end
	if value.type == &quot;tab&quot; or value.type == &quot;select&quot; then requiredString(value.group, path .. &quot;.group&quot;) end
	if value.type == &quot;binding&quot; then requiredString(value.source, path .. &quot;.source&quot;) end
	if value.type == &quot;customAction&quot; then requiredString(value.action, path .. &quot;.action&quot;) end
end

local function layout(value: any, path: string)
	object(value, path)
	choice(value.mode, { &quot;none&quot;, &quot;horizontal&quot;, &quot;vertical&quot;, &quot;grid&quot; }, path .. &quot;.mode&quot;)
	numberValue(value.gap, path .. &quot;.gap&quot;, -1000000, 1000000)
	object(value.padding, path .. &quot;.padding&quot;)
	for _, side in { &quot;top&quot;, &quot;right&quot;, &quot;bottom&quot;, &quot;left&quot; } do numberValue(value.padding[side], path .. &quot;.padding.&quot; .. side, 0, 1000000) end
	choice(value.primaryAlign, { &quot;start&quot;, &quot;center&quot;, &quot;end&quot;, &quot;space-between&quot; }, path .. &quot;.primaryAlign&quot;)
	choice(value.crossAlign, { &quot;start&quot;, &quot;center&quot;, &quot;end&quot; }, path .. &quot;.crossAlign&quot;)
	for _, axis in { &quot;horizontal&quot;, &quot;vertical&quot; } do
		choice(value[axis .. &quot;Sizing&quot;], { &quot;fixed&quot;, &quot;fill&quot;, &quot;hug&quot; }, path .. &quot;.&quot; .. axis .. &quot;Sizing&quot;)
		choice(value[axis .. &quot;Constraint&quot;], { &quot;MIN&quot;, &quot;CENTER&quot;, &quot;MAX&quot;, &quot;STRETCH&quot;, &quot;SCALE&quot; }, path .. &quot;.&quot; .. axis .. &quot;Constraint&quot;)
	end
	booleanValue(value.absolute, path .. &quot;.absolute&quot;, true)
	booleanValue(value.wrap, path .. &quot;.wrap&quot;, true)
	choice(value.scrollDirection, { &quot;x&quot;, &quot;y&quot;, &quot;xy&quot; }, path .. &quot;.scrollDirection&quot;, true)
	numberValue(value.columns, path .. &quot;.columns&quot;, 1, Validate.MAX_NODES, true)
	if value.columns and value.columns % 1 ~= 0 then fail(path .. &quot;.columns&quot;, &quot;expected a whole number&quot;) end
	for _, dimension in { &quot;Width&quot;, &quot;Height&quot; } do
		numberValue(value[&quot;min&quot; .. dimension], path .. &quot;.min&quot; .. dimension, 0, 1000000, true)
		numberValue(value[&quot;max&quot; .. dimension], path .. &quot;.max&quot; .. dimension, 0, 1000000, true)
		if value[&quot;min&quot; .. dimension] and value[&quot;max&quot; .. dimension] and value[&quot;min&quot; .. dimension] &gt; value[&quot;max&quot; .. dimension] then
			fail(path, &quot;minimum size must not exceed maximum size&quot;)
		end
	end
end

local function appearance(value: any, path: string)
	object(value, path)
	numberValue(value.opacity, path .. &quot;.opacity&quot;, 0, 1)
	booleanValue(value.visible, path .. &quot;.visible&quot;)
	booleanValue(value.clipsContent, path .. &quot;.clipsContent&quot;)
	numberValue(value.cornerRadius, path .. &quot;.cornerRadius&quot;, 0, 1000000)
	if value.mask ~= nil then
		object(value.mask, path .. &quot;.mask&quot;)
		choice(value.mask.mode, { &quot;clip&quot;, &quot;canvas&quot; }, path .. &quot;.mask.mode&quot;)
		numberValue(value.mask.alpha, path .. &quot;.mask.alpha&quot;, 0, 1)
	end
	if value.fill ~= nil then color(value.fill, path .. &quot;.fill&quot;) end
	if value.stroke ~= nil then
		object(value.stroke, path .. &quot;.stroke&quot;)
		color(value.stroke.color, path .. &quot;.stroke.color&quot;)
		numberValue(value.stroke.thickness, path .. &quot;.stroke.thickness&quot;, 0, 1000000)
		choice(value.stroke.alignment, { &quot;inside&quot;, &quot;center&quot;, &quot;outside&quot; }, path .. &quot;.stroke.alignment&quot;)
	end
	if value.shadows ~= nil then
		array(value.shadows, path .. &quot;.shadows&quot;, 4)
		for index, shadow in ipairs(value.shadows) do
			local shadowPath = path .. &quot;.shadows[&quot; .. index .. &quot;]&quot;
			object(shadow, shadowPath)
			color(shadow.color, shadowPath .. &quot;.color&quot;)
			object(shadow.offset, shadowPath .. &quot;.offset&quot;)
			for _, axis in { &quot;x&quot;, &quot;y&quot; } do numberValue(shadow.offset[axis], shadowPath .. &quot;.offset.&quot; .. axis, -4096, 4096) end
			numberValue(shadow.blur, shadowPath .. &quot;.blur&quot;, 0, 64)
			numberValue(shadow.spread, shadowPath .. &quot;.spread&quot;, -64, 64)
		end
	end
	if value.gradient ~= nil then
		object(value.gradient, path .. &quot;.gradient&quot;)
		numberValue(value.gradient.rotation, path .. &quot;.gradient.rotation&quot;, -1000000, 1000000)
		array(value.gradient.stops, path .. &quot;.gradient.stops&quot;, 20)
		if #value.gradient.stops &lt; 2 then fail(path .. &quot;.gradient.stops&quot;, &quot;expected at least two stops&quot;) end
		local previous = -1
		for index, stop in ipairs(value.gradient.stops) do
			local stopPath = path .. &quot;.gradient.stops[&quot; .. index .. &quot;]&quot;
			object(stop, stopPath)
			numberValue(stop.position, stopPath .. &quot;.position&quot;, 0, 1)
			if stop.position &lt; previous then fail(stopPath, &quot;gradient stops must be ordered&quot;) end
			previous = stop.position
			color(stop.color, stopPath .. &quot;.color&quot;)
		end
	end
	stringValue(value.asset, path .. &quot;.asset&quot;, 1000000, true)
	choice(value.imageMode, { &quot;fit&quot;, &quot;fill&quot;, &quot;stretch&quot;, &quot;tile&quot; }, path .. &quot;.imageMode&quot;, true)
end

local function textData(value: any, path: string)
	object(value, path)
	stringValue(value.content, path .. &quot;.content&quot;, 1000000)
	stringValue(value.fontFamily, path .. &quot;.fontFamily&quot;, 1000000)
	stringValue(value.fontStyle, path .. &quot;.fontStyle&quot;, 1000000)
	numberValue(value.fontSize, path .. &quot;.fontSize&quot;, 1, 1000)
	color(value.color, path .. &quot;.color&quot;)
	choice(value.horizontalAlign, { &quot;left&quot;, &quot;center&quot;, &quot;right&quot; }, path .. &quot;.horizontalAlign&quot;)
	choice(value.verticalAlign, { &quot;top&quot;, &quot;center&quot;, &quot;bottom&quot; }, path .. &quot;.verticalAlign&quot;)
	booleanValue(value.wrapped, path .. &quot;.wrapped&quot;)
	booleanValue(value.richText, path .. &quot;.richText&quot;)
	numberValue(value.lineHeight, path .. &quot;.lineHeight&quot;, 0, 1000000, true)
	numberValue(value.letterSpacing, path .. &quot;.letterSpacing&quot;, -1000000, 1000000, true)
end

local function check(document: any): any
	object(document, &quot;export&quot;)
	if document.format ~= &quot;FrameForge&quot; then fail(&quot;format&quot;, &quot;this is not a FrameForge export&quot;) end
	if document.version ~= 1 then fail(&quot;version&quot;, &quot;this plugin supports version 1; update the plugin for newer exports&quot;) end
	local value = document.document
	object(value, &quot;document&quot;)
	requiredString(value.name, &quot;document.name&quot;)
	array(value.roots, &quot;document.roots&quot;, Validate.MAX_NODES)
	if #value.roots == 0 then fail(&quot;document.roots&quot;, &quot;export contains no selected roots&quot;) end
	array(value.assets, &quot;document.assets&quot;, Validate.MAX_ASSETS)
	local assetIds = {}
	local assetBytes = 0
	for index, asset in ipairs(value.assets) do
		local path = &quot;document.assets[&quot; .. index .. &quot;]&quot;
		object(asset, path)
		requiredString(asset.id, path .. &quot;.id&quot;)
		if asset.id == &quot;&quot; or assetIds[asset.id] then fail(path .. &quot;.id&quot;, &quot;asset IDs must be nonempty and unique&quot;) end
		assetIds[asset.id] = true
		requiredString(asset.name, path .. &quot;.name&quot;)
		choice(asset.mimeType, { &quot;image/png&quot;, &quot;image/jpeg&quot; }, path .. &quot;.mimeType&quot;)
		if asset.data ~= nil then
			stringValue(asset.data, path .. &quot;.data&quot;, Validate.MAX_ASSET_BYTES * 4 / 3 + 4, false, true)
			local source = asset.data
			local body = string.gsub(source, &quot;=+$&quot;, &quot;&quot;)
			local paddingCount = #source - #body
			if #source % 4 ~= 0 or paddingCount &gt; 2 or string.find(body, &quot;[^A-Za-z0-9+/]&quot;) then
				fail(path .. &quot;.data&quot;, &quot;expected base64-encoded image data&quot;)
			end
			assetBytes += math.floor(#source * 3 / 4) - paddingCount
			if assetBytes &gt; Validate.MAX_ASSET_BYTES then fail(path .. &quot;.data&quot;, &quot;embedded image data exceeds 32 MiB&quot;) end
		end
		if asset.robloxId ~= nil then assetId(asset.robloxId, path .. &quot;.robloxId&quot;) end
	end
	array(value.warnings, &quot;document.warnings&quot;, Validate.MAX_NODES)
	for index, warning in ipairs(value.warnings) do
		local path = &quot;document.warnings[&quot; .. index .. &quot;]&quot;
		object(warning, path)
		requiredString(warning.nodeId, path .. &quot;.nodeId&quot;)
		requiredString(warning.code, path .. &quot;.code&quot;)
		requiredString(warning.message, path .. &quot;.message&quot;)
	end
	object(value.settings, &quot;document.settings&quot;)
	choice(value.settings.sizing, { &quot;pixels&quot;, &quot;responsive&quot;, &quot;hybrid&quot; }, &quot;document.settings.sizing&quot;)
	choice(value.settings.target, { &quot;ScreenGui&quot;, &quot;BillboardGui&quot;, &quot;SurfaceGui&quot; }, &quot;document.settings.target&quot;)
	local count = 0
	local ids: {[string]: boolean} = {}
	local function visit(node: any, path: string, depth: number)
		count += 1
		if count &gt; Validate.MAX_NODES then fail(path, &quot;maximum of &quot; .. Validate.MAX_NODES .. &quot; nodes exceeded&quot;) end
		if depth &gt; Validate.MAX_DEPTH then fail(path, &quot;maximum nesting depth of &quot; .. Validate.MAX_DEPTH .. &quot; exceeded&quot;) end
		object(node, path)
		requiredString(node.id, path .. &quot;.id&quot;)
		if node.id == &quot;&quot; or ids[node.id] then fail(path .. &quot;.id&quot;, &quot;node IDs must be nonempty and unique&quot;) end
		ids[node.id] = true
		stringValue(node.name, path .. &quot;.name&quot;, 1000000)
		choice(node.type, { &quot;FRAME&quot;, &quot;GROUP&quot;, &quot;RECTANGLE&quot;, &quot;ELLIPSE&quot;, &quot;TEXT&quot;, &quot;IMAGE&quot;, &quot;VECTOR&quot;, &quot;COMPONENT&quot;, &quot;INSTANCE&quot; }, path .. &quot;.type&quot;)
		choice(node.strategy, { &quot;native&quot;, &quot;hybrid&quot;, &quot;baked&quot; }, path .. &quot;.strategy&quot;)
		object(node.bounds, path .. &quot;.bounds&quot;)
		for _, key in { &quot;x&quot;, &quot;y&quot;, &quot;rotation&quot; } do numberValue(node.bounds[key], path .. &quot;.bounds.&quot; .. key, -1000000, 1000000) end
		for _, key in { &quot;width&quot;, &quot;height&quot; } do numberValue(node.bounds[key], path .. &quot;.bounds.&quot; .. key, 0, 1000000) end
		layout(node.layout, path .. &quot;.layout&quot;)
		appearance(node.appearance, path .. &quot;.appearance&quot;)
		if node.appearance.asset ~= nil then
			requiredString(node.appearance.asset, path .. &quot;.appearance.asset&quot;)
			if not assetIds[node.appearance.asset] then fail(path .. &quot;.appearance.asset&quot;, &quot;references an unknown asset&quot;) end
		end
		if node.text ~= nil then textData(node.text, path .. &quot;.text&quot;) end
		if node.type == &quot;TEXT&quot; and node.text == nil then fail(path .. &quot;.text&quot;, &quot;TEXT nodes require text data&quot;) end
		if node.componentId ~= nil then requiredString(node.componentId, path .. &quot;.componentId&quot;) end
		object(node.metadata, path .. &quot;.metadata&quot;)
		choice(node.metadata.element, { &quot;normal&quot;, &quot;button&quot;, &quot;panel&quot;, &quot;scroll&quot;, &quot;tab&quot;, &quot;textbox&quot;, &quot;image&quot;, &quot;card&quot;, &quot;grid&quot;, &quot;list&quot; }, path .. &quot;.metadata.element&quot;)
		array(node.metadata.behaviors, path .. &quot;.metadata.behaviors&quot;, Validate.MAX_BEHAVIORS)
		for index, item in ipairs(node.metadata.behaviors) do behavior(item, path .. &quot;.metadata.behaviors[&quot; .. index .. &quot;]&quot;) end
		if node.metadata.panelId ~= nil then requiredString(node.metadata.panelId, path .. &quot;.metadata.panelId&quot;) end
		if node.metadata.assetId ~= nil then assetId(node.metadata.assetId, path .. &quot;.metadata.assetId&quot;) end
		for _, key in { &quot;initiallyHidden&quot;, &quot;disabled&quot;, &quot;closeOnOutside&quot;, &quot;preserveAspectRatio&quot; } do
			booleanValue(node.metadata[key], path .. &quot;.metadata.&quot; .. key, true)
		end
		choice(node.metadata.vectorStrategy, { &quot;auto&quot;, &quot;native&quot;, &quot;rasterize&quot; }, path .. &quot;.metadata.vectorStrategy&quot;, true)
		array(node.children, path .. &quot;.children&quot;, Validate.MAX_NODES)
		for index, child in ipairs(node.children) do visit(child, path .. &quot;.children[&quot; .. index .. &quot;]&quot;, depth + 1) end
	end
	for index, root in ipairs(value.roots) do visit(root, &quot;document.roots[&quot; .. index .. &quot;]&quot;, 0) end
	return { document = document, nodeCount = count }
end

function Validate.document(document: any): (any?, string?)
	local success, result = pcall(check, document)
	if success then return result, nil end
	return nil, tostring(result)
end

return Validate
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="FF14"><Properties><string name="Name">Validate</string><ProtectedString name="Source">--!strict
local HttpService = game:GetService(&quot;HttpService&quot;)
local Schema = require(script.Parent.Schema)
local Validate = {}

function Validate.decode(json: string): (any?, string?)
	if #json == 0 then return nil, &quot;Paste the JSON exported by the FrameForge Figma plugin.&quot; end
	if #json &gt; Schema.MAX_BYTES then return nil, &quot;Export exceeds the 8 MB import limit. Export fewer layers or reduce image resolution.&quot; end
	local success, decoded = pcall(function() return HttpService:JSONDecode(json) end)
	if not success then return nil, &quot;Invalid JSON. Copy the complete export, including its opening and closing braces.&quot; end
	return Schema.document(decoded)
end

return Validate
</ProtectedString></Properties></Item></Item><Item class="Folder" referent="FF17"><Properties><string name="Name">Plugin</string></Properties><Item class="Script" referent="FF16"><Properties><string name="Name">Main</string><ProtectedString name="Source">--!strict
if not plugin then return end

local packageRoot = script.Parent.Parent
local Import = require(packageRoot.Importer.Import)
local Dock = require(packageRoot.Widgets.Dock)
local Theme = require(packageRoot.Widgets.Theme)

Import.recoverRecording(plugin)
local toolbar = plugin:CreateToolbar(&quot;FrameForge&quot;)
local toggle = toolbar:CreateButton(&quot;FrameForge&quot;, &quot;Convert a FrameForge Figma export into editable Roblox UI&quot;, Theme.logoImage, &quot;FrameForge&quot;)
toggle.ClickableWhenViewportHidden = true
local widget = Dock.create(plugin, packageRoot)
toggle:SetActive(widget.Enabled)

local connections: {RBXScriptConnection} = {}
table.insert(connections, toggle.Click:Connect(function() widget.Enabled = not widget.Enabled end))
table.insert(connections, widget:GetPropertyChangedSignal(&quot;Enabled&quot;):Connect(function() toggle:SetActive(widget.Enabled) end))
table.insert(connections, plugin.Unloading:Connect(function()
	Import.recoverRecording(plugin)
	for _, connection in ipairs(connections) do connection:Disconnect() end
	widget:Destroy()
	toolbar:Destroy()
end))
</ProtectedString></Properties></Item></Item><Item class="Folder" referent="FF20"><Properties><string name="Name">Tools</string></Properties><Item class="ModuleScript" referent="FF18"><Properties><string name="Name">Geometry</string><ProtectedString name="Source">--!strict
-- Numbers only: the same transformations are exercised by CLI regression tests.
local Geometry = {}
export type Axis = { scale: number, offset: number }

function Geometry.value(axis: Axis, parentSize: number): number
	return axis.scale * parentSize + axis.offset
end

function Geometry.unscaledLength(renderedLength: number, scale: number): number
	assert(scale == scale and scale &gt; 0 and scale &lt; math.huge, &quot;UI scale must be positive and finite.&quot;)
	return renderedLength / scale
end

function Geometry.rescale(axis: Axis, factor: number, root: boolean): Axis
	return { scale = if root then axis.scale * factor else axis.scale, offset = axis.offset * factor }
end

function Geometry.anchor(position: Axis, size: Axis, oldAnchor: number, newAnchor: number): Axis
	local delta = newAnchor - oldAnchor
	return { scale = position.scale + size.scale * delta, offset = position.offset + size.offset * delta }
end

function Geometry.convert(axis: Axis, parentSize: number, mode: string): Axis
	assert(parentSize &gt; 0 and parentSize &lt; math.huge, &quot;Parent must have a rendered size.&quot;)
	assert(mode == &quot;responsive&quot; or mode == &quot;pixels&quot;, &quot;Unknown coordinate mode.&quot;)
	local value = Geometry.value(axis, parentSize)
	return if mode == &quot;responsive&quot; then { scale = value / parentSize, offset = 0 } else { scale = 0, offset = value }
end

function Geometry.relative(position: Axis, owner: Axis, factor: number): Axis
	return { scale = owner.scale + (position.scale - owner.scale) * factor, offset = owner.offset + (position.offset - owner.offset) * factor }
end

return Geometry
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="FF19"><Properties><string name="Name">Operations</string><ProtectedString name="Source">--!strict
local ChangeHistoryService = game:GetService(&quot;ChangeHistoryService&quot;)
local RunService = game:GetService(&quot;RunService&quot;)
local Geometry = require(script.Parent.Geometry)
local Operations = {}
export type Change = { object: any, property: string, before: any, after: any, attribute: boolean? }
export type Plan = { changes: {Change}, roots: {GuiObject}, title: string }
local MAX_OBJECTS = 10000
local MAX_CHANGES = 50000

local function axis(value: UDim): Geometry.Axis
	return { scale = value.Scale, offset = value.Offset }
end

local function dimensions(x: Geometry.Axis, y: Geometry.Axis): UDim2
	-- Studio stores offsets as integers; round before construction so float32 scale
	-- values such as 0.04 cannot turn an authored 16-pixel offset into 15 pixels.
	return UDim2.new(x.scale, math.round(x.offset), y.scale, math.round(y.offset))
end

local function scaled(value: UDim2, factor: number, root: boolean): UDim2
	local x, y = Geometry.rescale(axis(value.X), factor, root), Geometry.rescale(axis(value.Y), factor, root)
	return dimensions(x, y)
end

local function read(change: Change): any
	return if change.attribute then change.object:GetAttribute(change.property) else change.object[change.property]
end

local function write(change: Change, value: any)
	if change.attribute then change.object:SetAttribute(change.property, value) else change.object[change.property] = value end
end

local function add(plan: Plan, object: any, property: string, after: any, attribute: boolean?)
	local before = if attribute then object:GetAttribute(property) else object[property]
	if before == after then return end
	assert(#plan.changes &lt; MAX_CHANGES, &quot;Selection is too large. Resize smaller components separately.&quot;)
	table.insert(plan.changes, { object = object, property = property, before = before, after = after, attribute = attribute })
end

function Operations.roots(selection: {Instance}): ({GuiObject}, number)
	local candidates, unique = {}, {}
	local ignored = 0
	for _, selected in ipairs(selection) do
		local object = selected
		if selected:IsA(&quot;LayerCollector&quot;) and selected:GetAttribute(&quot;FF_Format&quot;) == &quot;FrameForge&quot; then
			object = selected:FindFirstChild(&quot;FF_Design&quot;) or selected
		end
		if object:IsA(&quot;GuiObject&quot;) and object:GetAttribute(&quot;FF_Decoration&quot;) ~= true then
			if not unique[object] then unique[object] = true; table.insert(candidates, object :: GuiObject) end
		else ignored += 1 end
	end
	local roots = {}
	for _, candidate in ipairs(candidates) do
		local contained = false
		local ancestor = candidate.Parent
		while ancestor do
			if unique[ancestor] then contained = true; break end
			ancestor = ancestor.Parent
		end
		if not contained then table.insert(roots, candidate) end
	end
	return roots, ignored
end

local function shadows(owner: GuiObject): {GuiObject}
	local id, parent = owner:GetAttribute(&quot;FF_ID&quot;), owner.Parent
	local result = {}
	if type(id) ~= &quot;string&quot; or not parent then return result end
	for _, sibling in ipairs(parent:GetChildren()) do
		if sibling:IsA(&quot;GuiObject&quot;) and sibling:GetAttribute(&quot;FF_Decoration&quot;) == true and sibling:GetAttribute(&quot;FF_ShadowFor&quot;) == id then
			table.insert(result, sibling)
		end
	end
	return result
end

local function basePlan(selection: {Instance}, title: string): Plan
	assert(not RunService:IsRunning(), &quot;Stop Play mode before editing UI.&quot;)
	local roots = Operations.roots(selection)
	assert(#roots &gt; 0, &quot;Select a UI frame, button, label, or imported GUI in Explorer.&quot;)
	return { changes = {}, roots = roots, title = title }
end

local function rescaleObject(plan: Plan, object: Instance, factor: number, root: boolean)
	if object:IsA(&quot;GuiObject&quot;) then
		add(plan, object, &quot;Size&quot;, scaled(object.Size, factor, root))
		if root and object.Name == &quot;FF_Design&quot; then
			local width, height = object:GetAttribute(&quot;FF_DesignWidth&quot;), object:GetAttribute(&quot;FF_DesignHeight&quot;)
			if width ~= nil or height ~= nil then
				assert(type(width) == &quot;number&quot; and width &gt; 0 and width &lt; math.huge and type(height) == &quot;number&quot; and height &gt; 0 and height &lt; math.huge,
					&quot;The imported design's width or height metadata is invalid. Restore both design dimensions before resizing.&quot;)
				add(plan, object, &quot;FF_DesignWidth&quot;, width * factor, true)
				add(plan, object, &quot;FF_DesignHeight&quot;, height * factor, true)
			end
		end
		if not root then add(plan, object, &quot;Position&quot;, scaled(object.Position, factor, false)) end
		if object.BorderSizePixel &gt; 0 then add(plan, object, &quot;BorderSizePixel&quot;, math.max(1, math.round(object.BorderSizePixel * factor))) end
		if object:IsA(&quot;TextLabel&quot;) or object:IsA(&quot;TextButton&quot;) or object:IsA(&quot;TextBox&quot;) then
			if not object.TextScaled then
				local textSize = object.TextSize * factor
				assert(textSize &gt;= 1 and textSize &lt;= 100, &quot;The resize would put a text size outside Studio's 1–100 range. Use a smaller resize or TextScaled.&quot;)
				add(plan, object, &quot;TextSize&quot;, textSize)
			end
		end
		if object:IsA(&quot;ScrollingFrame&quot;) then
			add(plan, object, &quot;CanvasSize&quot;, scaled(object.CanvasSize, factor, false))
			add(plan, object, &quot;CanvasPosition&quot;, object.CanvasPosition * factor)
			add(plan, object, &quot;ScrollBarThickness&quot;, math.max(0, math.round(object.ScrollBarThickness * factor)))
		end
	elseif object:IsA(&quot;UIPadding&quot;) then
		for _, property in ipairs({ &quot;PaddingTop&quot;, &quot;PaddingBottom&quot;, &quot;PaddingLeft&quot;, &quot;PaddingRight&quot; }) do
			local value = (object :: any)[property]
			add(plan, object, property, UDim.new(value.Scale, value.Offset * factor))
		end
	elseif object:IsA(&quot;UICorner&quot;) then
		add(plan, object, &quot;CornerRadius&quot;, UDim.new(object.CornerRadius.Scale, object.CornerRadius.Offset * factor))
	elseif object:IsA(&quot;UIStroke&quot;) then
		-- Newer Studio versions can express thickness relative to the component.
		-- Relative strokes already grow with the resized owner.
		local supported, sizingMode = pcall(function() return object.StrokeSizingMode end)
		if not supported or sizingMode.Name == &quot;FixedSize&quot; then add(plan, object, &quot;Thickness&quot;, object.Thickness * factor) end
		local hasOffset, borderOffset = pcall(function() return object.BorderOffset end)
		if hasOffset then add(plan, object, &quot;BorderOffset&quot;, UDim.new(borderOffset.Scale, borderOffset.Offset * factor)) end
	elseif object:IsA(&quot;UIListLayout&quot;) or object:IsA(&quot;UIPageLayout&quot;) then
		add(plan, object, &quot;Padding&quot;, UDim.new(object.Padding.Scale, object.Padding.Offset * factor))
	elseif object:IsA(&quot;UIGridLayout&quot;) then
		add(plan, object, &quot;CellSize&quot;, scaled(object.CellSize, factor, false))
		add(plan, object, &quot;CellPadding&quot;, scaled(object.CellPadding, factor, false))
	elseif object:IsA(&quot;UISizeConstraint&quot;) then
		if factor &lt; 1 then
			add(plan, object, &quot;MinSize&quot;, object.MinSize * factor); add(plan, object, &quot;MaxSize&quot;, object.MaxSize * factor)
		else
			add(plan, object, &quot;MaxSize&quot;, object.MaxSize * factor); add(plan, object, &quot;MinSize&quot;, object.MinSize * factor)
		end
	elseif object:IsA(&quot;UITextSizeConstraint&quot;) then
		local maximum, minimum = math.round(object.MaxTextSize * factor), math.round(object.MinTextSize * factor)
		assert(maximum &lt;= 100 and minimum &gt;= 1, &quot;The resize would put a text constraint outside Studio's 1–100 range. Use a smaller resize.&quot;)
		-- Order keeps both limits valid while shrinking or enlarging.
		if factor &lt; 1 then
			add(plan, object, &quot;MinTextSize&quot;, minimum); add(plan, object, &quot;MaxTextSize&quot;, maximum)
		else
			add(plan, object, &quot;MaxTextSize&quot;, maximum); add(plan, object, &quot;MinTextSize&quot;, minimum)
		end
	end
end

function Operations.resize(selection: {Instance}, factor: number): Plan
	assert(factor == factor and factor &gt;= 0.05 and factor &lt;= 10, &quot;Enter a percentage from 5 to 1000.&quot;)
	local plan = basePlan(selection, &quot;Resize UI components&quot;)
	local seen, count = {}, 0
	local function visit(root: GuiObject)
		local objects = { root }
		for _, object in ipairs(root:GetDescendants()) do table.insert(objects, object) end
		for _, object in ipairs(objects) do
			if seen[object] then continue end
			seen[object] = true
			count += 1
			assert(count &lt;= MAX_OBJECTS, &quot;Selection is too large. Resize smaller components separately.&quot;)
			rescaleObject(plan, object, factor, object == root)
		end
	end
	for _, root in ipairs(plan.roots) do
		assert(not (root.Parent and root.Parent:FindFirstChildWhichIsA(&quot;UIGridLayout&quot;)), &quot;The parent grid controls this component's size. Select the grid's outer frame to resize the complete layout.&quot;)
		local flex = root:FindFirstChildWhichIsA(&quot;UIFlexItem&quot;)
		assert(not flex or flex.FlexMode == Enum.UIFlexMode.None, &quot;The parent flex layout controls this component's size. Select its outer frame to resize the complete layout.&quot;)
		visit(root)
		for _, shadow in ipairs(shadows(root)) do
			if seen[shadow] then continue end
			visit(shadow)
			local x, y = Geometry.relative(axis(shadow.Position.X), axis(root.Position.X), factor), Geometry.relative(axis(shadow.Position.Y), axis(root.Position.Y), factor)
			add(plan, shadow, &quot;Position&quot;, dimensions(x, y))
		end
	end
	return plan
end

local function layoutControlsPosition(object: GuiObject): boolean
	local parent = object.Parent
	if not parent then return false end
	for _, sibling in ipairs(parent:GetChildren()) do
		if sibling:IsA(&quot;UIGridStyleLayout&quot;) then return true end
	end
	return false
end

-- AbsoluteSize includes ancestor UIScale modifiers. UDim offsets are authored
-- in the corresponding unscaled coordinate system, including FF_DesignScale.
local function parentCoordinateSize(parent: Instance): Vector2
	local scale = 1
	local ancestor: Instance? = parent
	while ancestor and ancestor:IsA(&quot;GuiObject&quot;) do
		local found = false
		for _, modifier in ipairs(ancestor:GetChildren()) do
			if modifier:IsA(&quot;UIScale&quot;) then
				assert(not found, &quot;Multiple UIScale modifiers control the same parent. Keep one scale before converting coordinates.&quot;)
				found = true
				scale *= modifier.Scale
			end
		end
		ancestor = ancestor.Parent
	end
	local rendered = (parent :: any).AbsoluteSize :: Vector2
	return Vector2.new(Geometry.unscaledLength(rendered.X, scale), Geometry.unscaledLength(rendered.Y, scale))
end

function Operations.anchor(selection: {Instance}, anchorPoint: Vector2): Plan
	assert(anchorPoint.X &gt;= 0 and anchorPoint.X &lt;= 1 and anchorPoint.Y &gt;= 0 and anchorPoint.Y &lt;= 1, &quot;Anchor must be inside the component.&quot;)
	local plan = basePlan(selection, &quot;Change UI anchor&quot;)
	local function change(object: GuiObject)
		assert(not layoutControlsPosition(object), &quot;This component's parent layout controls placement. Select its outer frame to change the anchor.&quot;)
		assert(not object:FindFirstChildWhichIsA(&quot;UIAspectRatioConstraint&quot;) and not object:FindFirstChildWhichIsA(&quot;UISizeConstraint&quot;)
			and not object:FindFirstChildWhichIsA(&quot;UIScale&quot;) and object.AutomaticSize == Enum.AutomaticSize.None and object.SizeConstraint == Enum.SizeConstraint.RelativeXY,
			&quot;This component's size is controlled by a constraint or automatic sizing. Change the anchor on a fixed outer frame to preserve its placement.&quot;)
		local x = Geometry.anchor(axis(object.Position.X), axis(object.Size.X), object.AnchorPoint.X, anchorPoint.X)
		local y = Geometry.anchor(axis(object.Position.Y), axis(object.Size.Y), object.AnchorPoint.Y, anchorPoint.Y)
		add(plan, object, &quot;Position&quot;, dimensions(x, y))
		add(plan, object, &quot;AnchorPoint&quot;, anchorPoint)
	end
	for _, root in ipairs(plan.roots) do
		change(root)
		for _, shadow in ipairs(shadows(root)) do change(shadow) end
	end
	return plan
end

function Operations.coordinates(selection: {Instance}, mode: string): Plan
	local plan = basePlan(selection, if mode == &quot;responsive&quot; then &quot;Use responsive UI coordinates&quot; else &quot;Use fixed UI coordinates&quot;)
	local function change(object: GuiObject)
		local parent = object.Parent
		assert(parent and (parent:IsA(&quot;GuiObject&quot;) or parent:IsA(&quot;LayerCollector&quot;)), &quot;The UI must be inside a rendered GUI.&quot;)
		local size = parentCoordinateSize(parent)
		assert(size.X &gt; 0 and size.Y &gt; 0, &quot;Show this GUI in the viewport first so its parent can be measured.&quot;)
		assert(object.AutomaticSize == Enum.AutomaticSize.None and object.SizeConstraint == Enum.SizeConstraint.RelativeXY,
			&quot;Automatic sizing or a relative-axis size constraint controls this component. Select a fixed outer frame instead.&quot;)
		assert(not parent:FindFirstChildWhichIsA(&quot;UIPadding&quot;), &quot;A padded parent changes the coordinate area. Select its outer frame instead.&quot;)
		assert(not object:FindFirstChildWhichIsA(&quot;UIScale&quot;), &quot;An existing UIScale controls this component. Select an outer frame without UIScale.&quot;)
		local sx, sy = Geometry.convert(axis(object.Size.X), size.X, mode), Geometry.convert(axis(object.Size.Y), size.Y, mode)
		add(plan, object, &quot;Size&quot;, dimensions(sx, sy))
		-- Parent layouts own Position; their ordering and alignment stay untouched.
		if not layoutControlsPosition(object) then
			local px, py = Geometry.convert(axis(object.Position.X), size.X, mode), Geometry.convert(axis(object.Position.Y), size.Y, mode)
			add(plan, object, &quot;Position&quot;, dimensions(px, py))
		end
	end
	for _, root in ipairs(plan.roots) do
		change(root)
		for _, shadow in ipairs(shadows(root)) do change(shadow) end
	end
	return plan
end

function Operations.apply(pluginObject: Plugin, plan: Plan): (boolean, string)
	if RunService:IsRunning() then return false, &quot;Stop Play mode before editing UI.&quot; end
	if #plan.changes == 0 then return true, &quot;The selected components already use these values.&quot; end
	if pluginObject:GetAttribute(&quot;FF_ActiveRecording&quot;) ~= nil then return false, &quot;Finish the current FrameForge operation first.&quot; end
	for _, change in ipairs(plan.changes) do
		if change.object.Parent == nil or read(change) ~= change.before then
			return false, &quot;The selection changed while preparing the edit. Try again.&quot;
		end
	end
	local started, recording = pcall(function() return ChangeHistoryService:TryBeginRecording(&quot;FrameForgeTools&quot;, plan.title) end)
	if not started or not recording then return false, &quot;Studio could not begin an undo recording. Finish the current operation and retry.&quot; end
	local applied = 0
	local success, failure = pcall(function()
		pluginObject:SetAttribute(&quot;FF_ActiveRecording&quot;, recording)
		for index, change in ipairs(plan.changes) do
			write(change, change.after)
			applied = index
		end
		ChangeHistoryService:FinishRecording(recording, Enum.FinishRecordingOperation.Commit)
	end)
	if not success then
		for index = applied, 1, -1 do
			local change = plan.changes[index]
			pcall(function() write(change, change.before) end)
		end
		pcall(function() ChangeHistoryService:FinishRecording(recording, Enum.FinishRecordingOperation.Cancel) end)
	end
	pluginObject:SetAttribute(&quot;FF_ActiveRecording&quot;, nil)
	if not success then return false, &quot;The edit was rolled back: &quot; .. tostring(failure) end
	return true, &quot;Updated &quot; .. #plan.roots .. &quot; component&quot; .. (if #plan.roots == 1 then &quot;&quot; else &quot;s&quot;) .. &quot;. Press Ctrl+Z / Cmd+Z to undo.&quot;
end

return Operations
</ProtectedString></Properties></Item></Item><Item class="Folder" referent="FF26"><Properties><string name="Name">Widgets</string></Properties><Item class="ModuleScript" referent="FF21"><Properties><string name="Name">Dock</string><ProtectedString name="Source">--!strict
local ChangeHistoryService = game:GetService(&quot;ChangeHistoryService&quot;)
local Import = require(script.Parent.Parent.Importer.Import)
local Theme = require(script.Parent.Theme)
local LayoutTools = require(script.Parent.LayoutTools)
local VERSION = require(script.Parent.Parent.Generated.Version)

local Dock = {}
local THEME = Theme.colors

local function corner(object: GuiObject, radius: number)
	local result = Instance.new(&quot;UICorner&quot;)
	result.CornerRadius = UDim.new(0, radius)
	result.Parent = object
end

local function stroke(object: GuiObject)
	local result = Instance.new(&quot;UIStroke&quot;)
	result.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	result.Color = THEME.border
	result.Thickness = 1
	result.Parent = object
end

local function padding(object: GuiObject, amount: number)
	local result = Instance.new(&quot;UIPadding&quot;)
	result.PaddingLeft = UDim.new(0, amount)
	result.PaddingRight = UDim.new(0, amount)
	result.PaddingTop = UDim.new(0, amount)
	result.PaddingBottom = UDim.new(0, amount)
	result.Parent = object
end

local function vertical(object: Instance, gap: number)
	local result = Instance.new(&quot;UIListLayout&quot;)
	result.SortOrder = Enum.SortOrder.LayoutOrder
	result.Padding = UDim.new(0, gap)
	result.Parent = object
end

local function label(parent: Instance, text: string, size: number, color: Color3?): TextLabel
	local result = Instance.new(&quot;TextLabel&quot;)
	result.BackgroundTransparency = 1
	result.Size = UDim2.new(1, 0, 0, 0)
	result.AutomaticSize = Enum.AutomaticSize.Y
	result.Text = text
	result.TextSize = size
	result.Font = Enum.Font.Gotham
	result.TextColor3 = color or THEME.text
	result.TextXAlignment = Enum.TextXAlignment.Left
	result.TextYAlignment = Enum.TextYAlignment.Top
	result.TextWrapped = true
	result.RichText = false
	result.Parent = parent
	return result
end

local function button(parent: Instance, text: string, accent: boolean?): TextButton
	local result = Instance.new(&quot;TextButton&quot;)
	result.Name = text
	result.Size = UDim2.new(1, 0, 0, if accent then 42 else 36)
	result.BackgroundColor3 = if accent then THEME.accent else THEME.field
	result.BorderSizePixel = 0
	result.Text = text
	result.Font = if accent then Enum.Font.GothamBold else Enum.Font.GothamMedium
	result.TextSize = 13
	result.TextColor3 = if accent then THEME.accentText else THEME.text
	result.AutoButtonColor = true
	corner(result, 7)
	if not accent then stroke(result) end
	result.Parent = parent
	return result
end

local function selectedButton(control: TextButton, selected: boolean)
	control.BackgroundColor3 = if selected then THEME.selected else THEME.field
	control.TextColor3 = if selected then THEME.text else THEME.muted
	local border = control:FindFirstChildWhichIsA(&quot;UIStroke&quot;)
	if border then border.Color = if selected then THEME.accent else THEME.border end
end

local function section(parent: Instance, title: string, order: number): Frame
	local result = Instance.new(&quot;Frame&quot;)
	result.Name = title
	result.BackgroundColor3 = THEME.card
	result.BorderSizePixel = 0
	result.Size = UDim2.new(1, 0, 0, 0)
	result.AutomaticSize = Enum.AutomaticSize.Y
	result.LayoutOrder = order
	corner(result, 10)
	stroke(result)
	padding(result, 14)
	result.Parent = parent
	vertical(result, 10)
	local heading = label(result, title, 12, THEME.text)
	heading.Font = Enum.Font.GothamBold
	heading.LayoutOrder = 0
	return result
end

local function textEntry(parent: Instance, placeholder: string, height: number, multiline: boolean): TextBox
	local scroll = Instance.new(&quot;ScrollingFrame&quot;)
	scroll.Size = UDim2.new(1, 0, 0, height)
	scroll.BackgroundColor3 = THEME.field
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = if multiline then 4 else 0
	scroll.ScrollBarImageColor3 = THEME.accent
	scroll.CanvasSize = UDim2.fromOffset(0, 0)
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.ScrollingDirection = Enum.ScrollingDirection.Y
	scroll.LayoutOrder = 1
	scroll.ClipsDescendants = true
	corner(scroll, 7)
	stroke(scroll)
	padding(scroll, 10)
	scroll.Parent = parent
	local box = Instance.new(&quot;TextBox&quot;)
	box.BackgroundTransparency = 1
	box.Size = UDim2.new(1, -5, 0, math.max(18, height - 20))
	box.AutomaticSize = if multiline then Enum.AutomaticSize.Y else Enum.AutomaticSize.None
	box.ClearTextOnFocus = false
	box.MultiLine = multiline
	box.Text = &quot;&quot;
	box.PlaceholderText = placeholder
	box.PlaceholderColor3 = THEME.muted
	box.TextColor3 = THEME.text
	box.Font = Enum.Font.Code
	box.TextSize = 12
	box.TextXAlignment = Enum.TextXAlignment.Left
	box.TextYAlignment = if multiline then Enum.TextYAlignment.Top else Enum.TextYAlignment.Center
	box.TextWrapped = multiline
	box.Parent = scroll
	return box
end

local function choiceRow(parent: Instance, values: {string}, initial: string, onChange: (string) -&gt; ())
	local row = Instance.new(&quot;Frame&quot;)
	row.BackgroundTransparency = 1
	row.Size = UDim2.new(1, 0, 0, 34)
	row.LayoutOrder = 1
	row.Parent = parent
	local buttons = {}
	local function choose(value: string)
		for key, control in pairs(buttons) do
			selectedButton(control, key == value)
		end
		onChange(value)
	end
	for index, value in ipairs(values) do
		local titles = { pixels = &quot;Pixels&quot;, hybrid = &quot;Hybrid&quot;, responsive = &quot;Responsive&quot;, export = &quot;From export&quot;, ScreenGui = &quot;Screen&quot;, BillboardGui = &quot;Billboard&quot;, SurfaceGui = &quot;Surface&quot; }
		local control = button(row, titles[value] or value)
		control.TextSize = 12
		control.Size = UDim2.new(1 / #values, -5, 1, 0)
		control.Position = UDim2.new((index - 1) / #values, if index &gt; 1 then 2 else 0, 0, 0)
		buttons[value] = control
		control.Activated:Connect(function() choose(value) end)
	end
	choose(initial)
end

local function reportText(report: any, imported: boolean): string
	local lines = {}
	if imported then
		table.insert(lines, &quot;Imported &quot; .. report.gui.Name .. &quot; into StarterGui.&quot;)
		table.insert(lines, report.nativeCount .. &quot; editable native nodes · &quot; .. report.bakedCount .. &quot; raster layers · &quot; .. report.imageCount .. &quot; mapped images · &quot; .. report.behaviorCount .. &quot; behaviors&quot;)
		table.insert(lines, &quot;Press Ctrl+Z / Cmd+Z to undo. Play mode activates the runtime.&quot;)
	else
		table.insert(lines, &quot;Valid version 1 export: &quot; .. report.nodeCount .. &quot; nodes · &quot; .. report.behaviorCount .. &quot; behaviors.&quot;)
	end
	if #report.missingAssets &gt; 0 then
		table.insert(lines, &quot;&quot;)
		table.insert(lines, &quot;Missing image mappings (&quot; .. #report.missingAssets .. &quot;):&quot;)
		for index, asset in ipairs(report.missingAssets) do
			if index &gt; 15 then table.insert(lines, &quot;More assets are listed in Studio Output.&quot;); break end
			table.insert(lines, asset.id .. &quot; — &quot; .. asset.name .. &quot; (&quot; .. asset.uses .. &quot; uses)&quot;)
		end
		table.insert(lines, &quot;Upload exported PNGs in Asset Manager, then enter IDs above. Unmapped layers remain editable but their images are empty.&quot;)
	end
	local warningCount = #report.warnings
	if warningCount &gt; 0 then
		table.insert(lines, &quot;&quot;)
		table.insert(lines, &quot;Warnings (&quot; .. warningCount .. &quot;):&quot;)
		for index, warning in ipairs(report.warnings) do
			if index &gt; 20 then table.insert(lines, &quot;See Studio Output for the remaining warnings.&quot;); break end
			table.insert(lines, &quot;• &quot; .. warning.message)
		end
	end
	return table.concat(lines, &quot;\n&quot;)
end

function Dock.create(pluginObject: Plugin, packageRoot: Instance): DockWidgetPluginGui
	local info = DockWidgetPluginGuiInfo.new(Enum.InitialDockState.Right, false, false, 460, 740, 350, 440)
	local widget = pluginObject:CreateDockWidgetPluginGuiAsync(&quot;FrameForge.Import.v1&quot;, info)
	widget.Title = &quot;FrameForge&quot;
	local navigationHeight = 44
	local navigation = Instance.new(&quot;Frame&quot;)
	navigation.Name = &quot;Navigation&quot;
	navigation.Size = UDim2.new(1, 0, 0, navigationHeight)
	navigation.BackgroundColor3 = THEME.card
	navigation.BorderSizePixel = 0
	navigation.Parent = widget
	local canvas = Instance.new(&quot;ScrollingFrame&quot;)
	canvas.Name = &quot;Importer&quot;
	-- The footer lives outside the canvas, so long reports never scroll credits away or overlap them.
	canvas.Position = UDim2.fromOffset(0, navigationHeight)
	canvas.Size = UDim2.new(1, 0, 1, -Theme.footerHeight - navigationHeight)
	canvas.BackgroundColor3 = THEME.background
	canvas.BorderSizePixel = 0
	canvas.ScrollBarThickness = 5
	canvas.ScrollBarImageColor3 = THEME.accent
	canvas.CanvasSize = UDim2.fromOffset(0, 0)
	canvas.AutomaticCanvasSize = Enum.AutomaticSize.Y
	canvas.ScrollingDirection = Enum.ScrollingDirection.Y
	canvas.ClipsDescendants = true
	canvas.Parent = widget
	padding(canvas, 16)
	vertical(canvas, 14)
	local tools = LayoutTools.create(pluginObject, widget)
	tools.Position = canvas.Position
	tools.Size = canvas.Size
	local importTab = button(navigation, &quot;Import&quot;)
	local toolsTab = button(navigation, &quot;UI tools&quot;)
	importTab.Size, toolsTab.Size = UDim2.new(0.5, -18, 0, 30), UDim2.new(0.5, -18, 0, 30)
	importTab.Position, toolsTab.Position = UDim2.fromOffset(12, 7), UDim2.new(0.5, 6, 0, 7)
	local function showTools(enabled: boolean)
		canvas.Visible, tools.Visible = not enabled, enabled
		selectedButton(importTab, not enabled)
		selectedButton(toolsTab, enabled)
	end
	importTab.Activated:Connect(function() showTools(false) end)
	toolsTab.Activated:Connect(function() showTools(true) end)
	showTools(false)
	local footer = Instance.new(&quot;Frame&quot;)
	footer.Name = &quot;CreditsFooter&quot;
	footer.Position = UDim2.new(0, 0, 1, -Theme.footerHeight)
	footer.Size = UDim2.new(1, 0, 0, Theme.footerHeight)
	footer.BackgroundColor3 = THEME.card
	footer.BorderSizePixel = 0
	footer.Parent = widget
	local divider = Instance.new(&quot;Frame&quot;)
	divider.Name = &quot;Divider&quot;
	divider.Size = UDim2.new(1, 0, 0, 1)
	divider.BackgroundColor3 = THEME.border
	divider.BorderSizePixel = 0
	divider.Parent = footer
	local credits = label(footer, &quot;Credits : Discord - @mngr06&quot;, 11, THEME.muted)
	credits.Name = &quot;Credits&quot;
	credits.AutomaticSize = Enum.AutomaticSize.None
	credits.Size = UDim2.new(1, -24, 1, 0)
	credits.Position = UDim2.fromOffset(12, 0)
	credits.TextXAlignment = Enum.TextXAlignment.Center
	credits.TextYAlignment = Enum.TextYAlignment.Center
	credits.Font = Enum.Font.GothamMedium
	local header = section(canvas, &quot;FIGMA → ROBLOX&quot;, 0)
	local headerHeading = header:FindFirstChildWhichIsA(&quot;TextLabel&quot;)
	if headerHeading then headerHeading.TextColor3 = THEME.accent; headerHeading.TextSize = 10 end
	local brandRow = Instance.new(&quot;Frame&quot;)
	brandRow.Name = &quot;Brand&quot;
	brandRow.BackgroundTransparency = 1
	brandRow.Size = UDim2.new(1, 0, 0, 58)
	brandRow.LayoutOrder = 1
	brandRow.Parent = header
	local mark = Theme.createMark(brandRow, 56)
	local titleOffset = mark.Size.X.Offset + 16
	local brandTitle = label(brandRow, &quot;FrameForge&quot;, 27)
	brandTitle.Font = Enum.Font.GothamBold
	brandTitle.Position = UDim2.fromOffset(titleOffset, 7)
	brandTitle.Size = UDim2.new(1, -titleOffset, 0, 0)
	local brandSubtitle = label(brandRow, &quot;STUDIO IMPORTER · &quot; .. VERSION, 10, THEME.muted)
	brandSubtitle.Position = UDim2.fromOffset(titleOffset + 1, 41)
	brandSubtitle.Size = UDim2.new(1, -titleOffset - 1, 0, 0)
	label(header, &quot;Design in Figma. Forge it into editable Roblox UI.&quot;, 12, THEME.muted).LayoutOrder = 2
	local paste = section(canvas, &quot;01  PASTE EXPORT&quot;, 1)
	local json = textEntry(paste, &quot;Paste your complete FrameForge JSON export here…&quot;, 210, true)
	local sizingSection = section(canvas, &quot;02  SIZING STRATEGY&quot;, 2)
	local sizing = &quot;hybrid&quot;
	local sizingHint = label(sizingSection, &quot;&quot;, 11, THEME.muted)
	sizingHint.LayoutOrder = 2
	local savedSizing: any = nil
	pcall(function() savedSizing = pluginObject:GetSetting(&quot;FrameForge.Sizing&quot;) end)
	choiceRow(sizingSection, { &quot;pixels&quot;, &quot;responsive&quot;, &quot;hybrid&quot; }, if table.find({ &quot;pixels&quot;, &quot;responsive&quot;, &quot;hybrid&quot; }, savedSizing) then savedSizing else &quot;hybrid&quot;, function(value)
		sizing = value
		sizingHint.Text = ({ pixels = &quot;Original pixel dimensions, centered in the viewport.&quot;, responsive = &quot;Geometry follows viewport size; text scales within readable limits.&quot;, hybrid = &quot;Fit the design aspect ratio, preserve text and fixed sizes, and honor Figma constraints.&quot; })[value]
	end)
	local targetSection = section(canvas, &quot;03  OUTPUT TARGET&quot;, 3)
	local target = &quot;export&quot;
	local exportedTarget = &quot;ScreenGui&quot;
	local world = section(targetSection, &quot;Select a BasePart in Workspace for world UI.&quot;, 2)
	world.Visible = false
	local worldInputs: {[string]: TextBox} = {}
	local worldRowOrder = 1
	local function inputRow(definitions: {{string}}, visibility: string?): Frame
		local row = Instance.new(&quot;Frame&quot;)
		row.Name = visibility or &quot;WorldOptions&quot;
		row.BackgroundTransparency = 1
		row.Size = UDim2.new(1, 0, 0, 59)
		row.LayoutOrder = worldRowOrder
		worldRowOrder += 1
		row.Parent = world
		for index, definition in ipairs(definitions) do
			local column = Instance.new(&quot;Frame&quot;)
			column.BackgroundTransparency = 1
			column.Size = UDim2.new(1 / #definitions, -6, 1, 0)
			column.Position = UDim2.fromScale((index - 1) / #definitions, 0)
			column.Parent = row
			label(column, definition[2], 10, THEME.muted)
			local box = textEntry(column, definition[3], 34, false)
			local boxContainer = box.Parent :: GuiObject
			boxContainer.Position = UDim2.fromOffset(0, 18)
			box.Text = definition[3]
			worldInputs[definition[1]] = box
		end
		return row
	end
	local billboardSize = inputRow({ { &quot;width&quot;, &quot;Width (studs)&quot;, &quot;6&quot; }, { &quot;height&quot;, &quot;Height (studs)&quot;, &quot;4&quot; }, { &quot;maxDistance&quot;, &quot;Max distance&quot;, &quot;100&quot; } }, &quot;Billboard&quot;)
	local billboardOffset = inputRow({ { &quot;offsetX&quot;, &quot;Offset X&quot;, &quot;0&quot; }, { &quot;offsetY&quot;, &quot;Offset Y&quot;, &quot;3&quot; }, { &quot;offsetZ&quot;, &quot;Offset Z&quot;, &quot;0&quot; } }, &quot;Billboard&quot;)
	local surfaceOptions = inputRow({ { &quot;face&quot;, &quot;Face&quot;, &quot;Front&quot; }, { &quot;pixelsPerStud&quot;, &quot;Pixels/stud (optional)&quot;, &quot;&quot; } }, &quot;Surface&quot;)
	inputRow({ { &quot;lightInfluence&quot;, &quot;Light influence (0–1)&quot;, &quot;0&quot; } })
	local alwaysOnTop = false
	local onTop = button(world, &quot;○  Always on top&quot;)
	onTop.LayoutOrder = 6
	onTop.Activated:Connect(function()
		alwaysOnTop = not alwaysOnTop
		onTop.Text = (if alwaysOnTop then &quot;●&quot; else &quot;○&quot;) .. &quot;  Always on top&quot;
		selectedButton(onTop, alwaysOnTop)
	end)
	local function updateWorldControls()
		local value = if target == &quot;export&quot; then exportedTarget else target
		world.Visible = value ~= &quot;ScreenGui&quot;
		billboardSize.Visible, billboardOffset.Visible = value == &quot;BillboardGui&quot;, value == &quot;BillboardGui&quot;
		surfaceOptions.Visible = value == &quot;SurfaceGui&quot;
	end
	choiceRow(targetSection, { &quot;export&quot;, &quot;ScreenGui&quot;, &quot;BillboardGui&quot;, &quot;SurfaceGui&quot; }, target, function(value)
		target = value
		updateWorldControls()
	end)
	label(targetSection, &quot;From export uses the target chosen in Figma. Validate first to show its world UI settings.&quot;, 11, THEME.muted).LayoutOrder = 3
	local assetSection = section(canvas, &quot;04  IMAGE ASSET MAPPINGS&quot;, 4)
	local mappings = textEntry(assetSection, &quot;asset-key = 123456789\n# Upload PNGs using Studio Asset Manager&quot;, 86, true)
	label(assetSection, &quot;Optional. Map exported asset keys or node IDs to Roblox image IDs. Existing IDs from Figma are used automatically.&quot;, 11, THEME.muted).LayoutOrder = 2
	local addKeys = button(assetSection, &quot;Add missing asset keys&quot;)
	addKeys.LayoutOrder = 3
	local runtime = true
	local settings = section(canvas, &quot;05  RUNTIME&quot;, 5)
	local runtimeButton = button(settings, &quot;●  Install interactions and animations&quot;)
	selectedButton(runtimeButton, runtime)
	runtimeButton.LayoutOrder = 1
	runtimeButton.Activated:Connect(function()
		runtime = not runtime
		runtimeButton.Text = (if runtime then &quot;●&quot; else &quot;○&quot;) .. &quot;  Install interactions and animations&quot;
		selectedButton(runtimeButton, runtime)
	end)
	label(settings, &quot;One shared runtime per imported GUI. Behaviors are metadata; custom actions are symbolic callbacks for your game code.&quot;, 11, THEME.muted).LayoutOrder = 2
	local actions = section(canvas, &quot;READY TO FORGE&quot;, 6)
	local validateButton = button(actions, &quot;Validate export&quot;)
	validateButton.LayoutOrder = 1
	local importButton = button(actions, &quot;Forge into StarterGui&quot;, true)
	importButton.LayoutOrder = 2
	local undo = button(actions, &quot;Undo latest Studio change&quot;)
	undo.LayoutOrder = 3
	local reportSection = section(canvas, &quot;IMPORT REPORT&quot;, 7)
	local report = label(reportSection, &quot;Paste an export and validate it to check images and behavior targets. Each import creates a new GUI and one undo recording.&quot;, 12, THEME.muted)
	report.LayoutOrder = 1
	local lastReport: any = nil
	local busy = false
	local function showError(message: string)
		report.TextColor3 = THEME.error
		report.Text = message
	end
	local function getOptions(): (any?, string?)
		local parsed, mappingError = Import.parseMappings(mappings.Text)
		if not parsed then return nil, mappingError end
		if target == &quot;export&quot; then
			local inspected, inspectError = Import.inspect({ json = json.Text, mappings = parsed, runtime = runtime })
			if not inspected then return nil, inspectError end
			exportedTarget = inspected.document.settings.target
			updateWorldControls()
		end
		local actualTarget = if target == &quot;export&quot; then exportedTarget else target
		local worldOptions: any = { alwaysOnTop = alwaysOnTop }
		if actualTarget ~= &quot;ScreenGui&quot; then
			for key, box in pairs(worldInputs) do
				local relevant = key == &quot;lightInfluence&quot; or (actualTarget == &quot;SurfaceGui&quot; and (key == &quot;face&quot; or key == &quot;pixelsPerStud&quot;))
					or (actualTarget == &quot;BillboardGui&quot; and key ~= &quot;face&quot; and key ~= &quot;pixelsPerStud&quot;)
				if not relevant then continue end
				if key == &quot;face&quot; then worldOptions[key] = box.Text
				elseif box.Text ~= &quot;&quot; then
					local value = tonumber(box.Text)
					if not value then return nil, &quot;World option '&quot; .. key .. &quot;' must be a number.&quot; end
					worldOptions[key] = value
				end
			end
		end
		return { json = json.Text, sizing = sizing, target = if target == &quot;export&quot; then nil else target, mappings = parsed, runtime = runtime, world = worldOptions }, nil
	end
	local function run(importing: boolean)
		if busy then return end
		local options, optionError = getOptions()
		if not options then showError(optionError or &quot;Invalid settings.&quot;); return end
		busy = true
		importButton.Interactable, validateButton.Interactable = false, false
		importButton.Text = if importing then &quot;Forging…&quot; else &quot;Forge into StarterGui&quot;
		local succeeded, result, importError = pcall(function()
			if importing then return Import.run(pluginObject, packageRoot, options) end
			return Import.inspect(options)
		end)
		busy = false
		importButton.Interactable, validateButton.Interactable = true, true
		importButton.Text = &quot;Forge into StarterGui&quot;
		if not succeeded or not result then
			showError(if succeeded then importError or &quot;Import failed.&quot; else tostring(result))
			return
		end
		lastReport = result
		report.Text = reportText(result, importing)
		report.TextColor3 = if #result.missingAssets &gt; 0 or #result.warnings &gt; 0 then THEME.warning else THEME.success
		for _, warning in ipairs(result.warnings) do warn(&quot;[FrameForge] &quot; .. warning.code .. &quot; · &quot; .. warning.nodeId .. &quot;: &quot; .. warning.message) end
		for _, asset in ipairs(result.missingAssets) do warn(&quot;[FrameForge] Missing asset: &quot; .. asset.id .. &quot; = &quot; .. asset.name) end
		if importing then pcall(function() pluginObject:SetSetting(&quot;FrameForge.Sizing&quot;, sizing) end) end
	end
	validateButton.Activated:Connect(function() run(false) end)
	importButton.Activated:Connect(function() run(true) end)
	undo.Activated:Connect(function()
		if busy then return end
		local success, undoError = pcall(function() ChangeHistoryService:Undo() end)
		if not success then showError(&quot;Studio could not undo: &quot; .. tostring(undoError)) end
	end)
	addKeys.Activated:Connect(function()
		run(false)
		if not lastReport then return end
		local additions = {}
		for _, asset in ipairs(lastReport.missingAssets) do
			local entry = &quot;# &quot; .. asset.id .. &quot; = Roblox image ID&quot;
			if not string.find(mappings.Text, entry, 1, true) then
				table.insert(additions, &quot;# &quot; .. asset.name .. &quot;\n&quot; .. entry)
			end
		end
		if #additions &gt; 0 then mappings.Text ..= (if mappings.Text ~= &quot;&quot; then &quot;\n&quot; else &quot;&quot;) .. table.concat(additions, &quot;\n&quot;) end
	end)
	widget:BindToClose(function() widget.Enabled = false end)
	return widget
end

return Dock
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="FF22"><Properties><string name="Name">LayoutTools</string><ProtectedString name="Source">--!strict
local Selection = game:GetService(&quot;Selection&quot;)
local ChangeHistoryService = game:GetService(&quot;ChangeHistoryService&quot;)
local Operations = require(script.Parent.Parent.Tools.Operations)
local Theme = require(script.Parent.Theme)
local LayoutTools = {}
local C = Theme.colors

local function round(object: GuiObject, radius: number)
	local corner = Instance.new(&quot;UICorner&quot;)
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = object
end

local function text(parent: Instance, value: string, size: number, order: number): TextLabel
	local label = Instance.new(&quot;TextLabel&quot;)
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, 0, 0, 0)
	label.AutomaticSize = Enum.AutomaticSize.Y
	label.Font = Enum.Font.Gotham
	label.TextSize = size
	label.TextColor3 = C.muted
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Top
	label.TextWrapped = true
	label.Text = value
	label.LayoutOrder = order
	label.Parent = parent
	return label
end

local function card(parent: Instance, heading: string, order: number): Frame
	local frame = Instance.new(&quot;Frame&quot;)
	frame.Name = heading
	frame.Size = UDim2.new(1, 0, 0, 0)
	frame.AutomaticSize = Enum.AutomaticSize.Y
	frame.BackgroundColor3 = C.card
	frame.BorderSizePixel = 0
	frame.LayoutOrder = order
	frame.Parent = parent
	round(frame, 10)
	local pad = Instance.new(&quot;UIPadding&quot;)
	pad.PaddingTop, pad.PaddingBottom = UDim.new(0, 14), UDim.new(0, 14)
	pad.PaddingLeft, pad.PaddingRight = UDim.new(0, 14), UDim.new(0, 14)
	pad.Parent = frame
	local layout = Instance.new(&quot;UIListLayout&quot;)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 10)
	layout.Parent = frame
	local title = text(frame, heading, 12, 0)
	title.TextColor3 = C.text
	title.Font = Enum.Font.GothamBold
	return frame
end

local function button(parent: Instance, value: string, order: number, accent: boolean?): TextButton
	local control = Instance.new(&quot;TextButton&quot;)
	control.Name = value
	control.Size = UDim2.new(1, 0, 0, 38)
	control.BackgroundColor3 = if accent then C.accent else C.field
	control.BorderSizePixel = 0
	control.TextColor3 = if accent then C.accentText else C.text
	control.Font = Enum.Font.GothamMedium
	control.TextSize = 12
	control.Text = value
	control.LayoutOrder = order
	control.Parent = parent
	round(control, 7)
	return control
end

function LayoutTools.create(pluginObject: Plugin, parent: Instance): ScrollingFrame
	local canvas = Instance.new(&quot;ScrollingFrame&quot;)
	canvas.Name = &quot;LayoutTools&quot;
	canvas.BackgroundColor3 = C.background
	canvas.BorderSizePixel = 0
	canvas.ScrollBarThickness = 5
	canvas.ScrollBarImageColor3 = C.accent
	canvas.ScrollingDirection = Enum.ScrollingDirection.Y
	canvas.AutomaticCanvasSize = Enum.AutomaticSize.Y
	canvas.CanvasSize = UDim2.fromOffset(0, 0)
	canvas.Visible = false
	canvas.Parent = parent
	local pad = Instance.new(&quot;UIPadding&quot;)
	pad.PaddingTop, pad.PaddingBottom = UDim.new(0, 16), UDim.new(0, 16)
	pad.PaddingLeft, pad.PaddingRight = UDim.new(0, 16), UDim.new(0, 16)
	pad.Parent = canvas
	local list = Instance.new(&quot;UIListLayout&quot;)
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Padding = UDim.new(0, 14)
	list.Parent = canvas
	local intro = card(canvas, &quot;UI TOOLS&quot;, 0)
	text(intro, &quot;Edit complete components without rebuilding their children. All changes use Studio undo.&quot;, 12, 1)
	local selectionLabel = text(intro, &quot;Select a UI component in Explorer.&quot;, 13, 2)
	selectionLabel.Name = &quot;SelectionSummary&quot;
	selectionLabel.TextColor3 = C.text
	local details = text(intro, &quot;Frames, buttons, labels and imported FrameForge GUIs are supported. Multiple selections are edited together.&quot;, 11, 3)

	local resize = card(canvas, &quot;RESIZE A COMPLETE COMPONENT&quot;, 1)
	text(resize, &quot;Uniformly resize the component, icons, labels, fixed spacing, padding, corners, strokes and size limits. Relative proportions, aspect ratios and layout objects are preserved.&quot;, 11, 1)
	local percentage = Instance.new(&quot;TextBox&quot;)
	percentage.Name = &quot;ResizePercentage&quot;
	percentage.Size = UDim2.new(1, 0, 0, 38)
	percentage.BackgroundColor3 = C.field
	percentage.BorderSizePixel = 0
	percentage.Font = Enum.Font.GothamMedium
	percentage.TextSize = 14
	percentage.TextColor3 = C.text
	percentage.PlaceholderText = &quot;Resize percentage (100 = current size)&quot;
	percentage.PlaceholderColor3 = C.muted
	percentage.ClearTextOnFocus = false
	percentage.Text = &quot;100&quot;
	percentage.LayoutOrder = 2
	percentage.Parent = resize
	round(percentage, 7)
	local presets = Instance.new(&quot;Frame&quot;)
	presets.Name = &quot;ResizePresets&quot;
	presets.BackgroundTransparency = 1
	presets.Size = UDim2.new(1, 0, 0, 32)
	presets.LayoutOrder = 3
	presets.Parent = resize
	for index, value in ipairs({ 50, 75, 125, 200 }) do
		local preset = button(presets, value .. &quot;%&quot;, index)
		preset.Size = UDim2.new(0.25, -6, 1, 0)
		preset.Position = UDim2.new((index - 1) * 0.25, 0, 0, 0)
		preset.Activated:Connect(function() percentage.Text = tostring(value) end)
	end
	local applyResize = button(resize, &quot;Apply uniform resize&quot;, 4, true)
	text(resize, &quot;100% keeps the current size. Choose the outer frame of a grid or flex component so the parent layout can keep controlling its children.&quot;, 11, 5)

	local sizing = card(canvas, &quot;POSITION &amp; SIZE COORDINATES&quot;, 2)
	text(sizing, &quot;Keep the current bounds while changing how the selected component responds when its parent resizes. Children, padding and constraints stay intact.&quot;, 11, 1)
	local responsive = button(sizing, &quot;Use responsive coordinates&quot;, 2)
	local fixed = button(sizing, &quot;Use fixed pixels&quot;, 3)
	text(sizing, &quot;Responsive coordinates follow the parent's width and height. Fixed pixels keep the same dimensions. Show the UI in the viewport before converting. FrameForge's design scale is handled automatically; a padded parent or a scale on the selected component may need an outer frame selected.&quot;, 11, 4)

	local anchor = card(canvas, &quot;ANCHOR POINT&quot;, 3)
	text(anchor, &quot;Choose which point connects the component to its Position. Its visible placement is preserved. Parent layouts or size constraints may require selecting an outer frame.&quot;, 11, 1)
	local grid = Instance.new(&quot;Frame&quot;)
	grid.Name = &quot;AnchorGrid&quot;
	grid.BackgroundTransparency = 1
	grid.Size = UDim2.new(1, 0, 0, 116)
	grid.LayoutOrder = 2
	grid.Parent = anchor
	local anchors: {TextButton} = {}
	for row = 0, 2 do
		for column = 0, 2 do
			local point = Vector2.new(column / 2, row / 2)
			local control = button(grid, &quot;●&quot;, row * 3 + column + 1)
			control.Name = &quot;Anchor_&quot; .. column .. &quot;_&quot; .. row
			control.Size = UDim2.fromOffset(32, 32)
			control.Position = UDim2.new(0.5, -52 + column * 36, 0, row * 36)
			control:SetAttribute(&quot;AnchorX&quot;, point.X)
			control:SetAttribute(&quot;AnchorY&quot;, point.Y)
			table.insert(anchors, control)
		end
	end
	local anchorHint = text(anchor, &quot;Current anchor: —&quot;, 11, 3)
	anchorHint.Name = &quot;AnchorSummary&quot;
	local resultCard = card(canvas, &quot;EDIT RESULT&quot;, 4)
	local result = text(resultCard, &quot;Select one or more components, choose a tool, then undo any change with Ctrl+Z / Cmd+Z.&quot;, 12, 1)
	result.Name = &quot;ToolResult&quot;
	local undo = button(resultCard, &quot;Undo latest Studio change&quot;, 2)
	local actionable = { applyResize, responsive, fixed }
	for _, control in ipairs(anchors) do table.insert(actionable, control) end
	local selectedConnections: {RBXScriptConnection} = {}
	local disposed, refreshing, busy = false, false, false
	local function show(message: string, successful: boolean)
		result.Text = message
		result.TextColor3 = if successful then C.success else C.error
	end
	local function refresh()
		if disposed or refreshing then return end
		refreshing = true
		local roots, ignored = Operations.roots(Selection:Get())
		for _, control in ipairs(actionable) do
			control.Interactable = #roots &gt; 0
			control.TextTransparency = if #roots &gt; 0 then 0 else 0.45
		end
		if #roots == 0 then
			selectionLabel.Text = &quot;Select a UI component in Explorer.&quot;
			details.Text = &quot;Frames, buttons, labels and imported FrameForge GUIs are supported. Multiple selections are edited together.&quot;
		else
			selectionLabel.Text = if #roots == 1 then roots[1].Name .. &quot; · &quot; .. roots[1].ClassName else #roots .. &quot; selected components&quot;
			local size = roots[1].AbsoluteSize
			details.Text = if #roots == 1 then math.round(size.X) .. &quot; × &quot; .. math.round(size.Y) .. &quot; rendered pixels&quot; else &quot;The same edit will apply to every selected component. Selected descendants are included once.&quot;
			if ignored &gt; 0 then details.Text ..= &quot; · &quot; .. ignored .. &quot; non-UI or decorative selection&quot; .. (if ignored == 1 then &quot;&quot; else &quot;s&quot;) .. &quot; ignored&quot; end
		end
		local current = if #roots &gt; 0 then roots[1].AnchorPoint else nil
		local mixed = false
		for _, object in ipairs(roots) do if object.AnchorPoint ~= current then mixed = true; break end end
		anchorHint.Text = if not current then &quot;Current anchor: —&quot; elseif mixed then &quot;Current anchor: Mixed&quot; else &quot;Current anchor: &quot; .. current.X .. &quot;, &quot; .. current.Y
		for _, control in ipairs(anchors) do
			local active = current ~= nil and not mixed and current.X == control:GetAttribute(&quot;AnchorX&quot;) and current.Y == control:GetAttribute(&quot;AnchorY&quot;)
			control.BackgroundColor3 = if active then C.accent else C.field
			control.TextColor3 = if active then C.accentText else C.muted
		end
		refreshing = false
	end
	local function observeSelection()
		for _, connection in ipairs(selectedConnections) do connection:Disconnect() end
		table.clear(selectedConnections)
		local roots = Operations.roots(Selection:Get())
		for index, object in ipairs(roots) do
			if index &gt; 50 then break end
			for _, property in ipairs({ &quot;Size&quot;, &quot;Position&quot;, &quot;AbsoluteSize&quot;, &quot;AnchorPoint&quot;, &quot;Name&quot; }) do
				table.insert(selectedConnections, object:GetPropertyChangedSignal(property):Connect(refresh))
			end
		end
		refresh()
	end
	local function run(prepare: ({Instance}) -&gt; Operations.Plan)
		if busy then return end
		busy = true
		local success, failure = pcall(function()
			local plan = prepare(Selection:Get())
			local applied, message = Operations.apply(pluginObject, plan)
			show(message, applied)
		end)
		busy = false
		if not success then show((string.gsub(tostring(failure), &quot;^.-:%d+: &quot;, &quot;&quot;)), false) end
		refresh()
	end
	applyResize.Activated:Connect(function()
		local value = tonumber(string.match(percentage.Text, &quot;^%s*(.-)%%?%s*$&quot;) or &quot;&quot;)
		if not value then show(&quot;Enter a resize percentage, such as 125.&quot;, false); return end
		run(function(selection) return Operations.resize(selection, (value :: number) / 100) end)
	end)
	responsive.Activated:Connect(function() run(function(selection) return Operations.coordinates(selection, &quot;responsive&quot;) end) end)
	fixed.Activated:Connect(function() run(function(selection) return Operations.coordinates(selection, &quot;pixels&quot;) end) end)
	for _, control in ipairs(anchors) do
		control.Activated:Connect(function()
			local point = Vector2.new(control:GetAttribute(&quot;AnchorX&quot;) :: number, control:GetAttribute(&quot;AnchorY&quot;) :: number)
			run(function(selection) return Operations.anchor(selection, point) end)
		end)
	end
	undo.Activated:Connect(function()
		local success, failure = pcall(function() ChangeHistoryService:Undo() end)
		if success then show(&quot;Undid the latest Studio change.&quot;, true) else show(&quot;Studio could not undo: &quot; .. tostring(failure), false) end
	end)
	local selectionConnection = Selection.SelectionChanged:Connect(observeSelection)
	canvas.Destroying:Connect(function()
		disposed = true
		selectionConnection:Disconnect()
		for _, connection in ipairs(selectedConnections) do connection:Disconnect() end
		table.clear(selectedConnections)
	end)
	observeSelection()
	return canvas
end

return LayoutTools
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="FF23"><Properties><string name="Name">Logo</string><ProtectedString name="Source">--!strict
-- The brand bitmap is generated from the same transparent PNG used by Figma.
-- It remains local to the plugin; design exports keep their existing asset workflow.
local AssetService = game:GetService(&quot;AssetService&quot;)
local EncodingService = game:GetService(&quot;EncodingService&quot;)
local Pixels = require(script.Parent.LogoPixels)

local Logo = {
	width = Pixels.width,
	height = Pixels.height,
	aspect = Pixels.width / Pixels.height,
}

local MAX_DIMENSION = 1024
local MAX_BYTE_LENGTH = MAX_DIMENSION * MAX_DIMENSION * 4

function Logo.attach(imageLabel: ImageLabel, owner: Instance): boolean
	local editableImage: EditableImage? = nil
	local destroyingConnection: RBXScriptConnection? = nil
	local function release()
		if destroyingConnection then
			destroyingConnection:Disconnect()
			destroyingConnection = nil
		end
		local current = editableImage
		editableImage = nil
		if current then current:Destroy() end
	end
	local success, errorMessage = pcall(function()
		assert(Pixels.width &gt; 0 and Pixels.width &lt;= MAX_DIMENSION and Pixels.width % 1 == 0, &quot;Invalid logo width&quot;)
		assert(Pixels.height &gt; 0 and Pixels.height &lt;= MAX_DIMENSION and Pixels.height % 1 == 0, &quot;Invalid logo height&quot;)
		local expectedLength = Pixels.width * Pixels.height * 4
		assert(Pixels.byteLength == expectedLength and expectedLength &lt;= MAX_BYTE_LENGTH, &quot;Invalid logo byte length&quot;)
		assert(#Pixels.encoded &lt;= MAX_BYTE_LENGTH * 2, &quot;Encoded logo exceeds its size limit&quot;)
		local decoded = EncodingService:Base64Decode(buffer.fromstring(Pixels.encoded))
		local rgba: buffer
		if Pixels.compression == &quot;zstd&quot; then
			local reportedLength = EncodingService:GetDecompressedBufferSize(decoded, Enum.CompressionAlgorithm.Zstd)
			assert(reportedLength == nil or reportedLength == expectedLength, &quot;Invalid compressed logo size&quot;)
			rgba = EncodingService:DecompressBuffer(decoded, Enum.CompressionAlgorithm.Zstd)
		elseif Pixels.compression == &quot;none&quot; then
			rgba = decoded
		else
			error(&quot;Unsupported logo compression&quot;)
		end
		assert(buffer.len(rgba) == expectedLength, &quot;Incomplete logo pixels&quot;)
		local created = AssetService:CreateEditableImage({ Size = Vector2.new(Pixels.width, Pixels.height) })
		assert(created, &quot;Studio could not allocate the logo image&quot;)
		editableImage = created
		created:WritePixelsBuffer(Vector2.zero, Vector2.new(Pixels.width, Pixels.height), rgba)
		imageLabel.ImageContent = Content.fromObject(created)
		destroyingConnection = owner.Destroying:Connect(release)
	end)
	if not success then
		release()
		imageLabel.Visible = false
		warn(&quot;[FrameForge] Could not display the embedded logo: &quot; .. tostring(errorMessage))
		return false
	end
	return true
end

return table.freeze(Logo)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="FF24"><Properties><string name="Name">LogoPixels</string><ProtectedString name="Source">--!strict
