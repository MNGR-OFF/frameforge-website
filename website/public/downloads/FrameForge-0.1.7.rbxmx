-- Generated from modular FrameForge Runtime sources. Do not edit the generated bundle.
local loaders, tokens, cache, loading = {}, {}, {}, {}
loaders[&quot;Animations&quot;] = function(require, script)
--!strict
local RunService = game:GetService(&quot;RunService&quot;)
local TweenService = game:GetService(&quot;TweenService&quot;)
local Cleanup = require(script.Parent.Cleanup)
local EffectMath = require(script.Parent.EffectMath)

local Animations = {}
Animations.__index = Animations

local IDLE = { float = true, pulse = true, spin = true, wiggle = true, shake = true }
local ENTRANCE = { pop = true, fade = true, slide = true, cascade = true }

local number = EffectMath.Number

local function tweenInfo(behavior: any, defaultDuration: number): TweenInfo
	local style = Enum.EasingStyle.Quad
	local direction = Enum.EasingDirection.Out
	local name = behavior.easing
	if type(name) == &quot;string&quot; then
		local styleName = string.gsub(name, &quot;InOut$&quot;, &quot;&quot;)
		styleName = string.gsub(string.gsub(styleName, &quot;Out$&quot;, &quot;&quot;), &quot;In$&quot;, &quot;&quot;)
		local ok, item = pcall(function() return (Enum.EasingStyle :: any)[styleName] end)
		if ok then style = item end
		if string.match(name, &quot;InOut$&quot;) then direction = Enum.EasingDirection.InOut
		elseif string.match(name, &quot;In$&quot;) then direction = Enum.EasingDirection.In end
	end
	return TweenInfo.new(number(behavior.duration, defaultDuration, 0.01, 60), style, direction)
end

local function visible(object: GuiObject, root: Instance): boolean
	local current: Instance? = object
	while current do
		if current:IsA(&quot;GuiObject&quot;) and not current.Visible then return false end
		if current:IsA(&quot;LayerCollector&quot;) and not current.Enabled then return false end
		if current:GetAttribute(&quot;FF_EffectsEnabled&quot;) == false then return false end
		if current == root then return root.Parent ~= nil end
		current = current.Parent
	end
	return false
end

local function transparencyProperties(object: Instance): { string }
	if object:IsA(&quot;UIStroke&quot;) then return { &quot;Transparency&quot; } end
	if object:IsA(&quot;CanvasGroup&quot;) then return { &quot;GroupTransparency&quot; } end
	local properties = { &quot;BackgroundTransparency&quot; }
	if object:IsA(&quot;TextLabel&quot;) or object:IsA(&quot;TextButton&quot;) or object:IsA(&quot;TextBox&quot;) then
		table.insert(properties, &quot;TextTransparency&quot;)
		table.insert(properties, &quot;TextStrokeTransparency&quot;)
	end
	if object:IsA(&quot;ImageLabel&quot;) or object:IsA(&quot;ImageButton&quot;) then table.insert(properties, &quot;ImageTransparency&quot;) end
	return properties
end

function Animations.new(root: Instance): any
	return setmetatable({
		Root = root,
		_entries = {} :: { [GuiObject]: any },
		_idle = {} :: { [GuiObject]: any },
		_heartbeat = nil,
		_scope = Cleanup.new(),
		_destroyed = false,
	}, Animations)
end

local function localOpacity(entry: any): number
	local alpha = entry.values.Opacity.Value * entry.values.SlideOpacity.Value * entry.values.HoverOpacity.Value * entry.values.HoverSlideOpacity.Value
	for _, driver in entry.cascades do alpha *= driver.Value end
	return alpha
end

function Animations._opacity(self: any, entry: any)
	local alpha = localOpacity(entry)
	local parent = entry.object.Parent
	while parent do
		-- CanvasGroup already applies its opacity to the entire rendered subtree.
		-- Descendant fade channels compose inside that group, avoiding a doubled
		-- fade while preserving mask alpha and nested groups' original opacity.
		if parent:IsA(&quot;CanvasGroup&quot;) then break end
		local parentEntry = self._entries[parent]
		if parentEntry then alpha *= localOpacity(parentEntry) end
		if parent == self.Root then break end
		parent = parent.Parent
	end
	for object, properties in entry.transparencies do
		if object.Parent then
			local objectAlpha = if entry.object:IsA(&quot;CanvasGroup&quot;) and object ~= entry.object then 1 else alpha
			for property, original in properties do
				(object :: any)[property] = 1 - (1 - original) * objectAlpha
			end
		end
	end
end

function Animations._refreshOpacity(self: any, object: GuiObject)
	if self._destroyed then return end
	for descendant, childEntry in self._entries do
		if descendant == object or descendant:IsDescendantOf(object) then self:_opacity(childEntry) end
	end
end

function Animations._apply(self: any, entry: any)
	if self._destroyed or not entry.object.Parent then return end
	local values = entry.values
	if entry.scale then
		entry.scale.Scale = entry.baseScale * values.Hover.Value * values.Entrance.Value * values.HoverEntrance.Value * values.Impulse.Value * entry.idleScale
	end
	local offset = entry.idleOffset + Vector2.new(values.X.Value + values.HoverX.Value, values.Y.Value + values.HoverY.Value + values.HoverSlideY.Value)
	if entry.positionTransform then
		local position = entry.basePosition
		entry.object.Position = UDim2.new(position.X.Scale, position.X.Offset + offset.X, position.Y.Scale, position.Y.Offset + offset.Y)
	end
	if entry.rotationTransform then
		entry.object.Rotation = entry.baseRotation + entry.idleRotation + values.Tilt.Value
	end
end

function Animations.Register(self: any, object: GuiObject, behaviors: { any }): any
	if self._entries[object] then return self._entries[object] end
	local scope = Cleanup.new()
	local layoutOwned = object.Parent ~= nil and object.Parent:FindFirstChildWhichIsA(&quot;UIGridStyleLayout&quot;) ~= nil
	local entry: any = {
		object = object, scope = scope, effects = Cleanup.new(), hoverEffects = {}, tweens = {}, behaviors = behaviors,
		values = {}, hoverStates = {}, transparencies = {}, cascades = {}, basePosition = object.Position, baseRotation = object.Rotation,
		baseScale = 1, idleScale = 1, idleOffset = Vector2.zero, idleRotation = 0,
		elapsed = 0, active = false, positionTransform = false, rotationTransform = false, scale = nil, createdScale = false, layoutOwned = layoutOwned,
	}
	local loopInfos = {}
	for _, behavior in behaviors do
		if (behavior.type == &quot;hoverMove&quot; or behavior.type == &quot;hoverTilt&quot;) and behavior.trigger == &quot;loop&quot; then loopInfos[behavior] = tweenInfo(behavior, 0.2) end
		if IDLE[behavior.type] or ((behavior.type == &quot;hoverMove&quot; or behavior.type == &quot;hoverTilt&quot;) and behavior.trigger == &quot;loop&quot;) then
			self._idle[object] = entry
		end
		if not layoutOwned then
			if behavior.type == &quot;float&quot; or behavior.type == &quot;shake&quot; or behavior.type == &quot;slide&quot; or behavior.type == &quot;hoverMove&quot; then entry.positionTransform = true end
		end
		-- Layouts own Position, not the visual rotation property.
		if behavior.type == &quot;spin&quot; or behavior.type == &quot;wiggle&quot; or behavior.type == &quot;hoverTilt&quot; then entry.rotationTransform = true end
		if layoutOwned and behavior.type == &quot;hoverMove&quot; then warn(&quot;[FrameForge] Layout owns &quot; .. object.Name .. &quot; positioning; put Hover Move on an inner visual layer.&quot;) end
		if layoutOwned and (behavior.type == &quot;slide&quot; or behavior.type == &quot;float&quot; or behavior.type == &quot;shake&quot;) then
			warn(&quot;[FrameForge] Layout owns &quot; .. object.Name .. &quot; positioning; slide uses fade and float/shake use scale.&quot;)
		end
