		self:_tween(entry, &quot;HoverX&quot;, entry.values.HoverX, { Value = if active then number(behavior.offsetX, -30, -10000, 10000) else 0 }, behavior, 0.2)
		self:_tween(entry, &quot;HoverY&quot;, entry.values.HoverY, { Value = if active then number(behavior.offsetY, 0, -10000, 10000) else 0 }, behavior, 0.2)
	elseif behavior.type == &quot;hoverTilt&quot; and behavior.trigger ~= &quot;loop&quot; then
		self:_tween(entry, &quot;Tilt&quot;, entry.values.Tilt, { Value = if active then number(behavior.angle, 8, -360, 360) else 0 }, behavior, 0.2)
	elseif ENTRANCE[behavior.type] and behavior.trigger == &quot;hover&quot; then
		local previous = entry.hoverEffects[behavior]
