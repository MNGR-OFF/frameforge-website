{
  "name": "frameforge-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && node scripts/finalize-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check && node scripts/verify-build.mjs",
    "check:publication": "node scripts/check-publication.mjs",
    "test": "playwright test",
    "test:browser": "playwright test",
    "social": "node scripts/create-social.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "sharp": "0.34.5",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
